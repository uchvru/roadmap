ankA - rankB;\\n          return _sd(a) - _sd(b);\\n        }\\n        if (mode === 'priority') {\\n          const sa = _taskPriorityScore(a), sb = _taskPriorityScore(b);\\n          const va = sa ? sa.value : -Infinity, vb = sb ? sb.value : -Infinity;\\n          if (va !== vb) return vb - va;\\n          return _sd(a) - _sd(b);\\n        }\\n        if (mode === 'name') {\\n          return (a.name || '').localeCompare(b.name || '', 'ru');\\n        }\\n        if (mode === 'resource') {\\n          const cmp = (a.resource || '').localeCompare(b.resource || '', 'ru');\\n          if (cmp !== 0) return cmp;\\n          return _sd(a) - _sd(b);\\n        }\\n        if (mode === 'cascade') {\\n          // Каскад: сначала самые ранние старты, затем по дате окончания, затем по имени.\\n          // Так полоски выстраиваются лесенкой слева направо. Задачи без даты старта , в конец секции.\\n          const ds = _sd(a) - _sd(b); if (ds !== 0) return ds;\\n          const ea = a.end ? dateToDays(a.end) : Number.MAX_SAFE_INTEGER;\\n          const eb = b.end ? dateToDays(b.end) : Number.MAX_SAFE_INTEGER;\\n          if (ea !== eb) return ea - eb;\\n          return (a.name || '').localeCompare(b.name || '', 'ru');\\n        }\\n        // По умолчанию , по дате старта\\n        return _sd(a) - _sd(b);\\n      });\\n    }\\n    function setTaskSortMode(mode) {\\n      storage.set('gantt_task_sort_mode', mode);\\n      if (mode === 'priority' && typeof _showPriorityScores !== 'undefined' && !_showPriorityScores && typeof setShowPriorityScores === 'function') { setShowPriorityScores(true); }\\n      else { renderRoadmap(true); }\\n    }\\n    function applyTaskSortModeUI() {\\n      const sel = document.getElementById('taskSortMode');\\n      if (sel) sel.value = storage.get('gantt_task_sort_mode') || 'date';\\n    }\\n\\n    // === Перемещение задач: вверх/вниз внутри секции + перенос в другую секцию ===\\n    // Меняет местами задачу с соседом той же секции. Включает руч