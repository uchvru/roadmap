laceholder: 'Название набора', okText: 'Сохранить', onOk: (name) => {\\n        name = (name || '').trim(); if (!name) return;\\n        const presets = getFilterPresets().filter(p => p.name !== name);\\n        presets.push({\\n          name, status: [...statusFilterSel], resource: [...resourceFilterSel], project: [...projectFilterSel], type: [...typeFilterSel],\\n          board: _boardTaskFilter,\\n          modes: {hot:_goritMode, mine:_mineMode, critical:_critPathMode, kind:_kindFilter, noGoal:_noGoalFilter, forecast:_forecastReasonFilter},\\n          release: [...releaseFilterSel], label: [...labelFilterSel], component: [...componentFilterSel],\\n          customFields: Object.keys(customFieldFilterSel || {}).reduce((out, key) => {\\n            const values = customFieldFilterSel[key];\\n            if (values && values.size) out[key] = [...values].map(String);\\n            return out;\\n          }, {})\\n        });\\n        storage.set('gantt_filter_presets', JSON.stringify(presets));\\n        renderPresetMenu();\\n        if (typeof showToast === 'function') showToast(`Набор «${name}» сохранен`, 'ok');\\n      }});\\n    }\\n    function applyFilterPreset(idx) {\\n      const p = getFilterPresets()[idx]; if (!p) return;\\n      const modes = p.modes && typeof p.modes === 'object' ? p.modes : {};\\n      _goritMode = modes.hot === true; _mineMode = modes.mine === true; _critPathMode = modes.critical === true;\\n      _kindFilter = ['urgent','extdep'].includes(modes.kind) ? modes.kind : '';\\n      _noGoalFilter = modes.noGoal === true;\\n      _forecastReasonFilter = typeof modes.forecast === 'string' ? modes.forecast : '';\\n      if (_critPathMode) computeCriticalPath();\\n      if (typeof _updateModeButtons === 'function') _updateModeButtons();\\n      _boardTaskFilter = ['on','off'].includes(p.board) ? p.board : '';\\n      typeFilterSel = new Set(p.type || []);\\n      statusFilterSel = new Set(p.status || []); resourceFilterSel = new Set(p.resou