, крупные плавные повороты (радиус 14)\\n    function _depPathD(pts, rounded) {\\n      if (!rounded || pts.length < 3) return 'M ' + pts.map(function (pt) { return pt[0].toFixed(1) + ' ' + pt[1].toFixed(1); }).join(' L ');\\n      const r = 14;\\n      let d = 'M ' + pts[0][0].toFixed(1) + ' ' + pts[0][1].toFixed(1);\\n      for (let i = 1; i < pts.length - 1; i++) {\\n        const px = pts[i - 1][0], py = pts[i - 1][1], cx = pts[i][0], cy = pts[i][1], nx = pts[i + 1][0], ny = pts[i + 1][1];\\n        const d1 = Math.hypot(cx - px, cy - py) || 1, d2 = Math.hypot(nx - cx, ny - cy) || 1;\\n        const r1 = Math.min(r, d1 / 2), r2 = Math.min(r, d2 / 2);\\n        d += ' L ' + (cx - (cx - px) / d1 * r1).toFixed(1) + ' ' + (cy - (cy - py) / d1 * r1).toFixed(1)\\n          + ' Q ' + cx.toFixed(1) + ' ' + cy.toFixed(1) + ' ' + (cx + (nx - cx) / d2 * r2).toFixed(1) + ' ' + (cy + (ny - cy) / d2 * r2).toFixed(1);\\n      }\\n      return d + ' L ' + pts[pts.length - 1][0].toFixed(1) + ' ' + pts[pts.length - 1][1].toFixed(1);\\n    }\\n    function drawDependencyLines(barsContainer) {\\n      // Удаляем предыдущий слой, если был\\n      const old = document.getElementById('dependency-svg-layer');\\n      if (old) old.remove();\\n      if (!showDependencyLines) return; // связи скрыты переключателем (п.4)\\n      if (typeof featureFlags !== 'undefined' && featureFlags.deps === false) return; // модуль «Зависимости» выключен в Настройках\\n\\n      // Собираем пары (предшественник → зависимая) с учетом видимости (свернутых секций / фильтров)\\n      const pairs = [];\\n      const _byId = RoadmapModules.createTaskLookup(roadmapData || []); // O(1) поиск предшественника вместо roadmapData.find в цикле\\n      roadmapData.forEach(task => {\\n        const preds = getPredecessorIds(task);\\n        if (preds.length === 0) return;\\n        if (task.isMilestone ? !task.start : !(task.start && task.end)) return; // без дат нет бара , стрелку не к чему вести\\n        const succRi