'load' ? 'load' : 'roles') === v ? 'font-semibold bg-white text-indigo-700 shadow-sm' : 'text-slate-500 hover:text-slate-900'}\\\">${label}</button>`;\\n      const _tabs = `<div class=\\\"inline-flex items-center gap-0.5 bg-slate-100 rounded-lg p-0.5 mb-4 w-fit\\\">${_tab('roles', 'Роли и люди')}${_tab('load', 'Загрузка')}</div>`;\\n      const _body = (resourceView === 'load')\\n        ? buildTeamLoadHtml()\\n        : (stripHtml + whoHtml + rolesDatalist + tableHtml);\\n      container.innerHTML = _tabs + _body;\\n      try { var _calWrap = document.createElement('div'); _calWrap.innerHTML = _calBlockHtml(_ro); container.appendChild(_calWrap); } catch (e) {}\\n      const _aw = document.getElementById('resourceAddWrap'); if (_aw) _aw.classList.toggle('hidden', resourceView === 'load' || _ro);\\n      const _rt = document.getElementById('resourceModalTitle'); if (_rt) _rt.textContent = (resourceView === 'load') ? 'Загрузка команды' : 'Команда: роли и люди';\\n    }\\n    function toggleResourceTasks(rowHead) {\\n      const wrap = rowHead.parentElement;\\n      const body = wrap && wrap.querySelector('[data-tasks]');\\n      const chev = rowHead.querySelector('[data-chev]');\\n      if (body) { const wasHidden = body.classList.contains('hidden'); body.classList.toggle('hidden'); if (chev) chev.style.transform = wasHidden ? 'rotate(90deg)' : ''; rowHead.setAttribute('aria-expanded', String(wasHidden)); }\\n    }\\n    function copyResourceLoad() {\\n      const tasksByPerson = _activeTasksByPerson();\\n      const people = projectResources\\n        .map(res => ({ name: parseResourceToken(res).name, role: (parseResourceToken(res).role || resourceRoles[res] || ''), tasks: tasksByPerson[parseResourceToken(res).name] || [] }))\\n        .filter(x => x.tasks.length > 0)\\n        .sort((a, b) => b.tasks.length - a.tasks.length);\\n      const lines = ['Загрузка команды (активные задачи) — ' + (typeof getTodayProjectDate === 'function' ? toYmdLocal(getTodayProjectDate()) : ''), ''];\\n      if (!people.length) lines.push('Активных задач нет.');\\n      people.forEach(p => {\\n        lines.push(`${p.name}${p.role ? ' (' + p.role + ')' : ''} — ${p.tasks.length} ${pluralRu(p.tasks.length, ['задача', 'задачи', 'задач'])}`);\\n        p.tasks.forEach(t => lines.push(_resTaskLine(t)));\\n        lines.push('');\\n      });\\n      const text = lines.join('\\\\n').trim();\\n      const done = () => { if (typeof showToast === 'function') showToast('Сводка загрузки скопирована', 'ok'); };\\n      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done).catch(() => { if (typeof fallbackCopy === 'function') fallbackCopy(text, done); });\\n      else if (typeof fallbackCopy === 'function') fallbackCopy(text, done);\\n    }\\n    // Одна строка задачи для сводки: номер, название, даты и ссылка\\n    function _resTaskLine(t) {\\n      const key = getTaskKey(t);\\n      const link = t.jira ? (String(t.jira).startsWith('http') ? t.jira : (jiraBrowseBase() + t.jira)) : '';\\n      return `  - ${key ? key + ' — ' : ''}${t.name} (${formatDateString(t.start)} \\\\u2192 ${formatDateString(t.end)})${link ? ', ' + link : ''}`;\\n    }\\n    // Скопировать загрузку одного исполнителя: имя, роль и все его активные задачи (п.1 , копируем по человеку, не построчно)\\n    function copyResourcePerson(idx) {\\n      const res = projectResources[idx];\\n      if (res === undefined) return;\\n      const p = parseResourceToken(res);\\n      const role = p.role || resourceRoles[res] || '';\\n      const tasks = (_activeTasksByPerson()[p.name] || []);\\n      const lines = [`${p.name}${role ? ' (' + role + ')' : ''} — ${tasks.length} ${pluralRu(tasks.length, ['задача', 'задачи', 'задач'])}`];\\n      tasks.forEach(t => lines.push(_resTaskLine(t)));\\n      const text = lines.join('\\\\n').trim();\\n      const done = () => { if (typeof showToast === 'function') showToast('Скопировано: ' + p.name, 'ok'); };\\n      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done).catch(() => { if (typeof fallbackCopy === 'function') fallbackCopy(text, done); });\\n      else if (typeof fallbackCopy === 'function') fallbackCopy(text, done);\\n    }\\n    // Скопировать загрузку по роли: все исполнители роли и их задачи (п.1 , копируем по роли)\\n    function copyResourceRole(role) {\\n      const tasksByPerson = _activeTasksByPerson();\\n      const seen = new Set(); const people = [];\\n      projectResources.forEach(tok => {\\n        const p = parseResourceToken(tok);\\n        const ro = effectiveRole(tok) || 'Без роли';\\n        if (ro !== role || seen.has(p.name)) return;\\n        seen.add(p.name); people.push(p.name);\\n      });\\n      const lines = ['Роль: ' + role, ''];\\n      if (!people.length) lines.push('Нет исполнителей.');\\n      people.forEach(name => {\\n        const tasks = tasksByPerson[name] || [];\\n        lines.push(`${name} — ${tasks.length} ${pluralRu(tasks.length, ['задача', 'задачи', 'задач'])}`);\\n        tasks.forEach(t => lines.push(_resTaskLine(t)));\\n        lines.push('');\\n      });\\n      const text = lines.join('\\\\n').trim();\\n      const done = () => { if (typeof showToast === 'function') showToast('Скопирована роль: ' + role, 'ok'); };\\n      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done).catch(() => { if (typeof fallbackCopy === 'function') fallbackCopy(text, done); });\\n      else if (typeof fallbackCopy === 'function') fallbackCopy(text, done);\\n    }\\n    function setResourceRole(name, role) {\\n      if (READ_ONLY_MODE) return;\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      role = (role || '').trim();\\n      if (role) resourceRoles[name] = role; else delete resourceRoles[name];\\n      try { storage.set('gantt_resource_roles', JSON.stringify(resourceRoles)); } catch (e) {}\\n      renderResourceManagerList();\\n    }\\n    function setResourceAvailability(name, val) {\\n      if (READ_ONLY_MODE) return;\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      let p = parseInt(val, 10);\\n      if (!Number.isFinite(p) || p === 100) { delete resourceAvailability[name]; }\\n      else { resourceAvailability[name] = Math.max(0, Math.min(100, p)); }\\n      try { storage.set('gantt_resource_availability', JSON.stringify(resourceAvailability)); } catch (e) {}\\n      renderResourceManagerList();\\n      if (typeof scheduleAutoSaveFile === 'function') scheduleAutoSaveFile();\\n    }\\n    // ===== Деньги и трудозатраты: ставки, стоимость задач, бюджеты, факт-часы =====\\n    function _resourceRate(token) { const v = parseFloat((resourceRates || {})[token]); return (Number.isFinite(v) && v > 0) ? v : 0; }\\n    function setResourceRate(token, val) {\\n      if (READ_ONLY_MODE) return;\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      const v = parseFloat(val);\\n      if (Number.isFinite(v) && v > 0) resourceRates[token] = v; else delete resourceRates[token];\\n      try { storage.set('gantt_resource_rates', JSON.stringify(resourceRates)); } catch (e) {}\\n      if (typeof scheduleAutoSaveFile === 'function') scheduleAutoSaveFile();\\n    }\\n    // Часы задачи для стоимости: явная оценка в часах, иначе оценка в днях * 8 ч, иначе 0\\n    function taskCostHours(t) { const h = parseFloat(t && t.hours); if (h > 0) return h; const e = parseFloat(t && t.estimate); if (e > 0) return e * 8; return 0; }\\n    function _effortPeople(value) {\\n      const roles = new Set(typeof RES_KNOWN_ROLES !== 'undefined' ? RES_KNOWN_ROLES : []);\\n      Object.values(typeof resourceRoles !== 'undefined' ? resourceRoles : {}).forEach(role => { if (role) roles.add(role); });\\n      (typeof projectResources !== 'undefined' ? projectResources : []).forEach(token => { const p = parseResourceToken(token); if (p.role) roles.add(p.role); });\\n      return splitResourceTokens(value).map(token => { const p = parseResourceToken(token); return !p.role && roles.has(p.name) ? null : p.name; });\\n    }\\n    function _effortNumber(value) {\\n      return Number(value).toLocaleString('ru-RU',{maximumFractionDigits:2});\\n    }\\n    function _effortComparisonHtml(includeArchive) {\\n      const report = RoadmapModules.buildEffortComparison(roadmapData,{people:_effortPeople,plannedHours:typeof taskCostHours === 'function' ? taskCostHours : undefined,archivedTasks,includeArchive});\\n      const number = value => escHtml(_effortNumber(value));\\n      const rows = report.rows.map(row => '<tr><th scope=\\\"row\\\">'+escHtml(row.name)+'</th><td>'+(row.estimatedTasks ? number(row.planned) : 'нет оценки')+'</td><td>'+(row.entries ? number(row.logged) : 'нет записей')+'</td><td>'+row.matched.length+' из '+row.assignedTasks+'</td><td>'+(row.delta == null ? 'нет сопоставления' : (row.delta > 0 ? '+' : '')+number(row.delta))+'</td></tr>').join('');\\n      const details = report.rows.filter(row => row.matched.length).map(row => '<details><summary>'+escHtml(row.name)+': сопоставлено задач '+row.matched.length+'</summary><ul class=\\\"candidate-list\\\">'+row.matched.map(t => '<li><strong>'+escHtml(t.name || t.jira || String(t.id))+(t.archived ? ' (архив)' : '')+'</strong><small>Оценка доли: '+number(t.plan)+' ч · Записано: '+number(t.logged)+' ч</small></li>').join('')+'</ul></details>').join('');\\n      return '<p><strong>Текущие оценки и записанные часы.</strong> '+(includeArchive ? 'Активный план и архив' : 'Активный план')+', без скрытых задач и вех. Фильтры не ограничивают отчет. Период: все доступные записи выбранных задач.</p>'\\n        +'<div class=\\\"effort-summary\\\"><span>Задач: <strong>'+report.tasks+'</strong></span><span>Оценка: <strong>'+number(report.totalPlan)+' ч</strong></span><span>Записано: <strong>'+number(report.totalLogged)+' ч</strong></span></div>'\\n        +(report.rows.length ? '<div class=\\\"effort-scroll\\\" role=\\\"region\\\" aria-label=\\\"Оценка и записанные часы по людям\\\" tabindex=\\\"0\\\"><table class=\\\"effort-table\\\"><caption>По людям, часы</caption><thead><tr><th scope=\\\"col\\\">Исполнитель / автор записи</th><th scope=\\\"col\\\">Оценка всех задач, ч</th><th scope=\\\"col\\\">Записано, ч</th><th scope=\\\"col\\\">Сопоставлено задач</th><th scope=\\\"col\\\">Разница, ч</th></tr></thead><tbody>'+rows+'</tbody></table></div>' : '<p>Нет данных по людям. Назначьте исполнителей и укажите оценку в карточке задачи. Фактические часы вносятся в журнале карточки.</p>')\\n        +(report.rows.length ? '<p class=\\\"effort-scroll-hint\\\">Таблицу можно прокрутить вправо. Имена остаются слева.</p>' : '')\\n        +'<p>Автор записи часов не обязательно исполнитель работы. Пустой или составной автор не заменяется исполнителем задачи. Неполный журнал не означает нулевые затраты.</p>'\\n        +'<p>Разница: записано минус оценка только сопоставленных задач, не рейтинг людей.</p>'\\n        +'<details><summary>Как считаются часы и разница</summary><p>Оценка текущая, не сохраненное обещание: часы, иначе дни по 8 ч. Совместная оценка делится поровну между разными назначениями; доли ролей без человека не приписываются людям.</p><p>Задача сопоставлена, если есть оценка, человек назначен и от его имени есть положительная запись. Это не признак завершенности учета.</p></details>'\\n        +((report.withoutEstimate || report.unassignedPlan || report.unattributedLogged || report.unmatchedLogged) ? '<p>Неполные данные: задач без оценки '+report.withoutEstimate+', оценка без человека '+number(report.unassignedPlan)+' ч, часы без однозначного автора '+number(report.unattributedLogged)+' ч, именные часы без сопоставления '+number(report.unmatchedLogged)+' ч.</p>' : '')\\n        +'<details><summary>Состав и пропуски</summary><p>Без оценки: '+report.withoutEstimate+' задач. Совместных назначений: '+report.sharedTasks+'. Оценка без человека: '+number(report.unassignedPlan)+' ч. Часы без однозначного автора: '+number(report.unattributedLogged)+' ч. Именные часы без сопоставления: '+number(report.unmatchedLogged)+' ч.</p><p>Скрытых задач: '+report.hiddenTasks+'. Вех: '+report.milestones+'. Дублей ID: '+report.duplicateTasks+'. Нулевых записей часов: '+report.zeroEntries+'. Некорректных или отрицательных записей: '+report.invalidEntries+'.</p></details>'\\n        +(details ? '<h3 class=\\\"rm-dialog-title\\\">Проверить сопоставление</h3>'+details : '');\\n    }\\n    function openEffortComparison() {\\n      if (typeof featureFlags !== 'undefined' && featureFlags.money === false) { showToast('Модуль «Деньги» выключен. Включить: Настройки → Функции','info',3500); return; }\\n      _openCandidateDialog('effortComparisonModal','Обещал / потратил','<label class=\\\"overview-check\\\"><input type=\\\"checkbox\\\" id=\\\"effortIncludeArchive\\\" onchange=\\\"renderEffortComparison()\\\">Включить архив</label><div id=\\\"effortComparisonResult\\\" class=\\\"overview-list\\\"></div>','closeEffortComparison');\\n      renderEffortComparison();\\n    }\\n    function renderEffortComparison() {\\n      const modal = document.getElementById('effortComparisonModal'); if (!modal) return;\\n      modal.querySelector('#effortComparisonResult').innerHTML = _effortComparisonHtml(modal.querySelector('#effortIncludeArchive').checked);\\n    }\\n    function closeEffortComparison() { _closeCandidateDialog('effortComparisonModal'); }\\n    // Ставка задачи: среднее по ее исполнителям (совпадение по имени, затем по роли исполнителя, иначе 0)\\n    function taskRate(t) {\\n      const toks = String((t && t.resource) || '').split(/[;,\\\\/]+/).map(x => x.trim()).filter(Boolean);\\n      if (!toks.length) return 0;\\n      const rates = toks.map(tk => {\\n        const p = (typeof parseResourceToken === 'function') ? parseResourceToken(tk) : { name: tk, role: '' };\\n        let r = _resourceRate(tk) || _resourceRate(p.name);\\n        if (!r) { const role = p.role || resourceRoles[tk] || resourceRoles[p.name] || ''; if (role) r = _resourceRate(role); }\\n        return r || 0;\\n      });\\n      const pos = rates.filter(r => Number.isFinite(r) && r > 0); // среднее только по тем, у кого ставка задана\\n      return pos.length ? (pos.reduce((s, r) => s + r, 0) / pos.length) : 0;\\n    }\\n    // Стоимость задачи: фикс-стоимость (если задана положительная) заменяет расчет часы * ставка\\n    function taskCost(t) { const _f = parseFloat(t && t.costFixed); if (Number.isFinite(_f) && _f > 0) return _f; return taskCostHours(t) * taskRate(t); }\\n    function currencySymbol() { try { const s = storage.get('gantt_currency_symbol'); return (typeof s === 'string' && s.trim()) ? s.trim() : 'руб'; } catch (e) { return 'руб'; } }\\n    function fmtMoney(x) { return Math.round(x || 0).toLocaleString('ru-RU') + ' ' + currencySymbol(); }\\n    // Разбивка стоимости по статьям CAPEX/OPEX: одна строка для окна «Деньги» и финансового блока PDF-сводки.\\n    // Пустая строка, если статьи и фикс-стоимости нигде не заданы , тогда блок не показываем.\\n    function _moneyCostBreakdown(taskSource) {\\n      const tasks = (Array.isArray(taskSource) ? taskSource : (roadmapData || [])).filter(t => t && !t.isMilestone && !t.hidden);\\n      let cap = 0, op = 0, none = 0, any = false;\\n      tasks.forEach(t => {\\n        const c = taskCost(t);\\n        const ty = (t.costType === 'CAPEX' || t.costType === 'OPEX') ? t.costType : '';\\n        const f = parseFloat(t.costFixed);\\n        if (ty || (Number.isFinite(f) && f > 0)) any = true;\\n        if (ty === 'CAPEX') cap += c; else if (ty === 'OPEX') op += c; else none += c;\\n      });\\n      if (!any) return '';\\n      var _p=[]; if(cap>0)_p.push('CAPEX: '+fmtMoney(cap)); if(op>0)_p.push('OPEX: '+fmtMoney(op)); if(none>0)_p.push('без статьи: '+fmtMoney(none)); return _p.length?('в т.ч. '+_p.join(', ')):'';\\n    }\\n    // ===== Свои поля 