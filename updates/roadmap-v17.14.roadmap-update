eld (Epic Name)', 'Epic Name'];\\n    const PARENT_COLS = ['Пользовательское поле (Parent Link)', 'Custom field (Parent Link)', 'Parent Link', 'Parent', 'Parent id', 'Parent key', 'Родительская задача'];\\n    function getEpicLinkKey(issue) { const v = firstNonEmpty(issue, EPIC_LINK_COLS); return jiraKeyOf(v) || (window.tempKeyById && window.tempKeyById[String(v).trim()]) || ''; }\\n    function getEpicNameField(issue) { return firstNonEmpty(issue, EPIC_NAME_COLS); }\\n    function getParentKey(issue) { const v = firstNonEmpty(issue, PARENT_COLS); return jiraKeyOf(v) || (window.tempKeyById && window.tempKeyById[String(v).trim()]) || ''; }\\n    function isJiraHierarchyLinkColumn(column) {\\n      return globalThis.RoadmapModules.isJiraHierarchyColumn(column);\\n    }\\n    function jiraIssueLinks(issue) {\\n      return globalThis.RoadmapModules.parseJiraIssueLinks(issue);\\n    }\\n    // Одна карта для предпросмотра и применения. Только явные родительские поля\\n    // и иерархические link types задают папки; Blocks/Relates не назначают родителей.\\n    function jiraHierarchyContext(issues) {\\n      return globalThis.RoadmapModules.createJiraHierarchyContext(issues, planSections, sectionMeta);\\n    }\\n    // Fallback применяется только к явно иерархическим связям, никогда к Blocks/Relates.\\n    function getStoryParentFromLinks(issue) {\\n      const selfKey = firstNonEmpty(issue, ['Ключ проблемы', 'Issue key', 'Key']);\\n      const found = new Set();\\n      const columns = Object.keys(issue || {});\\n      for (const k of columns) {\\n        if (!isJiraHierarchyLinkColumn(k)) continue;\\n        const keys = String(issue[k] || '').match(/[A-Z][A-Z0-9]+-\\\\d+/g) || [];\\n        for (const kk of keys) {\\n          if (!kk || kk === selfKey) continue;\\n          const rank = jiraHierarchyRankFromType((window.tempTypeByKey && window.tempTypeByKey[kk]) || '');\\n          if (rank === 2) found.add(kk);\\n        }\\n      }\\n      return found.size === 1 ? [...found][0] : '';\\n    }\\n    function resolveJiraParents(issue) {\\n      const issueType = firstNonEmpty(issue, ['Тип задачи', 'Тип запроса', 'Тип проблемы', 'Issue Type', 'Issue type']) || '';\\n      const selfRank = jiraHierarchyRankFromType(issueType);\\n      const selfKey = jiraKeyOf(firstNonEmpty(issue, ['Ключ проблемы', 'Issue key', 'Key']));\\n      const typeRankOf = (k) => jiraHierarchyRankFromType((window.tempTypeByKey && window.tempTypeByKey[k]) || '');\\n      let directParent = (selfKey && window.tempHierarchyParent && window.tempHierarchyParent[selfKey]) || '';\\n      const explicitParent = getParentKey(issue);\\n      if (!directParent && explicitParent && typeRankOf(explicitParent) === selfRank - 1) directParent = explicitParent;\\n\\n      let initiativeKey = '';\\n      let epicKey = getEpicLinkKey(issue);\\n      let storyKey = '';\\n      if (selfRank === 1 && directParent && typeRankOf(directParent) === 0) initiativeKey = directParent;\\n      if (selfRank === 2) {\\n        if (directParent && typeRankOf(directParent) === 1) epicKey = directParent;\\n      } else if (selfRank === 3) {\\n        if (directParent && typeRankOf(directParent) === 2) storyKey = directParent;\\n        if (!storyKey && !directParent && !explicitParent && window.tempStoryChildOf && window.tempStoryChildOf[selfKey]) storyKey = window.tempStoryChildOf[selfKey];\\n        if (!storyKey && !directParent && !explicitParent && !(window.tempHierarchyConflicts && window.tempHierarchyConflicts.has(selfKey))) storyKey = getStoryParentFromLinks(issue);\\n        // Epic Link у обычной задачи — дедушка, а не прямой родитель. Он остается метаданными,\\n        // но без Story задача должна быть в корне, а не напрямую внутри Epic.\\n        if (storyKey && !epicKey && window.tempHierarchyParent) {\\n          const candidate = window.tempHierarchyParent[storyKey];\\n          if (candidate && typeRankOf(candidate) === 1) epicKey = candidate;\\n        }\\n      }\\n      return { initiativeKey, epicKey, storyKey, directParent };\\n    }\\n    function jiraHasParentUpdate(issue, parents) {\\n      const key = jiraKeyOf(firstNonEmpty(issue, ['Ключ проблемы','Issue key','Key']));\\n      const rank = jiraTypeRank(issue);\\n      return PARENT_COLS.some(column => Object.prototype.hasOwnProperty.call(issue,column)) ||\\n        !!(parents.directParent || parents.storyKey || (rank <= 2 && (parents.epicKey || parents.initiativeKey))) ||\\n        !!(window.tempHierarchyConflicts && window.tempHierarchyConflicts.has(key));\\n    }\\n\\n    function getJiraEpicSection(issue) {\\n      const issueType = (firstNonEmpty(issue, ['Тип задачи', 'Тип запроса', 'Тип проблемы', 'Issue Type', 'Issue type']) || '').toLowerCase();\\n      const epicName = getEpicNameField(issue);\\n      const _hp = resolveJiraParents(issue);\\n      const epicLink = _hp.epicKey;\\n      const parentLink = _hp.storyKey;\\n      const summary = firstNonEmpty(issue, ['Тема', 'Summary']);\\n\\n      // Порядок проверок: initiative-сам -> epic-сам -> story-сам -> родитель-story.\\n      // ВАЖНО: Story и задача с родителем-Story проверяются РАНЬШЕ Epic Link, иначе история\\n      // (у нее обычно тоже есть Epic Link) попадала бы плоско в секцию эпика, а дети , рядом с ней.\\n\\n      // 0) Сама Initiative становится корневой секцией.\\n      if (jiraHierarchyRankFromType(issueType) === 0) {\\n        const key = firstNonEmpty(issue, ['Ключ проблемы', 'Issue key', 'Key']);\\n        return `Initiative: ${summary || key}${key ? ' [' + key + ']' : ''}`;\\n      }\\n\\n      // 1) Сама задача , Epic: дает свою секцию\\n      if (jiraHierarchyRankFromType(issueType) === 1) {\\n        const key = firstNonEmpty(issue, ['Ключ проблемы', 'Issue key', 'Key']);\\n        const name = epicName || summary;\\n        return `Epic: ${name}${key ? ' [' + key + ']' : ''}`;\\n      }\\n\\n      // 2) Сама задача , Story: становится своей секцией (даже при наличии Epic Link).\\n      //    По