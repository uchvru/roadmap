 task.external ? 'Внешняя' : 'Моя задача';\\n    }\\n    // Ручная задача (не веха, не из Jira) , только у нее переключается тип Моя / Внешняя\\n    function _taskMineable(task) {\\n      if (!task || task.isMilestone) return false;\\n      if (task.issueType && String(task.issueType).trim()) return false;\\n      if (task.jira && String(task.jira).trim()) return false;\\n      if (task.notes && /(?:^|\\\\n)\\\\s*Тип:\\\\s*\\\\S/i.test(String(task.notes))) return false;\\n      return true;\\n    }\\n    // Переключить ручную задачу между «Моя» и «Внешняя» (клик по чипу типа в строке)\\n    function toggleTaskExternal(id) {\\n      if (typeof READ_ONLY_MODE !== 'undefined' && READ_ONLY_MODE) { if (typeof showToast === 'function') showToast('Только просмотр', 'info', 2000); return; }\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      var t = (roadmapData || []).find(function (x) { return x && x.id === id; });\\n      if (!t || !_taskMineable(t)) return;\\n      var snap = (typeof captureUndoState === 'function') ? captureUndoState() : null;\\n      t.external = !t.external;\\n      if (typeof persistProjectState === 'function') persistProjectState(); else { try { persistPlan({ undo: true, before: snap }); } catch (e) {} }\\n      if (typeof scheduleAutoSaveFile === 'function') scheduleAutoSaveFile();\\n      renderRoadmap(true);\\n      if (snap && typeof offerUndo === 'function') offerUndo('Тип задачи: ' + (t.external ? 'Внешняя' : 'Моя'), snap);\\n      else if (typeof showToast === 'function') showToast(t.external ? 'Внешняя задача' : 'Моя задача', 'ok', 2000);\\n    }\\n    var _taskAnchorPending = null, _taskAnchorHandled = '';\\n    function copyTaskAnchorLink() {\\n      const id = document.getElementById('taskId').value;\\n      const task = (roadmapData || []).concat(archivedTasks || []).find(t => t && String(t.id) === String(id));\\n      if (!task) { showToast('Сначала сохраните задачу.', 'info'); return; }\\n      const link = RoadmapModules.buildTaskLink(window.location.href, task.id, projectStorageId);\\n      if (!link) { showToast('Ссылка недоступна для этого адреса. Откройте рабочий HTML-файл.', 'warn', 6000); return; }\\n      if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {\\n        openInputModal({title:'Ссылка на задачу в этом файле',desc:'Скопируйте ссылку. Она не передает план и требует доступ к тому же файлу.',value:link,okText:'Готово'}); return;\\n      }\\n      navigator.clipboard.writeText(link).then(() => showToast('Ссылка скопирована. Она открывает задачу в этой копии файла.', 'ok', 5000))\\n        .catch(() => openInputModal({title:'Ссылка на задачу в этом файле',desc:'Скопируйте ссылку вручную.',value:link,okText:'Готово'}));\\n    }\\n    function _queueTaskAnchor() {\\n      const hash = window.location.hash;\\n      if (!appInitialized) return;\\n      if (!RoadmapModules.parseTaskAnchor(hash)) { _taskAnchorPending = null; _taskAnchorHandled = ''; return; }\\n      if (projectStorageId + '\\\\n' + hash === _taskAnchorHandled) return;\\n      _taskAnchorPending = {hash,project:projectStorageId,transition:_projectTransitionToken};\\n      _openPendingTaskAnchor();\\n    }\\n    function _openPendingTaskAnchor() {\\n      const pending = _taskAnchorPending;\\n      if (!pending) return;\\n      if (pending.hash !== window.location.hash || pending.project !== projectStorageId || pending.transition !== _projectTransitionToken) { _taskAnchorPending = null; return; }\\n      const modal = document.getElementById('taskModal');\\n      if (modal && !modal.classList.contains('hidden') && _taskDirty && !READ_ONLY_MODE) return;\\n      _taskAnchorPending = null; _taskAnchorHandled = projectStorageId + '\\\\n' + pending.hash;\\n      const ref = RoadmapModules.parseTaskAnchor(pending.hash);\\n      if (!ref || ref.projectId !== projectStorageId) { showToast('Ссылка относится к другому проекту. Откройте его рабочий файл.', 'warn', 60