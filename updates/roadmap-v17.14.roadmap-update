\\n    }\\n    // Status-first сводка окна Jira: только производные значения, без новых полей хранения.\\n    function renderJiraSyncSummary() {\\n      const host = document.getElementById('jiraSyncSummary'); if (!host) return;\\n      const cfg = (typeof getJiraCfg === 'function') ? getJiraCfg() : {};\\n      const info = (typeof _jiraLastImportInfo === 'function') ? _jiraLastImportInfo() : null;\\n      const activeChanges = (Array.isArray(roadmapData) ? roadmapData : []).filter(t => t && t._jiraChange).length;\\n      const archivedChanges = (Array.isArray(archivedTasks) ? archivedTasks : []).filter(t => t && t._jiraChange).length;\\n      let outgoing = 0;\\n      try { outgoing = (typeof _collectJiraChanges === 'function' ? _collectJiraChanges() : []).length; } catch (e) {}\\n      const every = Math.max(0, parseInt(cfg.syncEvery, 10) || 0);\\n      let sessionActive = false;\\n      try { sessionActive = !!(cfg.base && typeof jiraSessionTokenFor === 'function' && jiraSessionTokenFor(cfg.base)); } catch (e) {}\\n      let timerActive = false; try { timerActive = !!_jiraAutoTimer; } catch (e) {}\\n      const put = function(id, value){ const el = document.getElementById(id); if (el) el.textContent = value; };\\n      put('jiraSummaryFreshness', info ? (info.stale ? 'Устарело · ' + info.ago : 'Обновлено ' + info.ago) : 'Еще не загружалось');\\n      put('jiraSummarySession', !cfg.base ? 'Не настроено' : (sessionActive ? 'Токен активен' : 'Без активного токена'));\\n      put('jiraSummaryIncoming', String(activeChanges + archivedChanges));\\n      put('jiraSummaryIncomingHint', activeChanges + ' в плане · ' + archivedChanges + ' в архиве');\\n      put('jiraSummaryOutgoing', String(outgoing));\\n      put('jiraSummarySchedule', every > 0 ? (every + ' мин · ' + (timerActive ? 'работает' : 'ждет токен')) : 'Выключено');\\n      host.setAttribute('data-jira-freshness', !info ? 'empty' : (info.stale ? 'stale' : 'fresh'));\\n      host.setAttribute('data-jira-session', sessionActive ? 'active' : 'inactive');\\n    }\\n    // ===== Изменения из Jira: новые и обновленные задачи последнего импорта =====\\n    function renderJiraChangesChip() {\\n      const chip = document.getElementById('jiraChangesChip'); if (!chip) return;\\n      const menuChip = document.getElementById('planningJiraChanges');\\n      const hideBoth = function(){ chip.classList.add('hidden'); if(menuChip){menuChip.classList.add('hidden');menuChip.classList.remove('flex');} };\\n      if (typeof featureFlags !== 'undefined' && featureFlags.jira === false) { hideBoth(); return; }\\n      if (typeof READ_ONLY_MODE !== 'undefined' && READ_ONLY_MODE) { hideBoth(); return; }\\n      const hasJira = (Array.isArray(roadmapData) && roadmapData.some(t => t && t.jira)) || (Array.isArray(archivedTasks) && archivedTasks.some(t => t && t.jira));\\n      const info = (typeof _jiraLastImportInfo === 'function') ? _jiraLastImportInfo() : null;\\n      if (!hasJira || !info) { hideBoth(); return; }\\n      const dateEl = document.getElementById('jiraFreshDate'); if (dateEl) dateEl.textContent = info.short;\\n      const n = (Array.isArray(roadmapData) ? roadmapData : []).filter(t => t && t._jiraChange).length\\n        + (Array.isArray(archivedTasks) ? archivedTasks : []).filter(t => t && t._jiraChange).length;\\n      const cntEl = document.getElementById('jiraFreshCount');\\n      if (cntEl) { if (n > 0) { cntEl.textContent = ', ' + n + ' измен.'; cntEl.classList.remove('hidden'); } else { cntEl.textContent = ''; cntEl.classList.add('hidden'); } }\\n      const amber = ['bg-amber-50', 'hover:bg-amber-100', 'border-amber-300', 'text-amber-800'];\\n      const rose = ['bg-rose-50', 'hover:bg-rose-100', 'border-rose-300', 'text-rose-700'];\\n      if (info.stale) { amber.forEach(c => chip.classList.remove(c)); rose.forEach(c => chip.classList.add(c)); }\\n      else { rose.forEach(c => chip.classList.remove(c)); amber.forEach(c => chip.classList.add(c)); }\\n      chip.title = 'Д