es.dateFormatShort(dateStr, CURRENT_DATE, _tlMultiYear); }\\n\\n    // Номер ISO-недели (правило четверга): неделя принадлежит году, в котором ее четверг\\n    function isoWeekNumber(d) { return RoadmapModules.dateIsoWeekNumber(d); }\\n    // === Полоса «Команда: отсутствия» под таймлайном (та же шкала дат, что у баров) ===\\n    function _taskLeaveConflict(task) {\\n      try {\\n        if (!task || !task.start || task.isMilestone) return null;\\n        var ts = String(task.start), te = String(task.end || task.start);\\n        var toks = (typeof splitResourceTokens === 'function') ? splitResourceTokens(task.resource) : String(task.resource || '').split(/[;,\\\\/]+/);\\n        for (var i = 0; i < toks.length; i++) {\\n          var nm = ((typeof parseResourceToken === 'function') ? parseResourceToken(toks[i]).name : toks[i]) || '';\\n          nm = String(nm).trim(); if (!nm) continue;\\n          var arr = (typeof resourceLeave !== 'undefined' && resourceLeave) ? resourceLeave[nm] : null;\\n          if (!Array.isArray(arr)) continue;\\n          for (var j = 0; j < arr.length; j++) { var p = arr[j]; if (p && p.from && p.to && p.type !== 'remote' && p.type !== 'workday' && ts <= p.to && te >= p.from) return { name: nm, type: p.type, from: p.from, to: p.to }; }\\n        }\\n      } catch (e) {}\\n      return null;\\n    }\\n    // Перегруз по параллельности: у исполнителя с лимитом больше одновременных задач, чем разрешено\\n    let _parViolIds = new Set();\\n    function _computeParallelViolations() {\\n      const out = new Set();\\n      try {\\n        const lim = {}; Object.keys(resourceParallel || {}).forEach(n => { const v = _resParLimit(n); if (v > 0) lim[n] = v; });\\n        if (!Object.keys(lim).length) return out;\\n        const byRes = {};\\n        (roadmapData || []).forEach(t => {\\n          if (!t || t.isMilestone || isFinalStatus(t.status) || isHeldStatus(t.status) || !t.start || !t.end) return;\\n          const nm = String(t.resource || '