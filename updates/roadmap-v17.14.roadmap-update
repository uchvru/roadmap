ils[open]')).map(n=>n.dataset.digestGroup));\\n      const first=!host.children.length;\\n      const m=RoadmapModules.buildPlanDigest(roadmapData,{today:toYmdLocal(CURRENT_DATE),isFinal:isFinalStatus,isActive:isActiveStatus,isHeld:isHeldStatus});\\n      document.getElementById('digestSummary').textContent=formatDateString(m.today)+' · Готово '+m.done+' из '+m.total+'. Ближайшие 7 дней: '+formatDateString(m.today)+' — '+formatDateString(m.horizon)+'. Задача может входить в несколько групп.';\\n      host.innerHTML=m.groups.map(g=>{\\n        const limit=_digestLimits[g.key]||5;\\n        return '<details class=\\\"overview-group\\\" data-digest-group=\\\"'+g.key+'\\\"'+(opened.has(g.key)||(first&&['overdue','upcoming'].includes(g.key))?' open':'')+'><summary>'+g.title+' <strong>'+g.tasks.length+'</strong></summary>'\\n          +(g.key==='overdue'?'<p>Задачи на паузе (Hold) сюда не входят.</p>':'')\\n          +(g.tasks.length?g.tasks.slice(0,limit).map(t=>_overviewTaskButton(t,'digest',[statusNameById(t.status),t.end?formatDateString(t.end):'Без даты',t.resource].filter(Boolean).join(' · '))).join(''):'<p>Таких задач нет.</p>')\\n          +(g.tasks.length>limit?'<button type=\\\"button\\\" class=\\\"rm-btn rm-btn-secondary overview-more\\\" data-digest-more=\\\"'+g.key+'\\\" onclick=\\\"showMoreDigest(this.dataset.digestMore)\\\">Показать ещё '+Math.min(20,g.tasks.length-limit)+'</button>':'')+'</details>';\\n      }).join('');\\n      if(focusKey){const group=host.querySelector('[data-digest-group=\\\"'+focusKey+'\\\"]');(group?.querySelector('[data-digest-more]')||group?.querySelector('summary'))?.focus({preventScroll:true});}\\n    }\\n    var _workTemplateContext=null;\\n    function openWorkTemplates(section) {\\n      closeMoreMenu(true);\\n      const selected=Array.from(selectedTaskIds||[]).map(String);\\n      _workTemplateContext={epoch:_projectTransitionToken,selected,sections:planSections.slice(),applying:null};\\n      const options='<option value=\\\"selected\\\">Выбранные задачи ('+selected.length+')</option>'+planSections.map((s,i)=>'<option value=\\\"section:'+i+'\\\">Секция: '+escHtml(s)+'</option>').join('');\\n      const modal=_openCandidateDialog('workTemplatesModal','Шаблоны задач и секций',\\n        '<p>Сохраните повторяемый состав работ. Библиотека переносится вместе с рабочим HTML; после изменения сохраните файл.</p>'\\n        +'<label class=\\\"candidate-field\\\">Из чего создать шаблон<select id=\\\"templateSource\\\" class=\\\"rm-control\\\" onchange=\\\"renderWorkTemplateSource()\\\">'+options+'</select></label>'\\n        +'<p id=\\\"templateSourceNote\\\"></p><label class=\\\"candidate-field\\\">Название шаблона<input id=\\\"templateName\\\" class=\\\"rm-control\\\" maxlength=\\\"120\\\" autocomplete=\\\"off\\\"></label>'\\n        +'<div class=\\\"candidate-actions\\\"><button id=\\\"templateSave\\\" type=\\\"button\\\" class=\\\"rm-btn rm-btn-secondary\\\" onclick=\\\"saveWorkTemplate()\\\">Сохранить шаблон</button></div>'\\n        +'<div id=\\\"templateError\\\" class=\\\"candidate-error\\\" role=\\\"alert\\\"></div><h3 class=\\\"font-semibold\\\">Сохранённые шаблоны</h3><ul id=\\\"workTemplateList\\\" class=\\\"candidate-list\\\"></ul>'\\n        +'<div id=\\\"templateApplyPanel\\\" hidden><div class=\\\"candidate-field\\\"><h3 id=\\\"templateApplyTitle\\\" class=\\\"font-semibold\\\"></h3><p>Будут созданы новые задачи. Скопируются названия, оценки, длительности и связи внутри набора. Исполнители, Jira, спринты и внешние связи не переносятся.</p>'\\n        +'<label class=\\\"candidate-field\\\">Начало набора<input id=\\\"templateStart\\\" class=\\\"rm-control\\\" type=\\\"date\\\" required></label><label class=\\\"candidate-field\\\">Секция для новых задач<input id=\\\"templateTargetSection\\\" class=\\\"rm-control\\\" list=\\\"templateSections\\\" maxlength=\\\"200\\\" required><datalist id=\\\"templateSections\\\">'+planSections.map(s=>'<option value=\\\"'+escAttr(s)+'\\\"></option>').join('')+'</datalist></label>'\\n        +'<div class=\\\"candidate-actions\\\"><button id=\\\"templateApply\\\" type=\\\"button\\\" class=\\\"rm-btn rm-btn-primary\\\" onclick=\\\"applySavedWorkTemplate()\\\">Добавить задачи</button><button type=\\\"button\\\" class=\\\"rm-btn rm-btn-secondary\\\" onclick=\\\"cancelWorkTemplateApply()\\\">Отмена</button></div></div></div>', 'closeWorkTemplates');\\n      if(typeof section==='string'&&planSections.includes(section))modal.querySelector('#templateSource').value='section:'+planSections.indexOf(section);\\n      modal.querySelector('#templateName').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();saveWorkTemplate();}});\\n      renderWorkTemplateSource();renderWorkTemplateList();\\n    }\\n    function _workTemplateCanEdit() {\\n      if(!_workTemplateContext||_workTemplateContext.epoch!==_projectTransitionToken){closeWorkTemplates();return false;}\\n      if(READ_ONLY_MODE){showToast('Шаблоны можно менять только в рабочем плане.','info');return false;}\\n      return requireUnlocked();\\n    }\\n    function _workTemplateSource() {\\n      const key=document.getElementById('templateSource')?.value||'selected';\\n      const section=key.startsWith('section:')?_workTemplateContext?.sections[Number(key.slice(8))]:null;\\n      return {kind:section!==null&&section!==undefined?'section':'tasks',tasks:roadmapData.filter(t=>section!==null&&section!==undefined?t.section===section:_workTemplateContext?.selected.includes(String(t.id)))};\\n    }\\n    function renderWorkTemplateSource() {\\n      const source=_workTemplateSource();\\n      document.getElementById('templateSourceNote').textContent=source.tasks.length?'Задач в шаблоне: '+source.tasks.length+(source.kind==='section'?'. Только эта секция, без вложенных.':''):'Выделите задачи в списке или выберите непустую секцию.';\\n      document.getElementById('templateSave').disabled=!source.tasks.length||READ_ONLY_MODE;\\n    }\\n    function renderWorkTemplateList() {\\n      const list=document.getElementById('workTemplateList');if(!list)return;\\n      list.replaceChildren();\\n      if(!workTemplates.length){const li=document.createElement('li');li.textContent='Шаблонов пока нет. Создайте первый из задач выше.';list.appendChild(li);return;}\\n      workTemplates.forEach(template=>{\\n        const li=document.createElement('li'),name=document.createElement('strong'),note=document.createElement('small'),actions=document.createElement('div');\\n        name.textContent=template.name;note.textContent=(template.kind==='section'?'Секция':'Набор задач')+' · '+template.items.length+' задач';actions.className='candidate-actions';\\n        const use=document.createElement('button');use.type='button';use.className='rm-btn rm-btn-secondary';use.textContent='Применить';use.dataset.templateUse=template.id;use.disabled=READ_ONLY_MODE;use.onclick=()=>chooseWorkTemplate(template.id);\\n        const remove=document.createElement('button');remove.type='button';remove.className='rm-btn rm-btn-ghost';remove.textContent='Удалить';remove.setAttribute('aria-label','Удалить шаблон «'+template.name+'»');remove.disabled=READ_ONLY_MODE;remove.onclick=()=>deleteWorkTemplate(template.id);\\n        actions.append(use,remove);li.append(name,note,actions);list.appendChild(li);\\n      });\\n    }\\n    function saveWorkTemplate() {\\n      if(!_workTemplateCanEdit())return;\\n      const input=document.getElementById('templateName'),name=input.value.trim(),error=document.getElementById('templateError');error.textContent='';\\n      if(!name){error.textContent='Введите название шаблона.';input.focus();return;}\\n      if(workTemplates.some(t=>t.name.toLocaleLowerCase()===name.toLocaleLowerCase())){error.textContent='Такое название уже есть. Укажите другое, чтобы сохранить оба шаблона.';input.focus();return;}\\n      try {\\n        const template=RoadmapModules.captureWorkTemplate({id:'template-'+nextTaskId(),name,..._workTemplateSource()})