    req.onsuccess = e => {\\n        const db = e.target.result;\\n        db.onversionchange = () => { try { db.close(); } catch (err) {} };\\n        resolve(db);\\n      };\\n      req.onerror = e => reject(e.target.error);\\n    }); }\\n    const _portableDatabaseBoot = window.__roadmapPortableBoot;\\n    let dbPromise = _openRoadmapDatabase(LEARNING_SCENARIO ? 'RoadmapLearningDB' : _portableDatabaseBoot ? 'RoadmapPortableDB:' + _portableDatabaseBoot.documentId : 'RoadmapDB');\\n\\n    async function _localHistoryDatabaseInfo(name) {\\n      const active = await dbPromise;\\n      if (!/^RoadmapPortableDB:[A-Za-z0-9:_-]+$/.test(name) || name === active.name) return null;\\n      const db = await new Promise((resolve, reject) => {\\n        const req = indexedDB.open(name);\\n        req.onupgradeneeded = () => { req.transaction.abort(); reject(new Error('База уже удалена')); };\\n        req.onsuccess = () => resolve(req.result);\\n        req.onerror = () => reject(req.error || new Error('База недоступна'));\\n      });\\n      try {\\n        if (!db.objectStoreNames.contains('versions') || !db.objectStoreNames.contains('handles')) return null;\\n        return await new Promise((resolve, reject) => {\\n          const tx = db.transaction(['versions','handles'], 'readonly');\\n          const versions = tx.objectStore('versions').getAll(), handles = tx.objectStore('handles').count();\\n          tx.oncomplete = () => {\\n            const rows = versions.result || [];\\n            const signature = JSON.stringify(rows.map(r => [r.id,r.savedAt,r.checksum,r.data]).sort((a,b)=>String(a[0]).localeCompare(String(b[0]))));\\n            resolve({name, count:rows.length, handles:handles.result || 0, latest:rows.map(r=>String(r.savedAt||'')).sort().at(-1)||'', signature});\\n          };\\n          tx.onerror = () => reject(tx.error || new Error('Не удалось проверить базу'));\\n          tx.onabort = () => reject(tx.error || new Error('Проверка базы прервана'));\\n        });\\n      } finally { db.close(); }\\n    }\\n    let _localHistoryCandidates = [], _localHistoryDeletePending = false;\\n    async function openLocalHistoryStorage() {\\n      closeDataMenu();\\n      if (!globalThis.indexedDB || typeof indexedDB.databases !== 'function') { showToast('Этот браузер не предоставляет список локальных баз. Очистка здесь недоступна.', 'warn', 6000); return; }\\n      if (_localHistoryDeletePending) { showToast('Удаление ожидает закрытия другой вкладки. Дождитесь результата.', 'warn', 6000); return; }\\n      closeLocalHistoryStorage();\\n      const modal = document.createElement('div'); modal.id='localHistoryStorageModal';\\n      modal.className='fixed inset-0 bg-slate-900/50 z-[1250] flex items-center justify-center p-4';\\n      modal.setAttribute('role','dialog'); modal.setAttribute('aria-modal','true'); modal.setAttribute('aria-labelledby','localHistoryStorageTitle');\\n      modal.innerHTML='<div class=\\\"rm-panel w-full max-w-2xl max-h-[90vh] flex flex-col\\\"><div class=\\\"p-5 flex items-center justify-between gap-3\\\"><h2 id=\\\"localHistoryStorageTitle\\\" class=\\\"text-lg font-semibold\\\">Локальная история копий</h2><button type=\\\"button\\\" class=\\\"rm-btn rm-btn-secondary\\\" onclick=\\\"closeLocalHistoryStorage()\\\">Закрыть</button></div><div class=\\\"p-5 pt-0 overflow-y-auto min-h-0\\\"><p>Это базы других переносимых копий в этом браузере. Неактивная база не обязательно лишняя. Сначала сохраните нужные рабочие HTML с историей и закройте другие вкладки Roadmap. Удаление базы не меняет файлы на диске, но удаляет ее локальные точки возврата без отмены. Текущая база и базы с привязкой файла защищены от удаления.</p><div id=\\\"localHistoryStorageList\\\" class=\\\"grid gap-3 mt-4\\\" role=\\\"status\\\">Проверяю базы…</div></div></div>';\\n      modal.addEventListener('click', e=>{if(e.target===modal)closeLocalHistoryStorage();});\\n      document.body.appendChild(modal); syncBodyScrollLock();\\n      try {\\n        const list=await indexedDB.databases(), rows=[];\\n        for (const item of list) { try { const row=await _localHistoryDatabaseInfo(item.name||''); if(row)rows.push(row); } catch(e) {} }\\n        if (!modal.isConnected) return;\\n        _localHistoryCandidates=rows;\\n        modal.querySelector('#localHistoryStorageList').innerHTML=rows.length ? rows.map((r,i)=>'<section class=\\\"share-option\\\"><div><h3>Копия '+(i+1)+'</h3><p class=\\\"break-all\\\">'+escHtml(r.name)+'</p><p>Точек: '+r.count+'. Последняя: '+escHtml(r.latest||'нет')+'.'+(r.handles?' Есть привязка файла — удаление недоступно.':'')+'</p></div><button type=\\\"button\\\" class=\\\"rm-btn rm-btn-secondary\\\" '+(r.handles?'disabled':'')+' onclick=\\\"requestLocalHistoryDelete('+i+')\\\">Удалить базу</button></section>').join('') : '<p>Других доступных баз переносимых копий нет.</p>';\\n      } catch(e) { if(modal.isConnected)modal.querySelector('#localHistoryStorageList').textContent='Не удалось получить список баз. Ничего не удалено.'; }\\n    }\\n    function closeLocalHistoryStorage() { document.getElementById('localHistoryStorageModal')?.remove(); syncBodyScrollLock(); }\\n    function requestLocalHistoryDelete(index) {\\n      if (READ_ONLY_MODE || !requireUnlocked()) return;\\n      const row=_localHistoryCandidates[index]; if(!row || row.handles || _localHistoryDeletePending)return;\\n      openConfirm({title:'Удалить локальную историю этой копии?',desc:'База: '+row.name+'. Точек возврата: '+row.count+'. Восстановить их без сохраненного HTML или выгрузки точек будет нельзя. Удалить только эту базу?',okText:'Удалить базу',onOk:async()=>{\\n        if(_localHistoryDeletePending || READ_ONLY_MODE || !requireUnlocked())return;\\n        try {\\n          const check=await _localHistoryDatabaseInfo(row.name);\\n          if(!check || check.handles || check.signature!==row.signature) { showToast('База используется или изменилась. Обновите список; удаление отменено.', 'warn', 6000); return; }\\n          const active=await dbPromise; if(active.name===row.name || READ_ONLY_MODE || !requireUnlocked())return;\\n          _localHistoryDeletePending=true;\\n          await new Promise((resolve,reject)=>{\\n            const req=indexedDB.deleteDatabase(row.name);\\n            req.onsuccess=resolve;\\n            req.onerror=()=>reject(req.error || new Error('Не удалось удалить базу'));\\n            req.onblocked=()=>showToast('Удаление ожидает закрытия другой вкладки с этой копией. Пока база не удалена.', 'warn', 10000);\\n          });\\n          _localHistoryDeletePending=false; showToast('Выбранная локальная база удалена. Файлы на диске не изменены.', 'ok', 6000); openLocalHistoryStorage();\\n        } catch(e) { _localHistoryDeletePending=false; showToast('Удаление не подтверждено: '+e.message, 'error', 7000); }\\n      }});\\n    }\\n    async function saveHandle(handle) {\\n      try {\\n        const db = await dbPromise;\\n        return new Promise((resolve, reject) => {\\n          const tx = db.transaction('handles', 'readwrite');\\n          tx.objectStore('handles').put(handle, 'autoSaveFileHandle');\\n          tx.oncomplete = () => resolve(true);\\n          tx.onerror = () => reject(tx.error || new Error('Не удалось запомнить привязку к файлу'));\\n          tx.onabort = () => reject(tx.error || new Error('Сохранение привязки к файлу прервано'));\\n        });\\n      } catch (e) { console.warn('IDB save error', e); throw e; }\\n    }\\n\\n    async function clearHandle() {\\n      // Хэндл лежит в IndexedDB (store 'handles', ключ 'autoSaveFileHandle') , удаляем оттуда же,\\n      // где saveHandle/getHandle его кладут и читают. Прежняя версия чистила OPFS и не работала.\\n      try {\\n        const db = await dbPromise;\\n        await new Promise((resolve, reject) => {\\n          const tx = db.transaction('handles', 'readwrite');\\n          tx.objectStore('handles').delete('autoSaveFileHandle');\\n          tx.oncomplete = resolve;\\n          tx.onerror = () => reject(tx.error || new Error('Не удалось удалить привязку к файлу'));\\n          tx.onabort = () => reject(tx.error || new Error('Удаление привязки к файлу прервано'));\\n        });\\n        const remains = await new Promise((resolve, reject) => {\\n          const tx = db.transaction('handles', 'readonly');\\n          const req = tx.objectStore('handles').get('autoSaveFileHandle');\\n          req.onsuccess = () => resolve(req.result);\\n          req.onerror = () => reject(req.error || new Error('Не удалось проверить удаление привязки'));\\n        });\\n        if (remains != null) throw new Error('Привязка к файлу осталась в IndexedDB');\\n        return true;\\n      } catch (e) { console.warn('IDB clear error', e); throw e; }\\n    }\\n\\n    // Полное удаление проекта очищает только известные хранилища приложения и\\n    // обязательно проверяет результат. Базу целиком не удаляем: открытое соединение\\n    // блокировало deleteDatabase, а прежний обработчик onblocked ошибочно означал успех.\\n    async function _clearRoadmapIndexedDbStoresVerified() {\\n      const db = await dbPromise;\\n      const names = ['handles', 'versions'].filter(name => db.objectStoreNames.contains(name));\\n      if (!names.length) return true;\\n      await new Promise((resolve, reject) => {\\n        const tx = db.transaction(names, 'readwrite');\\n        names.forEach(name => tx.objectStore(name).clear());\\n        tx.oncomplete = resolve;\\n        tx.onerror = () => reject(tx.error || new Error('Не удалось очистить IndexedDB'));\\n        tx.onabort = () => reject(tx.error || new Error('Очистка IndexedDB прервана'));\\n      });\\n      const counts = {};\\n      await new Promise((resolve, reject) => {\\n        const tx = db.transaction(names, 'readonly');\\n        names.forEach(name => {\\n          const req = tx.objectStore(name).count();\\n          req.onsuccess = () => { counts[name] = Number(req.result || 0); };\\n        });\\n        tx.oncomplete = resolve;\\n        tx.onerror = () => reject(tx.error || new Error('Не удалось проверить IndexedDB'));\\n        tx.onabort = () => reject(tx.error || new Error('Проверка IndexedDB прервана'));\\n      });\\n      const uncleared = names.filter(name => counts[name] !== 0);\\n      if (uncleared.length) throw new Error('В IndexedDB остались записи: ' + uncleared.join(', '));\\n      return true;\\n    }\\n\\n    async function getHandle() {\\n      try {\\n        const db = await dbPromise;\\n        return new Promise((resolve) => {\\n          const tx = db.transaction('handles', 'readonly');\\n          const req = tx.objectStore('handles').get('autoSaveFileHandle');\\n          req.onsuccess = () => resolve(req.result);\\n          req.onerror = () => resolve(null);\\n        });\\n      } catch (e) { return null; }\\n    }\\n    async function saveBackupDirHandle(handle) {\\n      try {\\n        const db = await dbPromise;\\n        return new Promise((resolve, reject) => {\\n          const tx = db.transaction('handles', 'readwrite');\\n          tx.objectStore('handles').put(handle, 'autoBackupDirHandle');\\n          tx.oncomplete = () => resolve(true);\\n          tx.onerror = () => reject(tx.error || new Error('Не удалось запомнить папку автокопий'));\\n          tx.onabort = () => reject(tx.error || new Error('Сохранение папки автокопий прервано'));\\n        });\\n      } catch (e) { console.warn('IDB save error', e); throw e; }\\n    }\\n\\n    async function getBackupDirHandle() {\\n      try { const db = await dbPromise; return new Promise((resolve) => { const tx = db.transaction('handles', 'readonly'); const req = tx.objectStore('handles').get('autoBackupDirHandle'); req.onsuccess = () => resolve(req.result); req.onerror = () => resolve(null); }); } catch (e) { return null; }\\n    }\\n    // === Недавние файлы (B4): локальный список хэндлов в IndexedDB (store 'handles', ключ 'recentFiles').\\n    // Хэндлы не сериализуются в JSON, поэтому список НЕ часть файла проекта и не попадает в снимки/шеринг.\\n    const RECENT_FILES_MAX = 5;\\n    async function _getRecentFiles() {\\n      try { const db = await dbPromise; return await new Promise((resolve) => { const tx = db.transaction('handles', 'readonly'); const req = tx.objectStore('handles').get('recentFiles'); req.onsuccess = () => resolve(Array.isArray(req.result) ? req.result : []); req.onerror = () => resolve([]); }); } catch (e) { return []; }\\n    }\\n    async function _setRecentFiles(list) {\\n      try { const db = await dbPromise; await new Promise((resolve) => { const tx = db.transaction('handles', 'readwrite'); tx.objectStore('handles').put(list, 'recentFiles'); tx.oncomplete = resolve; tx.onerror = () => resolve(); }); } catch (e) {}\\n    }\\n    async function rememberRecentFile(handle) {\\n      try {\\n        if (!handle || !handle.name) return;\\n        let list = await _getRecentFiles();\\n        const _kept = [];\\n        for (const r of list) {\\n          if (!r) continue;\\n          let _same = false;\\n          if (r.handle && typeof r.handle.isSameEntry === 'function') {\\n            try { _same = await r.handle.isSameEntry(handle); } catch (e) { _same = (r.name === handle.name); }\\n          } else {\\n            _same = (r.name === handle.name); // нет ручки/метода , падаем на сравнение по имени\\n          }\\n          if (!_same) _kept.push(r);\\n        }\\n        list = _kept; // дедуп по тому же файлу, а не просто по имени; свежая запись встает первой\\n        list.unshift({ handle: handle, name: handle.name, at: Date.now() });\\n        if (list.length > RECENT_FILES_MAX) list = list.slice(0, RECENT_FILES_MAX);\\n        await _setRecentFiles(list);\\n      } catch (e) {}\\n    }\\n    function _recentRelDate(at) {\\n      try {\\n        const d = new Date(at), now = new Date();\\n        if (isNaN(d)) return '';\\n        const a = new Date(d.getFullYear(), d.getMonth(), d.getDate());\\n        const b = new Date(now.getFullYear(), now.getMonth(), now.getDate());\\n        const days = Math.round((b - a) / 86400000);\\n        if (days <= 0) return 'сегодня';\\n        if (days === 1) return 'вчера';\\n        return days + ' дн. назад';\\n      } catch (e) { return ''; }\\n    }\\n    async function renderStartupRecents() {\\n      const box = document.getElementById('startupRecents'); if (!box) return;\\n      const demo = (typeof DEMO_MODE !== 'undefined' && DEMO_MODE);\\n      if (READ_ONLY_MODE || demo || !('showOpenFilePicker' in window)) { box.classList.add('hidden'); box.innerHTML = ''; return; }\\n      const list = await _getRecentFiles();\\n      if (!list.length) { box.classList.add('hidden'); box.innerHTML = ''; return; }\\n      box.innerHTML = '<p class=\\\"text-[10px] font-medium text-slate-500 uppercase tracking-wider mb-2\\\">Недавние файлы</p>'\\n        + '<div class=\\\"flex flex-col gap-1.5\\\">' + list.slice(0, 5).map((r, i) =>\\n          `<button type=\\\"button\\\" onclick=\\\"openRecentFile(${i})\\\" class=\\\"w-full flex items-center justify-between gap-2 bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-xl px-3 py-2 text-left transition-all cursor-pointer\\\" title=\\\"Открыть файл и продолжить работу с ним\\\">\\n            <span class=\\\"flex items-center gap-2 min-w-0\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-4 h-4 text-slate-400 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-245cc4dee9e7\\\"></use></svg><span class=\\\"text-xs font-medium text-slate-700 truncate\\\">${escHtml(r && r.name || '')}</span></span>\\n            <span class=\\\"text-[10px] text-slate-500 shrink-0\\\">${escHtml(_recentRelDate(r && r.at))}</span>\\n          </button>`).join('') + '</div>';\\n      box.classList.remove('hidden');\\n    }\\n    async function _dropRecentFile(idx) {\\n      try { const list = await _getRecentFiles(); list.spli