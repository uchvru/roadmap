eline' && typeof openBaselineModal === 'function') openBaselineModal();\\n      else if (action === 'versions' && typeof openVersionsModal === 'function') openVersionsModal();\\n      else if (action === 'share') openShareCenter();\\n    }\\n\\n    // ===== v13.6: bounded project action journal =====\\n    function openProjectJournal() { openPlanHistory('journal'); }\\n    function closeProjectJournal() { closeVersionsModal(); }\\n    function _auditActionName(a) { return ({ task_create:'Создание', task_update:'Изменение', task_delete:'Удаление', archive:'Архив', import:'Импорт', restore:'Восстановление', bulk:'Массовая операция', snapshot:'Снимок', project_reset:'Новый проект', undo:'Отмена', redo:'Повтор', archive_update:'Изменение в архиве', archive_delete:'Удаление из архива' })[a] || a; }\\n    function renderProjectJournal() {\\n      const box = document.getElementById('projectJournalList'); if (!box) return;\\n      const action = ((document.getElementById('projectJournalAction') || {}).value || 'all');\\n      const q = String(((document.getElementById('projectJournalSearch') || {}).value || '')).trim().toLowerCase();\\n      const rows = (projectAuditLog || []).slice().reverse().filter(x => (action === 'all' || x.action === action) && (!q || (x.message + ' ' + x.by + ' ' + x.action).toLowerCase().includes(q)));\\n      const c = document.getElementById('projectJournalCount'); if (c) c.textContent = rows.length + ' из ' + (projectAuditLog || []).length;\\n      if (!rows.length) { box.innerHTML = '<div class=\\\"rm-panel p-8 text-center text-sm text-slate-500\\\">Записей по выбранному фильтру нет.</div>'; return; }\\n      box.innerHTML = rows.map(x => { let dt = x.at; try { dt = new Date(x.at).toLocaleString('ru-RU', { dateStyle:'short', timeStyle:'short' }); } catch (e) {} return `<article class=\\\"rm-panel p-3\\\"><div class=\\\"flex items-center gap-2 flex-wrap\\\"><span class=\\\"px-2 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-[10px] font-bold\\\">${escHtml(_auditActionName(x.action))}</span><span class=\\\"text-[10px] text-slate-400\\\">${escHtml(dt)}</span><span class=\\\"text-[10px] text-slate-500\\\">${escHtml(x.by || '')}</span></div><div class=\\\"text-sm text-slate-700 mt-2\\\">${escHtml(x.message || '')}</div></article>`; }).join('');\\n    }\\n    function exportProjectJournal() {\\n      const payload = { app:'roadmap-project-journal', version:1, exportedAt:new Date().toISOString(), project:roadmapTitleText, entries:(projectAuditLog || []).slice() };\\n      const blob = new Blob([JSON.stringify(payload, null, 2)], { type:'application/json;charset=utf-8' }), url = URL.createObjectURL(blob), a = document.createElement('a');\\n      a.href = url; a.download = 'roadmap_journal_' + new Date().toISOString().slice(0, 10) + '.json'; document.body.appendChild(a); a.click(); setTimeout(() => { try { a.remove(); } catch (e) {} URL.revokeObjectURL(url); }, 0);\\n    }\\n    function clearProjectJournal() {\\n      if (typeof READ_ONLY_MODE !== 'undefined' && READ_ONLY_MODE) return;\\n      const run = () => { projectAuditLog = []; storage.set('gantt_project_audit_log', '[]'); renderProjectJournal(); if (typeof showToast === 'function') showToast('Журнал очищен', 'ok'); };\\n      if (typeof openConfirm === 'function') openConfirm({ title:'Очистить журнал действий', desc:'Будут удалены только записи журнала. Задачи и другие данные проекта не изменятся.', danger:true, okText:'Очистить', onOk:run }); else run();\\n    }\\n    // ---------------------------------\\n\\n    let _portableSession = null;\\n    let _portableOpening = false;\\n    let _portableCurrentMessage = '';\\n    function _portableStatus(message, kind) {\\n      _portableCurrentMessage = String(message || '');\\n      const node = document.getElementById('portableSaveMessage');\\n      if (node) { node.textContent = _portableCurrentMessage; node.dataset.error = String(kind === 'error'); }\\n      const receipt=document.getElementById('downloadReceipt');\\n      const coveredByReceipt=receipt&&!receipt.hidden&&String(message).startsWith('Скачивание рабочего HTML началось.');\\n      if (!coveredByReceipt && typeof showToast === 'function') showToast(message, kind || 'info', kind === 'error' ? 9000 : 6500);\\n    }\\n    function _portableRenderState(state) {\\n      const panel = document.getElementById('portableSavePanel');\\n      const portableActive = state.ready && !DEMO_MODE && !READ_ONLY_MODE && !LEARNING_SCENARIO;\\n      if (panel) panel.classList.toggle('hidden', !portableActive);\\n      const legacySave = document.getElementById('legacySaveNowBtn');\\n      const dirtyStatus = document.getElementById('unsavedFileStatus');\\n      const dirtyLabel = document.getElementById('unsavedFileLabel');\\n      if (dirtyStatus) { dirtyStatus.dataset.active=String(!!portableActive); dirtyStatus.dataset.dirty = String(!!(portableActive && state.dirty)); }\\n      if (dirtyLabel) dirtyLabel.textContent = portableActive && state.dirty ? 'Правки не в файле' : '';\\n      if (legacySave) legacySave.classList.toggle('hidden', !!portableActive);\\n      const protection = document.getElementById('portableProtectionNote');\\n      if (protection && window.__roadmapPinSession?.protected) protection.textContent = 'Рабочий HTML и браузерный черновик зашифрованы вашим PIN. История хранится в памяти вкладки и включается в сохранение. Отдельные выгрузки JSON, CSV и отчеты не защищены этим PIN. Не публикуйте личный файл в открытом доступе.';\\n      document.querySelectorAll('[data-portable-save]').forEach(button => { button.disabled = state.saving || !state.ready; });\\n      const status = document.getElementById('portableSaveState');\\n      if (status) {\\n        status.textContent = state.saving ? 'Записываем и проверяем файл...' : state.message;\\n        status.dataset.error = String(!!state.draftError);\\n      }\\n      const operation = document.getElementById('portableSaveMessage');\\n      if (operation) operation.classList.toggle('hidden', !operation.textContent || operation.textContent === state.message || state.saving || (state.dirty && operation.dataset.error !== 'true'));\\n      const badge = document.getElementById('autoSaveBtn');\\n      if (badge && state.ready && !DEMO_MODE && !READ_ONLY_MODE) {\\n        badge.setAttribute('onclick', 'saveWorkingHtml()');\\n        badge.setAttribute('aria-label', 'Сохранить рабочий файл');\\n        const label = state.dirty ? 'Есть несохраненные изменения: сохранить рабочий файл' : 'Сохранить рабочий файл для переноса';\\n        if (badge.hasAttribute('data-tip')) badge.setAttribute('data-tip', label); else badge.title = label;\\n        const dot = document.getElementById('autoSaveDot');\\n        if (dot) { dot.classList.toggle('hidden', !!dirtyStatus || !state.dirty); dot.classList.remove('bg-emerald-500'); dot.classList.add('bg-amber-500'); }\\n      }\\n    }\\n    function _portableChooseDraft(info) {\\n      return new Promise(resolve => {\\n        const previousFocus = document.activeElement;\\n        const modal = document.createElement('div');\\n        modal.id = 'portableChoiceModal';\\n        modal.className = 'fixed inset-0 bg-slate-900/50 flex items-center justify-center p-4';\\n        modal.style.zIndex = '1200';\\n        modal.setAttribute('role', 'dialog'); modal.setAttribute('aria-modal', 'true');\\n        modal.setAttribute('aria-labelledby', 'portableChoiceTitle');\\n        modal.innerHTML = '<div class=\\\"bg-white rounded-2xl w-full max-w-lg p-6 overflow-y-auto max-h-[90vh]\\\">'\\n          + '<h2 id=\\\"portableChoiceTitle\\\" class=\\\"text-lg font-semibold text-slate-800\\\">Какие данные открыть?</h2>'\\n          + '<p class=\\\"mt-2 text-sm text-slate-600\\\">В этом браузере есть правки, отличающиеся от HTML. Выберите копию. Остальные варианты не удаляются и не объединяются автоматически.</p>'\\n          + '<div id=\\\"portableChoices\\\" class=\\\"mt-4 space-y-2\\\"></div>'\\n          + '<p id=\\\"portableInvalidDraft\\\" class=\\\"mt-3 text-sm text-slate-600\\\"></p>'\\n          + '<button type=\\\"button\\\" id=\\\"portableChoiceCancel\\\" class=\\\"mt-4 h-9 px-3 rounded-lg border border-slate-200 text-sm text-slate-700 bg-white\\\">Отменить открытие</button></div>';\\n        function done(choice) {\\n          document.removeEventListener('keydown', keys, true);\\n          modal.remove(); if (typeof syncBodyScrollLock === 'function') syncBodyScrollLock();\\n          if (previousFocus && previousFocus.isConnected) previousFocus.focus();\\n          resolve(choice);\\n        }\\n        const choices = [{key:'file',document:info.file,label:'Данные из HTML'}, ...info.candidates.map((row,i) => ({...row,label:'Черновик браузера ' + (i + 1)}))];\\n        choices.forEach(row => {\\n          const button = document.createElement('button');\\n          button.type = 'button'; button.className = 'w-full text-left p-3 rounded-lg border border-slate-200 bg-white text-sm text-slate-800';\\n          button.dataset.portableChoice = row.key;\\n          button.textContent = row.label + ' · ' + _fmtVersionDate(row.document.savedAt) + ' · задач: ' + row.document.snapshot.roadmapData.length;\\n          button.onclick = () => done(row.key);\\n          modal.querySelector('#portableChoices').appendChild(button);\\n        });\\n        if (info.invalid) modal.querySelector('#portableInvalidDraft').textContent = 'Поврежденных черновиков: ' + info.invalid + '. Они не применены и не удалены.';\\n        modal.querySelector('#portableChoiceCancel').onclick = () => done(null);\\n        function keys(event) {\\n          if (event.key === 'Escape') { event.preventDefault(); event.stopImmediatePropagation(); done(null); }\\n          if (event.key === 'Tab') {\\n            const buttons = Array.from(modal.querySelectorAll('button'));\\n            const i = buttons.indexOf(document.activeElement);\\n            if (event.shiftKey && i <= 0) { event.preventDefault(); buttons.at(-1).focus(); }\\n            else if (!event.shiftKey && i === buttons.length - 1) { event.preventDefault(); buttons[0].focus(); }\\n          }\\n        }\\n        document.body.appendChild(modal); document.addEventListener('keydown', keys, true);\\n        if (typeof syncBodyScrollLock === 'function') syncBodyScrollLock();\\n        modal.querySelector('button').focus();\\n      });\\n    }\\n    async function _portableHistory(projectId) {\\n      const db = await dbPromise;\\n      const records = await new Promise((resolve, reject) => {\\n        const tx = db.transaction('versions', 'readonly'), request = tx.objectStore('versions').getAll();\\n        let value;\\n        request.onsuccess = () => { value = request.result || []; };\\n        tx.oncomplete = () => resolve(value || []);\\n        tx.onerror = () => reject(tx.error || new Error('История версий недоступна.'));\\n        tx.onabort = () => reject(tx.error || new Error('Чтение истории прервано.'));\\n      });\\n      return _jsonStorage.scopeVersionRecords(records, projectId, true).selected;\\n    }\\n    async function _portableApplyDocument(packet) {\\n      const validated = normalizeRoadmapSnapshot(packet.snapshot);\\n      if (!validated) throw new Error('План внутри HTML не поддерживается этой версией приложения.');\\n      let db = await dbPromise;\\n      const existing = await _portableHistory(packet.projectId);\\n      const historySignature = rows => RoadmapModules.portableCanonicalJson(JSON.parse(JSON.stringify([...rows].sort((a,b) => String(a.id).localeCompare(String(b.id))))));\\n      let byId = new Map(existing.map(row => [row.id, row]));\\n      if (existing.length && historySignature(existing) !== historySignature(packet.history.records)) {\\n        // Выбор файла или черновика включает ровно его историю. Старую базу\\n        // не очищаем и не объединяем с выбранной копией: открываем отдельную.\\n        const previousDb = db;\\n        db = await _openRoadmapDatabase('RoadmapPortableDB:' + packet.documentId + ':' + crypto.randomUUID());\\n        dbPromise = Promise.resolve(db);\\n        previousDb.close();\\n        byId = new Map();\\n      }\\n      await new Promise((resolve, reject) => {\\n        const tx = db.transaction('versions', 'readwrite'), store = tx.objectStore('versions');\\n        packet.history.records.forEach(row => { if (!byId.has(row.id)) store.put(row); });\\n        tx.oncomplete = resolve;\\n        tx.onerror = () => reject(tx.error || new Error('Не удалось перенести историю из HTML.'));\\n        tx.onabort = () => reject(tx.error || new Error('Перенос истории прерван.'));\\n      });\\n      ++_projectTransitionToken;\\n      // Инициализация пустой оболочки не изменяет импортированные даты и задачи.\\n      roadmapData = []; archivedTasks = []; planSections = []; initApp();\\n      _applyRoadmapSnapshotState(packet.snapshot, {projectIdMode:'adopt'});\\n      _persistProjectStateNow(); _refreshAfterSnapshotApply();\\n      await _refreshFileVersions();\\n      applyTimelinePreset('currentWeek');\\n    }\\n    async function _portableInitialize() {\\n      // Защищенные и прочие экспортированные копии имеют собственный\\n      // изолированный bootstrap и прежний контракт сохранения.\\n      if (READ_ONLY_MODE || DEMO_ON_LOAD || LEARNING_SCENARIO || window.__EMBEDDED_VIEW__) return false;\\n      const boot = window.__roadmapPortableBoot;\\n      _portableOpening = true;\\n      try {\\n        _portableSession = await RoadmapModules.createPortableAppRuntime({\\n          template:window.__roadmapCleanTemplate,\\n          appVersion:APP_VERSION, appDate:APP_VERSION_DATE.split('.').reverse().join('-'),\\n          draftStorage:boot ? boot.nativeStorage : null,\\n          encodeHtml:window.__roadmapPinSession?.encodeHtml,\\n          decodeHtml:window.__roadmapPinSession?.decodeHtml,\\n          encodeDraft:window.__roadmapPinSession?.encodeDraft,\\n          decodeDraft:window.__roadm