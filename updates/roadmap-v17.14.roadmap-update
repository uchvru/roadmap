; }\\n      const dayList = [];\\n      for (let i = 0; i < days; i++) dayList.push(new Date(minD.getTime() + i * MS));\\n      const cellW = 16;\\n      const months = ['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];\\n      const loadColor = n => n <= 0 ? 'bg-slate-100' : n === 1 ? 'bg-emerald-400' : n === 2 ? 'bg-amber-400' : 'bg-rose-500';\\n      let headCells = '';\\n      dayList.forEach((d, i) => {\\n        const wkStart = i === 0 || d.getDay() === 1;\\n        headCells += `<div class=\\\"shrink-0 text-[10px] leading-none text-slate-500 whitespace-nowrap\\\" style=\\\"width:${cellW}px\\\">${(wkStart || d.getDate() === 1) ? (d.getDate() + ' ' + months[d.getMonth()]) : ''}</div>`;\\n      });\\n      let rows = '';\\n      shownPeople.forEach(p => {\\n        const tasks = byPerson[p].filter(t => !t.isMilestone && t.start && t.end);\\n        let cells = '';\\n        dayList.forEach(d => {\\n          let cnt = 0;\\n          tasks.forEach(t => { const s = parseLocalDate(t.start), e = parseLocalDate(t.end); if (s && e && s <= d && d <= e) cnt++; });\\n          cells += `<div class=\\\"shrink-0 h-5 border-r border-b border-white/70 flex items-center justify-center ${loadColor(cnt)}\\\" style=\\\"width:${cellW}px\\\" title=\\\"${escAttr(p)}, ${escAttr(formatDateString(toYmdLocal(d)))}: ${cnt} ${pluralRu(cnt, ['задача', 'задачи', 'задач'])}\\\">${cnt >= 2 ? `<span class=\\\"text-[10px] font-bold ${cnt === 2 ? 'text-slate-900' : 'text-white'} leading-none\\\">${cnt}</span>` : ''}</div>`;\\n        });\\n        rows += `<div class=\\\"flex items-center mb-0.5\\\"><div class=\\\"sticky left-0 z-20 bg-slate-50 shrink-0 w-28 pr-2 border-r border-slate-200 text-[10px] text-slate-700 truncate shadow-[2px_0_4px_-2px_rgba(15,23,42,0.18)]\\\" title=\\\"${escAttr(p)}\\\">${escHtml(p)}</div><div class=\\\"flex\\\">${cells}</div></div>`;\\n      });\\n      const innerW = dayList.length * cellW + 112;\\n      return `<div class=\\\"mb-3 p-3 bg-slate-50 rounded-xl border border-slate-100\\\">\\n        <div class=\\\"flex items-center justify-between mb-2 gap-2 flex-wrap\\\">\\n          <div><div class=\\\"text-[10px] font-semibold text-slate-500 uppercase tracking-wider\\\">Выравнивание загрузки: активных задач в день</div><p class=\\\"text-xs text-slate-500 mt-1\\\">${truncated?'Показаны первые 220 дней: ':'Период: '}${escHtml(formatDateString(toYmdLocal(minD)))} — ${escHtml(formatDateString(toYmdLocal(maxD)))}</p></div>\\n          <div class=\\\"flex items-center gap-2 text-[10px] text-slate-500\\\"><span class=\\\"inline-flex items-center gap-1\\\"><span class=\\\"w-2.5 h-2.5 bg-slate-100 border border-slate-200\\\"></span>0</span><span class=\\\"inline-flex items-center gap-1\\\"><span class=\\\"w-2.5 h-2.5 bg-emerald-400\\\"></span>1</span><span class=\\\"inline-flex items-center gap-1\\\"><span class=\\\"w-2.5 h-2.5 bg-amber-400\\\"></span>2</span><span class=\\\"inline-flex items-center gap-1\\\"><span class=\\\"w-2.5 h-2.5 bg-rose-500\\\"></span>3 и больше</span></div>\\n        </div>\\n        <div class=\\\"flex items-center gap-1 flex-wrap mb-2\\\" role=\\\"group\\\" aria-label=\\\"Кого показать на карте загрузки\\\">\\n          <span class=\\\"text-[10px] text-slate-500 mr-0.5 shrink-0\\\">Показать:</span>\\n          <button type=\\\"button\\\" aria-pressed=\\\"${heatmapPeopleSel.size === 0}\\\" onclick=\\\"setHeatmapAllPeople()\\\" class=\\\"px-2 py-0.5 rounded-md text-[10px] ${heatmapPeopleSel.size === 0 ? 'bg-indigo-600 text-white' : 'bg-white border border-slate-200 text-slate-500 hover:bg-slate-100'} cursor-pointer transition-colors\\\">Все</button>\\n          ${allPeople.map(p => `<button type=\\\"button\\\" aria-pressed=\\\"${heatmapPeopleSel.has(p)}\\\" data-hp=\\\"${escAttr(p)}\\\" class=\\\"px-2 py-0.5 rounded-md text-[10px] ${heatmapPeopleSel.has(p) ? 'bg-indigo-600 text-white' : 'bg-white border border-slate-200 text-slate-500 hover:bg-slate-100'} cursor-pointer transition-colors\\\" title=\\\"${escAttr(p)}\\\">${escHtml(p)}</button>`).join('')}\\n        </div>\\n        <div class=\\\"overflow-x-auto pb-1\\\">\\n          <div style=\\\"min-width:${innerW}px\\\">\\n            <div class=\\\"flex items-end mb-1\\\"><div class=\\\"sticky left-0 z-30 bg-slate-50 shrink-0 w-28 border-r border-slate-200 shadow-[2px_0_4px_-2px_rgba(15,23,42,0.18)]\\\"></div><div class=\\\"flex\\\">${headCells}</div></div>\\n            ${rows}\\n          </div>\\n        </div>\\n        <div class=\\\"mt-2 flex items-center gap-2 flex-wrap\\\">\\n          <button type=\\\"button\\\" onclick=\\\"showLevelingSuggestions()\\\" class=\\\"inline-flex items-center gap-1 px-2 py-1 rounded-md bg-slate-100 text-slate-700 hover:bg-slate-200 text-[10px] font-semibold cursor-pointer transition-colors\\\" title=\\\"Выстроить задачи исполнителя в очередь: одна в работе, остальные подряд по оценке\\\">Выровнять загрузку</button>\\n          <span class=\\\"text-[10px] text-slate-500\\\">одна задача в работе, остальные — в очередь по оценке (рабочие дни)</span>\\n        </div>\\n        <div id=\\\"levelingSuggestions\\\" class=\\\"mt-2\\\"></div>\\n      </div>`;\\n    }\\n    // Очередь по исполнителю: задача «в работе» , якорь (идет первой, старт не двигаем), остальные встают\\n    // в очередь друг за другом. Длительность каждой , по ОЦЕНКЕ в рабочих днях (производственный календарь),\\n    // а если оценки нет , по текущему размаху дат. Очередь не уезжает в прошлое (минимум , сегодня).\\n    function computeLevelingSuggestions() {\\n      const byPerson = _activeTasksByPerson();\\n      const sugg = [];\\n      const seen = new Set();\\n      const _todayYmd = (typeof CURRENT_DATE !== 'undefined' && CURRENT_DATE) ? toYmdLocal(CURRENT_DATE) : null;\\n      const _todayDays = _todayYmd ? dateToDays(_todayYmd) : -Infinity;\\n      Object.keys(byPerson).forEach(person => {\\n        const arr = byPerson[person].filter(t => !t.isMilestone && t.start && t.end\\n            && Number.isFinite(dateToDays(t.start)) && Number.isFinite(dateToDays(t.end)))\\n          .sort((a, b) => {\\n            const ai = getStatusGroup(a.status) === 'in_progress' ? 0 : 1, bi = getStatusGroup(b.status) === 'in_progress' ? 0 : 1;\\n            if (ai !== bi) return ai - bi;\\n            return dateToDays(a.start) - dateToDays(b.start) || dateToDays(a.end) - dateToDays(b.end);\\n          });\\n        let freeFrom = -Infinity; // календарный индекс, раньше которого следующая задача начаться не может\\n        arr.forEach(t => {\\n          const estD = (typeof parseEstimateDays === 'function') ? parseEstimateDays(t.estimate) : null;\\n          const anchor = getStatusGroup(t.status) === 'in_progress';\\n          let s = dateToDays(t.start), startYmd = t.start;\\n          if (anchor) {\\n            freeFrom = Math.max(freeFrom, dateToDays(_spSpan(daysToDate(dateToDays(t.end) + 1), 1, person).start));\\n            return;\\n          }\\n          s = Math.max(s, freeFrom, _todayDays);\\n          const span = _spSpan(daysToDate(s), estD > 0 ? Math.ceil(estD) : 1, person);\\n          startYmd = span.start;\\n          s = dateToDays(startYmd);\\n          // Без оценки сохраняется календарная длительность; окончание не ставится в отпуск.\\n          const endYmd = estD > 0 ? span.end : _spSpan(daysToDate(s + Math.max(0, dateToDays(t.end) - dateToDays(t.start))), 1, person).start;\\n          freeFrom = dateToDays(_spSpan(daysToDate(dateToDays(endYmd) + 1), 1, person).start);\\n          if ((startYmd !== t.start || endYmd !== t.end) && !seen.has(t.id)) {\\n            seen.add(t.id);\\n            sugg.push({ id: t.id, person, name: t.name, fromStart: t.start, fromEnd: t.end, toStart: startYmd, toEnd: endYmd, shiftDays: s - dateToDays(t.start) });\\n          }\\n        });\\n      });\\n      return sugg;\\n    }\\n    function showLevelingSuggestions() {\\n      const el = document.getElementById('levelingSuggestions'); if (!el) return;\\n      const sugg = computeLevelingSuggestions();\\n      if (!sugg.length) { el.innerHTML = '<p class=\\\"text-xs text-slate-600\\\">Новых переносов не предложено. Это не гарантирует отсутствие перегрузки.</p>'; return; }\\n      const rows = sugg.map((s, index) => `<div class=\\\"leveling-proposal border-b border-slate-200\\\">\\n        <span class=\\\"text-slate-800\\\"><b>${escHtml(s.name)}</b><br>${escHtml(s.person)}</span>\\n        <span class=\\\"text-slate-600\\\">${escHtml(s.fromStart)} / ${escHtml(s.fromEnd)} → ${escHtml(s.toStart)} / ${escHtml(s.toEnd)}</span>\\n        <button type=\\\"button\\\" data-leveling-index=\\\"${index}\\\" class=\\\"px-3 py-1 rounded-lg bg-indigo-600 text-white\\\" aria-label=\\\"Проверить перенос задачи ${escAttr(s.name)}\\\">Проверить</button>\\n      </div>`).join('');\\n      el.innerHTML = `<div class=\\\"p-3 bg-white rounded-xl border border-slate-200\\\">\\n        <div class=\\\"flex items-center justify-between gap-2 flex-wrap\\\"><b class=\\\"text-xs text-slate-700\\\">Предложено переносов: ${sugg.length}</b>\\n        <button type=\\\"button\\\" onclick=\\\"applyAllLeveling()\\\" class=\\\"px-3 py-2 rounded-lg bg-indigo-600 text-white text-xs\\\">Проверить все</button></div>\\n        ${rows}<p class=\\\"text-xs text-slate-600 mt-2\\\">Сначала покажем итоговые даты, зависимые задачи и риски. До подтверждения план не изменится.</p></div>`;\\n      el.querySelectorAll('[data-leveling-index]').forEach(button => button.addEventListener('click', () => {\\n        const s = sugg[Number(button.dataset.levelingIndex)];\\n        applyLevelingSuggestion(s.id, s.toStart, s.toEnd);\\n      }));\\n    }\\n    let _schedulePreview = null;\\n    function _schedulePreviewCheckpoints() {\\n      const points = [], releases = _releaseProgressAgg(roadmapData, customCutoffs);\\n      releases.rels.forEach(name => {\\n        if (releases.relDate[name]) points.push({ name: 'Релиз ' + name, date: releases.relDate[name], taskIds: roadmapData.filter(t => !t.hidden && String(t.release || '').trim() === name).map(t => t.id) });\\n      });\\n      (customCutoffs || []).forEach(c => {\\n        if (!c || !c.date) return;\\n        const legacy = String(c.id || '').match(/^task-deadline-(.+)$/);\\n        const linked = c.linkedTaskId != null ? c.linkedTaskId : legacy ? legacy[1] : null;\\n        const releaseName = String(c.name || '').replace(/^Релиз\\\\s+/i, '').trim();\\n        if (linked == null && releases.rels.includes(releaseName)) return;\\n        points.push({ name: c.name || 'Контрольная дата', date: c.date, taskIds: linked == null ? [] : [linked] });\\n      });\\n      roadmapData.forEach(t => {\\n        if (t.hidden) return;\\n        if (t.isMilestone && t.start) points.push({ name: 'Веха: ' + (t.name || 'Без названия'), date: t.start, taskIds: [t.id] });\\n        if (t.deadline) points.push({ name: 'Срок задачи: ' + (t.name || 'Без названия'), date: t.deadline, taskIds: [t.id] });\\n      });\\n      return points;\\n    }\\n    function _schedulePreviewSignature() {\\n      return _jsonStorage.snapshotContentSignature(buildRoadmapSnapshot(false));\\n    }\\n    function openSchedulePreview(proposals, title, options) {\\n      if (READ_ONLY_MODE || !requireUnlocked() || !proposals.length) return;\\n      const cascadeEnabled = options && options.cascade === false ? false : featureOn('deps');\\n      const model = RoadmapModules.createSchedulePreview({ tasks: roadmapData, proposals, checkpoints: _schedulePreviewCheckpoints(),\\n        today: toYmdLocal(CURRENT_DATE), cascadeEnabled, statusGroup: getStatusGroup });\\n      const signature = _schedulePreviewSignature();\\n      const dates = (start, end) => escHtml(start === end ? start : start + ' / ' + end);\\n      const changes = model.changes.map(row => `<li class=\\\"schedule-preview-row bg-white text-slate-700\\\">\\n        <b class=\\\"text-slate-800\\\">${escHtml(row.name)}</b><div>${row.cause === 'direct' ? 'Выбран