ендаря.','ok');\\n    }\\n    function closeCalendarExport(){_calendarPlan=null;_calendarEvents=[];_closeCandidateDialog('calendarExportModal');}\\n    function openJiraDifferences() {\\n      if (featureFlags.jira === false) return;\\n      closeDataMenu();\\n      _openCandidateDialog('jiraDifferencesModal','Отличается от Jira',\\n        '<p>Сравнение с последним импортом, не с текущим состоянием Jira. Активный план, без архива; фильтры списка не применяются. Просмотр ничего не отправляет и не меняет.</p>'\\n        +'<p>Поля: статус, начало, окончание, исполнитель, Story Points. Остальные поля, в том числе спринт, здесь не сравниваются.</p>'\\n        +'<label class=\\\"overview-search\\\">Найти задачу<input id=\\\"jiraDifferenceSearch\\\" type=\\\"search\\\" placeholder=\\\"Название, ключ или исполнитель\\\" oninput=\\\"renderJiraDifferences()\\\"></label>'\\n        +'<label class=\\\"overview-check\\\"><input id=\\\"jiraDifferenceHidden\\\" type=\\\"checkbox\\\" onchange=\\\"renderJiraDifferences()\\\">Включить скрытые задачи</label>'\\n        +'<p id=\\\"jiraDifferenceCount\\\" role=\\\"status\\\" aria-live=\\\"polite\\\" tabindex=\\\"-1\\\"></p><div id=\\\"jiraDifferenceList\\\" class=\\\"overview-list\\\"></div>', 'closeJiraDifferences');\\n      renderJiraDifferences();\\n    }\\n    function closeJiraDifferences(){_closeCandidateDialog('jiraDifferencesModal');}\\n    function _overviewTaskButton(task, origin, caption) {\\n      return RoadmapModules.renderReportTaskCards('overview', [{id:task.id,name:task.name || 'Без названия',meta:[task.jira,caption].filter(Boolean).join(' · ')}], {origin}, {escHtml,escAttr});\\n    }\\n    function openOverviewTask(button) {\\n      const task=(roadmapData || []).find(t=>String(t.id)===button.dataset.overviewTask);\\n      if(!task){showToast('Задача больше не находится в активном плане','info');return;}\\n      if(button.dataset.overviewOrigin==='jira')closeJiraDifferences();else closePlanDigest();\\n      openModal