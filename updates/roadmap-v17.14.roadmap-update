   if (menu.parentElement !== document.body) document.body.appendChild(menu);\\n        renderPresetMenu();\\n        if (typeof normalizeUiChrome === 'function') normalizeUiChrome(menu);\\n        menu.classList.remove('hidden');\\n        positionFilterPopover(menu, btn);\\n        if (e && e.detail === 0) menu.querySelector('button')?.focus({preventScroll:true});\\n      }\\n      if (btn) btn.setAttribute('aria-expanded', !menu.classList.contains('hidden') ? 'true' : 'false');\\n    }\\n    function closePresetMenu() { const m = document.getElementById('presetMenu'); if (m) m.classList.add('hidden'); const button = document.getElementById('presetBtn'); if (button) button.setAttribute('aria-expanded', 'false'); }\\n    // Меню сортировки (иконка вместо текстового select)\\n    function renderSortMenu() {\\n      const m = document.getElementById('sortMenu'); if (!m) return;\\n      const opts = [['date', 'По дате'], ['cascade', 'По дате старта (каскадом)'], ['status', 'По статусу'], ['name', 'По названию'], ['resource', 'По исполнителю']];\\n      if (typeof featureOn !== 'function' || featureOn('metrics')) opts.push(['priority', 'По приоритету']);\\n      opts.push(['manual', 'Вручную']);\\n      const cur = (storage.get('gantt_task_sort_mode') || 'date');\\n      m.innerHTML = opts.map(([v, l]) => `<button type=\\\"button\\\" data-sort-option=\\\"${v}\\\" aria-pressed=\\\"${cur === v}\\\" title=\\\"${({date:'По дате старта, сверху самые ранние',cascade:'Лесенкой по датам, полоски слева направо; даты задач не меняются',status:'Сначала в работе и просроченные',name:'По алфавиту',resource:'По исполнителю',priority:'По баллу важности',manual:'Свой порядок, кнопками вверх и вниз'})[v]||''}\\\" onclick=\\\"setTaskSortMode('${v}'); closeSortMenu();\\\" class=\\\"w-full text-left text-xs px-2 py-1.5 rounded-lg ${cur === v ? 'text-indigo-600 font-semibold bg-indigo-50/60' : 'text-slate-700 hover:bg-slate-50'} cursor-pointer\\\">${l}</button>`).join('');\\n      if (typeof featureOn !== 'function' || featureOn('metrics')) {\\n        m.innerHTML += `<div class=\\\"my-1 border-t border-slate-100\\\"></div><button type=\\\"button\\\" data-sort-scores aria-pressed=\\\"${!!_showPriorityScores}\\\" onclick=\\\"setShowPriorityScores(!_showPriorityScores); renderSortMenu();\\\" class=\\\"w-full flex items-center justify-between gap-2 text-xs px-2 py-1.5 rounded-lg text-slate-700 hover:bg-slate-50 cursor-pointer\\\" title=\\\"Показывать балл RICE/ICE/WSJF чипом в строке задачи\\\"><span class=\\\"min-w-0 grow\\\">Баллы в строке</span><span class=\\\"shrink-0 text-[10px] font-semibold ${_showPriorityScores ? 'text-indigo-600' : 'text-slate-400'}\\\">${_showPriorityScores ? 'вкл' : 'выкл'}</span></button>`;\\n      }\\n    }\\n    function toggleSortMenu(e) { if (e) e.stopPropagation(); const m = document.getElementById('sortMenu'); if (!m) return; const willOpen = m.classList.contains('hidden'); closeAllPopovers(); if (willOpen) { renderSortMenu(); m.classList.remove('hidden'); } const button = document.getElementById('sortBtn'); if (button) button.setAttribute('aria-expanded', !m.classList.contains('hidden') ? 'true' : 'false'); }\\n    function closeSortMenu() { const m = document.getElementById('sortMenu'); if (m) m.classList.add('hidden'); const button = document.getElementById('sortBtn'); if (button) button.setAttribute('aria-expanded', 'false'); }\\n    document.addEventListener('click', (e) => { const m = document.getElementById('sortMenu'); if (m && !m.classList.contains('hidden') && !e.target.closest('#sortMenu') && !e.target.closest('#sortBtn')) closeSortMenu(); });\\n\\n    // === Фильтр по метке (Jira Labels) и релизу (отдельное меню, не в строке фильтров) ===\\n    function getAllReleases() {\\n      const set = new Set();\\n      (projectReleases || []).forEach(r => { if (r && r.name) set.add(String(r.name)); });\\n      (roadmapData || []).forEach(t => { if (t && t.release) set.add(String(t.release)); });\\n      (archivedTasks || []).forEach(t => { if (t && t.release) set.add(String(t.release)); });\\n      return [...set].sort((a, b) => a.localeCompare(b, 'ru'));\\n    }\\n    function getAllLabels() {\\n      const labelsByKey = new Map();\\n      const add = arr => {\\n        if (typeof arr === 'string') arr = arr.split(/[;,]+/);\\n        (Array.isArray(arr) ? arr : []).forEach(l => {\\n          const s = String(l || '').trim();\\n          const key = _normFilterText(s);\\n          if (!key) return;\\n          const previous = labelsByKey.get(key);\\n          const hasDisplayCapital = /^[A-ZА-ЯЁ]/.test(s);\\n          const previousHasDisplayCapital = previous && /^[A-ZА-ЯЁ]/.test(previous);\\n          if (!previous || (hasDisplayCapital && !previousHasDisplayCapital)) labelsByKey.set(key, s);\\n        });\\n      };\\n      (roadmapData || []).forEach(t => add(t && t.labels));\\n      (archivedTasks || []).forEach(t => add(t && t.labels));\\n      Object.values(sectionLabels || {}).forEach(add);\\n      return [...labelsByKey.values()].sort((a, b) => a.localeCompare(b, 'ru'));\\n    }\\n    function getAllComponents() {\\n      const set = new Set();\\n      const add = arr => { (Array.isArray(arr) ? arr : (arr ? String(arr).split(/[;,]+/) : [])).forEach(l => { const s = String(l || '').trim(); if (s) set.add(s); }); };\\n      (roadmapData || []).forEach(t => add(t && t.components));\\n      (archivedTasks || []).forEach(t => add(t && t.components));\\n      return [...set].sort((a, b) => a.localeCompare(b, 'ru'));\\n    }\\n    function _normFilterText(value) {\\n      return String(value == null ? '' : value).trim().toLocaleLowerCase('ru');\\n    }\\n    function _filterSetHasNormalized(set, value) {\\n      const key = _normFilterText(value);\\n      if (!key || !set || !set.size) return false;\\n      for (const item of set) if (_normFilterText(item) === key) return true;\\n      return false;\\n    }\\n    function _toggleNormalizedSelection(set, value) {\\n      const key = _normFilterText(value);\\n      if (!key || !set) return;\\n      const matches = [];\\n      for (const item of set) if (_normFilterText(item) === key) matches.push(item);\\n      if (matches.length) matches.forEach(item => set.delete(item));\\n      else set.add(String(value).trim());\\n    }\\n    function _filterRow(kind, name) {\\n      const sel = kind === 'label' ? labelFilterSel : (kind === 'component' ? componentFilterSel : releaseFilterSel);\\n      const on = kind === 'label' ? _filterSetHasNormalized(sel, name) : sel.has(name);\\n      const fn = kind === 'label' ? 'setLabelFilter' : (kind === 'component' ? 'setComponentFilter' : 'setReleaseFilter');\\n      return `<button type=\\\"button\\\" aria-pressed=\\\"${on ? 'true' : 'false'}\\\" onclick=\\\"event.stopPropagation(); ${fn}('${escJsArg(name)}')\\\" class=\\\"rm-filter-option w-full flex items-center gap-2 text-left text-xs px-2 py-1.5 rounded-lg ${on ? 'bg-indigo-50/70 text-indigo-700 font-semibold' : 'text-slate-700'} cursor-pointer\\\">\\n        <span class=\\\"rm-choice-indicator w-4 h-4 rounded border flex items-center justify-center shrink-0 ${on ? 'bg-indigo-600 border-indigo-600' : 'border-slate-300 bg-white'}\\\">${on ? '<svg aria-hidden=\\\"true\\\" class=\\\"w-3 h-3 text-white\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"3.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><use href=\\\"#rm-icon-c06b0722600b\\\"></use></svg>' : ''}</span>\\n        <span class=\\\"truncate grow\\\">${escHtml(name)}</span>\\n      </button>`;\\n    }\\n    function _cfFilterRow(fid, val, label) {\\n      const s = customFieldFilterSel[fid];\\n      const on = !!(s && s.has(val));\\n      return `<button type=\\\"button\\\" aria-pressed=\\\"${on ? 'true' : 'false'}\\\" onclick=\\\"event.stopPropagation(); setCustomFieldFilter('${escJsArg(fid)}','${escJsArg(val)}')\\\" class=\\\"rm-filter-option w-full flex items-center gap-2 text-left text-xs px-2 py-1.5 rounded-lg ${on ? 'bg-indigo-50/70 text-indigo-700 font-semibold' : 'text-slate-700'} cursor-pointer\\\">\\n        <span class=\\\"rm-choice-indicator w-4 h-4 rounded border flex items-center justify-center shrink-0 ${on ? 'bg-indigo-600 border-indigo-600' : 'border-slate-300 bg-white'}\\\">${on ? '<svg aria-hidden=\\\"true\\\" class=\\\"w-3 h-3 text-white\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"3.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><use href=\\\"#rm-icon-c06b0722600b\\\"></use></svg>' : ''}</span>\\n        <span class=\\\"truncate grow\\\">${escHtml(label)}</span>\\n      </button>`;\\n    }\\n    function setCustomFieldFilter(fid, val) {\\n      const s = customFieldFilterSel[fid] || (customFieldFilterSel[fid] = new Set());\\n      if (s.has(val)) s.delete(val); else s.add(val);\\n      if (!s.size) delete customFieldFilterSel[fid];\\n      renderReleaseFilterMenu(); updateReleaseFilterBtn(); renderRoadmap(true);\\n    }\\n    let relFilterQuery = '';\\n    function renderReleaseFilterMenu() {\\n      const m = document.getElementById('releaseFilterMenu'); if (!m) return;\\n      const allLabels = getAllLabels(), allComps = getAllComponents(), allRels = getAllReleases();\\n      const cfDefs = _cfFilterableDefs();\\n      if (!allLabels.length && !allComps.length && !allRels.length && !cfDefs.length) {\\n        m.innerHTML = `<div class=\\\"px-2 py-3 text-xs text-slate-500 text-center leading-relaxed\\\">Меток, компонентов и релизов пока нет.<br>Подтянутся из выгрузки Jira.</div>`;\\n        return;\\n      }\\n      const q = (relFilterQuery || '').trim().toLowerCase();\\n      const flt = arr => q ? arr.filter(x => String(x).toLowerCase().includes(q)) : arr;\\n      const labels = flt(allLabels), comps = flt(allComps), rels = flt(allRels);\\n      const grpHead = (t) => `<div class=\\\"rm-menu-heading px-2 pt-1.5 pb-1 text-xs font-semibold text-slate-500\\\">${t}</div>`;\\n      const sep = '<div class=\\\"rm-filter-group-gap\\\" aria-hidden=\\\"true\\\"></div>';\\n      // Поиск внутри фильтра по меткам/компонентам/релизам (п.)\\n      const relClearBtn = relFilterQuery ? `<button type=\\\"button\\\" onmousedown=\\\"event.preventDefault()\\\" onclick=\\\"event.stopPropagation(); relFilterQuery=''; renderReleaseFilterMenu();\\\" aria-label=\\\"Очистить поиск\\\" class=\\\"rm-search-clear text-slate-400 hover:text-slate-600 cursor-pointer\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-3 h-3\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\"><use href=\\\"#rm-icon-beeec08ce59f\\\"></use></svg></button>` : '';\\n      const search = `<div class=\\\"rm-drawer-search-sticky sticky px-1 pb-1.5\\\"><div class=\\\"rm-search-field\\\"><svg aria-hidden=\\\"true\\\" class=\\\"rm-search-icon\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-1b6c5faa6b02\\\"></use></svg><input id=\\\"relFilterSearch\\\" type=\\\"search\\\" value=\\\"${escAttr(relFilterQuery)}\\\" oninput=\\\"relFilterQuery=this.value; renderReleaseFilterMenu();\\\" onclick=\\\"event.stopPropagation()\\\" placeholder=\\\"Поиск по меткам и релизам\\\" aria-label=\\\"Поиск по меткам, компонентам, релизам\\\" class=\\\"rm-search-input\\\">${relClearBtn}</div></div>`;\\n      let html = '';\\n      if (labels.length) html += grpHead('Метки') + labels.map(n => _filterRow('label', n)).join('');\\n      if (comps.length) html += (html ? sep : '') + grpHead('Компоненты') + comps.map(n => _filterRow('component', n)).join('');\\n      if (rels.length) html += (html ? sep : '') + grpHead('Релизы') + rels.map(n => _filterRow('release', n)).join('');\\n      else if (!q && !allRels.length) html += (html ? sep : '') + grpHead('Релизы') + '<div class=\\\"px-2 py-1.5 text-[10px] text-slate-500 leading-snug\\\">Не найдено в выгрузке. Проверьте колонку Fix Version в CSV.</div>';\\n      // Группы по своим полям (типы «Список» и «Чекбокс»): заголовок = название поля\\n      cfDefs.forEach(d => {\\n        const nameHit = !q || String(d.name).toLowerCase().includes(q);\\n        let rows = [];\\n        if (d.type === 'list') rows = (d.options || []).filter(o => nameHit || String(o).toLowerCase().includes(q)).map(o => _cfFilterRow(d.id, String(o), String(o)));\\n        else rows = [['yes', 'Да'], ['no', 'Нет']].filter(p => nameHit || p[1].toLowerCase().includes(q)).map(p => _cfFilterRow(d.id, p[0], p[1]));\\n        if (rows.length) html += (html ? sep : '') + grpHead(escHtml(d.name)) + rows.join('');\\n      });\\n      if (!html) html = `<div class=\\\"px-2 py-4 text-xs text-slate-500 text-center\\\">Ничего не найдено</div>`;\\n      const total = labelFilterSel.size + releaseFilterSel.size + componentFilterSel.size + _cfFilterCount();\\n      if (total) html += sep + `<button type=\\\"button\\\" onclick=\\\"event.stopPropagation(); clearReleaseFilter()\\\" class=\\\"w-full text-left text-xs px-2 py-1.5 rounded-lg text-rose-600 hover:bg-rose-50 cursor-pointer\\\">Сбросить (${total})</button>`;\\n      const inp0 = document.getElementById('relFilterSearch');\\n      const wasFocused = inp0 && document.activeElement === inp0;\\n      m.innerHTML = search + html;\\n      const inp = document.getElementById('relFilterSearch');\\n      if (inp && (relFilterQuery || wasFocused)) { inp.focus(); try { inp.setSelectionRange(inp.value.length, inp.value.length); } catch (e) {} }\\n    }\\n    function setReleaseFilter(name) {\\n      if (releaseFilterSel.has(name)) releaseFilterSel.delete(name); else releaseFilterSel.add(name);\\n      renderReleaseFilterMenu(); updateReleaseFilterBtn(); renderRoadmap(true);\\n    }\\n    function setLabelFilter(name) {\\n      _toggleNormalizedSelection(labelFilterSel, name);\\n      renderReleaseFilterMenu(); updateReleaseFilterBtn(); renderRoadmap(true);\\n    }\\n    function setComponentFilter(name) {\\n      if (componentFilterSel.has(name)) componentFilterSel.delete(name); else componentFilterSel.add(name);\\n      renderReleaseFilterMenu(); updateReleaseFilterBtn(); renderRoadmap(true);\\n    }\\n    function clearReleaseFilter() {\\n      releaseFilterSel.clear(); labelFilterSel.clear(); componentFilterSel.clear(); customFieldFilterSel = {}; renderReleaseFilterMenu(); updateReleaseFilterBtn(); renderRoadmap(true);\\n    }\\n    function updateReleaseFilterBtn() {\\n      const b = document.getElementById('releaseFilterBtn'); if (!b) return;\\n      const total = releaseFilterSel.size + labelFilterSel.size + componentFilterSel.size + _cfFilterCount();\\n      b.classList.toggle('relfilter-on', total > 0);\\n      const badge = document.getElementById('releaseFilterCount');\\n      if (badge) { badge.textContent = total; badge.style.display = total ? 'inline-flex' : 'none'; }\\n    }\\n    function toggleReleaseFilterMenu(e) {\\n      if (e) e.stopPropagation();\\n      const m = document.getElementById('releaseFilterMenu'); if (!m) return;\\n      if (m.classList.contains('hidden')) {\\n        // «Метки и релизы» открываются как отдельная правая шторка. Сначала\\n        // закрываем родительские фильтры: две шторки в одном слое перекрывали\\n        // друг друга, и наблюдатель модалок тут же закрывал новую панель.\\n        if (typeof closeAllPopovers === 'function') closeAllPopovers(true);\\n        if (typeof _drawerOpenGuardUntil === 'number') _drawerOpenGuardUntil = performance.now() + 420;\\n        if (m.parentElement !== document.body) document.body.appendChild(m);\\n        relFilterQuery = ''; renderReleaseFilterMenu();\\n        const btn = document.getElementById('releaseFilterBtn');\\n        if (btn) btn.setAttribute('aria-expanded', 'true');\\n        m.style.maxHeight = ''; m.style.overflowY = '';\\n        m.classList.remove('hidden');\\n        // После нормализации интерфейса это единая правая шторка: старое\\n        // позицион