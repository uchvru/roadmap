ring((document.getElementById('rbBlockText') || {}).value || '').trim();\\n      if (!title && !text) { showToast('Заполните заголовок или текст блока', 'warn'); return; }\\n      if (_rbEditingId) { const b = (reportBlocks || []).find(x => x && x.id === _rbEditingId); if (b) { b.title = title; b.text = text; } }\\n      else reportBlocks.push({ id: 'cb' + Date.now() + '_' + Math.floor(Math.random() * 1000), title: title, text: text });\\n      try { storage.set('gantt_report_blocks', JSON.stringify(reportBlocks)); } catch (e) {}\\n      if (typeof scheduleAutoSaveFile === 'function') scheduleAutoSaveFile();\\n      _rbHideBlockEditor(); renderReportBlocksList();\\n      const cEl = document.getElementById('rb_blk_custom'); if (cEl) cEl.checked = true;\\n    }\\n    function rbDeleteBlock(id) {\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      const b = (reportBlocks || []).find(x => x && x.id === id); if (!b) return;\\n      const snap = (typeof captureUndoState === 'function') ? captureUndoState() : null;\\n      reportBlocks = reportBlocks.filter(x => x && x.id !== id);\\n      try { storage.set('gantt_report_blocks', JSON.stringify(reportBlocks)); } catch (e) {}\\n      if (typeof scheduleAutoSaveFile === 'function') scheduleAutoSaveFile();\\n      if (_rbEditingId === id) _rbHideBlockEditor();\\n      renderReportBlocksList();\\n      // Последний свой блок удален , снимаем галочку «Свои блоки», чтобы сводка не включала пустой раздел молча\\n      if (!(reportBlocks || []).length) { const cEl = document.getElementById('rb_blk_custom'); if (cEl) cEl.checked = false; }\\n      if (snap && typeof offerUndo === 'function') offerUndo(`Блок «${b.title || 'без заголовка'}» удален`, snap); else showToast('Блок удален', 'ok');\\n    }\\n    // #19 Сравнение периодов: завершено задач за эту/прошлую неделю и месяц (по statusLog), + текущий срез\\n    // C1: учитывать активные фильтры списка в отчетах (по умолчанию выкл, чтобы не менять привычное поведение)\\n    let _reportApplyFilters = (function(){ try { return storage.get('gantt_report_apply_filters') === '1'; } catch(e){ return false; } })();\\n    function _setReportApplyFilters(on) {\\n      _reportApplyFilters = !!on;\\n      try { storage.set('gantt_report_apply_filters', _reportApplyFilters ? '1' : '0'); } catch (e) {}\\n      try { const _pc = document.getElementById('periodCompareBlock'); if (_pc) _pc.innerHTML = buildPeriodCompareHtml(); } catch (e) {}\\n      if (typeof renderReleaseProgress === 'function') { try { renderReleaseProgress(); } catch (e) {} }\\n      const report = document.getElementById('reportModal');\\n      if (report && !report.classList.contains('hidden') && document.getElementById('reportFrom')?.value && document.getElementById('reportTo')?.value) generateReport();\\n    }\\n    function _reportFilterToggleHtml() {\\n      return '<label class=\\\"flex items-center gap-2 mb-3 text-xs text-slate-600 cursor-pointer select-none\\\"><input type=\\\"checkbox\\\" ' + (_reportApplyFilters ? 'checked' : '') + ' onchange=\\\"_setReportApplyFilters(this.checked)\\\" class=\\\"accent-indigo-600 rounded\\\"><span>Учитывать активные фильтры списка (секция, исполнитель, метка и другие)</span></label>';\\n    }\\n    function buildPeriodCompareHtml() {\\n      const today = (typeof CURRENT_DATE !== 'undefined' && CURRENT_DATE) ? CURRENT_DATE : new Date();\\n      const sd = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate());\\n      const t0 = sd(today);\\n      const dow = (t0.getDay() + 6) % 7;\\n      const thisWeekStart = new Date(t0.getFullYear(), t0.getMonth(), t0.getDate() - dow);\\n      const lastWeekStart = new Date(thisWeekStart.getFullYear(), thisWeekStart.getMonth(), thisWeekStart.getDate() - 7);\\n      const lastWeekEnd = new Date(thisWeekStart.getFullYear(), thisWeekStart.getMonth(), thisWeekStart.getDate() - 1);\\n      const monthStart = new Date(t0.getFullYear(), t0.getMonth(), 1);\\n      const compYmd = (t) => (typeof _taskCompletionYmd === 'function') ? _taskCompletionYmd(t) : (t.updated || t.end || '');\\n      const inR = (ymd, a, b) => { const d = parseLocalDate(ymd); return d && d >= a && d <= b; };\\n      let thisW = 0, lastW = 0, thisM = 0, inWork = 0, overdue = 0, blockers = 0, undatedDone = 0;\\n      _applyReportScope(roadmapData || [], _currentReportScope()).forEach(t => {\\n        if (t.isMilestone) return;\\n        if (_reportApplyFilters && typeof taskPassesFilters === 'function' && !taskPassesFilters(t)) return;\\n        if (isFinalStatus(t.status)) {\\n          if (!t.start && !t.end) { undatedDone++; return; }\\n          const cy = compYmd(t);\\n          if (cy) { if (inR(cy, thisWeekStart, today)) thisW++; if (inR(cy, lastWeekStart, lastWeekEnd)) lastW++; if (inR(cy, monthStart, today)) thisM++; }\\n        } else {\\n          if (!isHeldStatus(t.status)) inWork++;\\n          if (typeof isBlocked === 'function' && isBlocked(t)) blockers++;\\n          if (!isHeldStatus(t.status)) { const te = parseLocalDate(t.end); if (te && te < today) overdue++; }\\n        }\\n      });\\n      const delta = thisW - lastW;\\n      const deltaHtml = delta === 0 ? '<span class=\\\"text-slate-500\\\">как на прошлой</span>'\\n        : (delta > 0 ? `<span class=\\\"text-emerald-600 font-semibold\\\">+${delta} к прошлой</span>` : `<span class=\\\"text-rose-600 font-semibold\\\">${delta} к прошлой</span>`);\\n      const tile = (label, val, sub) => `<div class=\\\"bg-white border border-slate-200 rounded-xl px-3 py-2 text-center\\\"><div class=\\\"text-[10px] uppercase tracking-wider text-slate-500\\\">${label}</div><div class=\\\"text-xl font-bold text-slate-800 tabular-nums leading-tight\\\">${val}</div>${sub ? `<div class=\\\"text-[10px] mt-0.5\\\">${sub}</div>` : ''}</div>`;\\n      return _reportFilterToggleHtml() + `<div class=\\\"mb-1.5 text-[10px] font-semibold text-slate-500 uppercase tracking-wider\\\">Сравнение периодов: завершено задач</div>\\n        <div class=\\\"grid grid-cols-3 gap-2 mb-2\\\">\\n          ${tile('Эта неделя', thisW, deltaHtml)}\\n          ${tile('Прошлая неделя', lastW, '<span class=\\\"text-slate-500\\\">базис</span>')}\\n          ${tile('Этот месяц', thisM, '')}\\n        </div>\\n        <div class=\\\"flex items-center gap-2 flex-wrap text-[10px]\\\">\\n          <span class=\\\"inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-blue-50 text-blue-700\\\"><b>${inWork}</b> в работе</span>\\n          <span class=\\\"inline-flex items-center gap-1 px-2 py-1 rounded-lg ${overdue ? 'bg-rose-50 text-rose-700' : 'bg-slate-50 text-slate-500'}\\\"><b>${overdue}</b> просрочено</span>\\n          <span class=\\\"inline-flex items-center gap-1 px-2 py-1 rounded-lg ${blockers ? 'bg-amber-50 text-amber-700' : 'bg-slate-50 text-slate-500'}\\\"><b>${blockers}</b> ${pluralRu(blockers, ['блокер', 'блокера', 'блокеров'])}</span>\\n          ${undatedDone ? `<span data-period-undated class=\\\"inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-slate-50 text-slate-600\\\" title=\\\"Не включены в итоги выбранного периода\\\"><b>${undatedDone}</b> завершены без дат</span>` : ''}\\n        </div>`;\\n    }\\n    function openReportModal() {\\n      const modal = document.getElementById('reportModal');\\n      if (!modal) return;\\n      // Период: восстанавливаем последний использованный, иначе , эта неделя\\n      const lastFrom = storage.get('gantt_report_from');\\n      const lastTo = storage.get('gantt_report_to');\\n      if (lastFrom && lastTo) {\\n        document.getElementById('reportFrom').value = lastFrom;\\n        document.getElementById('reportTo').value = lastTo;\\n      } else {\\n        setReportRange(7);\\n      }\\n      // Тема , по заголовку роадмапа\\n      const titleEl = document.getElementById('reportTitle');\\n      const roadmapTitle = (typeof roadmapTitleText === 'string' ? roadmapTitleText : '') || document.getElementById('roadmapTitle')?.textContent || '';\\n      if (titleEl && !titleEl.value) {\\n        const cleaned = roadmapTitle.replace(/^Дорожная карта:\\\\s*/i, '').trim();\\n        titleEl.value = cleaned || 'Главная';\\n      }\\n      // Список проектов (по умолчанию , по всему Ганту)\\n      const projSel = document.getElementById('reportProject');\\n      if (projSel) {\\n        const projects = (typeof getJiraProjects === 'function') ? getJiraProjects() : [];\\n        const cur = projSel.value || 'all';\\n        projSel.innerHTML = '<option value=\\\"all\\\">По всему Ганту</option>' + projects.map(p => `<option value=\\\"${escAttr(p)}\\\">${escHtml(p)}</option>`).join('');\\n        projSel.value = projects.includes(cur) ? cur : 'all';\\n        const _projWrap = projSel.parentElement; if (_projWrap) _projWrap.classList.toggle('hidden', !projects.length);\\n      }\\n      try { _initReportScopeControls(); } catch (e) {}\\n      try { const _pc = document.getElementById('periodCompareBlock'); if (_pc) _pc.innerHTML = buildPeriodCompareHtml(); } catch (e) {}\\n      modal.classList.remove('hidden');\\n      if (typeof syncBodyScrollLock === 'function') syncBodyScrollLock();\\n    }\\n    function closeReportModal() {\\n      const modal = document.getElementById('reportModal');\\n      if (modal) modal.classList.add('hidden');\\n      if (typeof syncBodyScrollLock === 'function') syncBodyScrollLock();\\n    }\\n    function setReportRange(daysBack) {\\n      const to = new Date();\\n      const from = new Date();\\n      from.setDate(from.getDate() - daysBack + 1);\\n      const ymd = d => toYmdLocal(d);\\n      const fEl = document.getElementById('reportFrom');\\n      const tEl = document.getElementById('reportTo');\\n      if (fEl) fEl.value = ymd(from);\\n      if (tEl) tEl.value = ymd(to);\\n    }\\n    function formatRuDateRange(fromStr, toStr) { return RoadmapModules.dateFormatRuRange(fromStr, toStr); }\\n    // Общий отбор задач для отчета за период: пул (активные + архив без дублей) и группы\\n    // «сделали / эскалация / следующая неделя / в работе». Используется текстовым отчетом и копированием таблицей.\\n    // S1/S2: вид-состояние отчета за период (фильтр секций/исполнителя + группировка). Не данные проекта.\\n    let _reportScopeSections = null;   // null = все секции; иначе Set имен секций\\n    let _reportScopeAssignee = 'all';  // 'all' или имя исполнителя\\n    let _reportGroupBy = 'none';       // 'none' | 'assignee' | 'role'\\n    // Токен-осведомленное совпадение исполнителя: задача с несколькими исполнителями подходит каждому из них.\\n    function _taskHasAssignee(t, who) {\\n      if (!who || who === 'all') return true;\\n      const names = (typeof splitResourceTokens === 'function' ? splitResourceTokens(t.resource) : String(t.resource || '').split(/[;,\\\\/]+/).map(x => x.trim()).filter(Boolean))\\n        .map(tok => (typeof parseResourceToken === 'function' ? parseResourceToken(tok).name : tok));\\n      return names.indexOf(who) >= 0;\\n    }\\n    // Применяет фильтр секций и исполнителя к списку задач отчета (общий источник для S1).\\n    function _applyReportScope(arr, scope) {\\n      if (!scope) return arr;\\n      const secSet = scope.sections instanceof Set ? scope.sections : (Array.isArray(scope.sections) ? new Set(scope.sections) : null);\\n      const who = scope.assignee || 'all';\\n      return arr.filter(t => (!secSet || secSet.has(t.section)) && _taskHasAssignee(t, who));\\n    }\\n    // Текущий охват из элементов окна «Отчет за период» (секции-чекбоксы + селект исполнителя).\\n    function _currentReportScope() {\\n      return { sections: _reportScopeSections instanceof Set ? _reportScopeSections : null, assignee: _reportScopeAssignee || 'all' };\\n    }\\n    // Список людей-исполнителей (без чистых ролей) , для селекта «Исполнитель» в отчете.\\n    function _reportPeopleList() {\\n      const out = [];\\n      const seen = new Set();\\n      (Array.isArray(projectResources) ? projectResources : []).forEach(tok => {\\n        const p = (typeof parseResourceToken === 'function') ? parseResourceToken(tok) : { name: tok, role: '' };\\n        const nm = p.name;\\n        // Чистые роли (имя = известная роль без пары) в список исполнителей не кладем.\\n        if (!p.role && typeof RES_KNOWN_ROLES !== 'undefined' && RES_KNOWN_ROLES.has(nm)) return;\\n        if (nm && !seen.has(nm)) { seen.add(nm); out.push(nm); }\\n      });\\n      // Добираем исполнителей, встречающихся в задачах, но не заведенных в справочнике\\n      (roadmapData || []).forEach(t => { (typeof splitResourceTokens === 'function' ? splitResourceTokens(t.resource) : []).forEach(tok => { const nm = (typeof parseResourceToken === 'function') ? parseResourceToken(tok).name : tok; if (nm && !seen.has(nm)) { seen.add(nm); out.push(nm); } }); });\\n      return out.sort((a, b) => a.localeCompare(b, 'ru'));\\n    }\\n    function _renderReportSecPicker() {\\n      const list = document.getElementById('reportSecPickerList'); if (!list) return;\\n      const secs = (Array.isArray(planSections) ? planSections : []).filter(sec => sec && sec !== 'Скрытые задачи' && sec !== 'На холде');\\n      if (_reportScopeSections instanceof Set) { [..._reportScopeSections].forEach(x => { if (!secs.includes(x)) _reportScopeSections.delete(x); }); }\\n      list.innerHTML = secs.map(sec => {\\n        const on = !(_reportScopeSections instanceof Set) || _reportScopeSections.has(sec);\\n        return `<label class=\\\"flex items-center gap-2 px-1.5 py-1 rounded-lg hover:bg-slate-50 cursor-pointer text-xs text-slate-700\\\"><input type=\\\"checkbox\\\" ${on ? 'checked' : ''} onchange=\\\"toggleReportSec('${escJsArg(sec)}', this.checked)\\\" class=\\\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\\\"><span class=\\\"truncate\\\" title=\\\"${escAttr(sec)}\\\">${escHtml(cleanSectionName(sec))}</span></label>`;\\n      }).join('') || '<div class=\\\"px-2 py-2 text-xs text-slate-400\\\">Нет секций</div>';\\n      _updateReportSecLabel();\\n    }\\n    function _updateReportSecLabel() {\\n      const lbl = document.getElementById('reportSecPickerLabel'); if (!lbl) return;\\n      const secs = (Array.isArray(planSections) ? planSections : []).filter(sec => sec && sec !== 'Скрытые задачи' && sec !== 'На холде');\\n      if (_reportScopeSections instanceof Set && _reportScopeSections.size === 0) { lbl.textContent = 'Ни одной секции'; }\\n      else if (!(_reportScopeSections instanceof Set) || _reportScopeSections.size === secs.length) { lbl.textContent = 'Все секции'; }\\n      else if (_reportScopeSections.size === 1) { lbl.textContent = cleanSectionName([..._reportScopeSections][0]); }\\n      else { lbl.textContent = 'Секций: ' + _reportScopeSections.size; }\\n      const compare = document.getElementById('periodCompareBlock');\\n      if (compare && typeof buildPeriodCompareHtml === 'function') compare.innerHTML = buildPeriodCompareHtml();\\n    }\\n    function toggleReportSec(sec, on) {\\n      const secs = (Array.isArray(planSections) ? planSections : []).filter(x => x && x !== 'Скрытые задачи' && x !== 'На холде');\\n      if (!(_reportScopeSections instanceof Set)) { _reportScopeSections = new Set(secs); }\\n      if (on) _reportScopeSections.add(sec); else _reportScopeSections.delete(sec);\\n      if (_reportScopeSections.size === secs.length) _reportScopeSections = null; // все выбраны , как «все»\\n      _updateReportSecLabel();\\n    }\\n    function setReportSecAll(on) {\\n      if (on) { _reportScopeSections = null; }\\n      else { _reportScopeSections = new Set(); }\\n      _renderReportSecPicker();\\n    }\\n    function toggleReportSecPicker(ev) {\\n      if (ev) ev.stopPropagation();\\n      const menu = document.getElementById('reportSecPickerMenu'); const btn = document.getElementById('reportSecPickerBtn');\\n      if (!menu) return;\\n      const willOpen = menu.classList.contains('hidden');\\n      menu.classList.toggle('hidden', !willOpen);\\n      if (btn) btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');\\n      if (willOpen) {\\n        _renderReportSecPicker();\\n        const away = (e) => { const w = document.getElementById('reportSecPickerWrap'); if (w && !w.contains(e.target)) { menu.classList.add('hidden'); if (btn) btn.setAttribute('aria-expanded', 'false'); document.removeEventListener('click', away, true); } };\\n        document.addEventListener('click', away, true);\\n      }\\n    }\\n    function setReportAssignee(v) { _reportScopeAssignee = v || 'all'; _updateReportSecLabel(); }\\n    function setReportGroupBy(v) {\\n      _reportGroupBy = ['assignee', 'role'].includes(v) ? v : 'none';\\n      [['none', 'reportGrpNone'], ['assignee', 'reportGrpAssignee'], ['role', 'reportGrpRole']].forEach(([k, id]) => {\\n        const el = document.getElementById(id); if (!el) return;\\n        const on = (_reportGroupBy === k);\\n        el.setAttribute('aria-pressed', on ? 'true' : 'false');\\n        el.className = `px-2.5 h-7 rounded-lg text-xs font-semibold transition-colors cursor-pointer ${on ? 'bg-white text-slate-700 shadow-sm' : 'text-slate-600 hover:bg-white/70'}`;\\n      });\\n    }\\n    // Заполняет элементы охвата/группировки при открытии окна отчета (сбрасывая на «все/нет»).\\n    function _initReportScopeControls() {\\n      _reportScopeSections = null; _reportScopeAssignee = 'all'; _reportGroupBy = 'none';\\n      const sel = document.getElementById('reportAssignee');\\n      if (sel) { sel.innerHTML = '<option value=\\\"all\\\">Все исполнители</option>' + _reportPeopleList().map(nm => `<option value=\\\"${escAttr(nm)}\\\">${escHtml(nm)}</option>`).join(''); sel.value = 'all'; }\\n      _renderReportSecPicker();\\n      setReportGroupBy('none');\\n      const menu = document.getElementById('reportSecPickerMenu'); if (menu) menu.classList.add('hidden');\\n    }\\n    function _periodReportSets(fromStr, toStr, projectVal, scope) {\\n      const fromDays = dateToDays(fromStr);\\n      const toDays = dateToDays(toStr);\\n      const todayDays = dateToDays(toYmdLocal(CURRENT_DATE || new Date()));\\n      // Пул отчета = активные + архивные задачи. Скрытые (t.hidden) уже в roadmapData.\\n      const archivedPool = (archivedTasks || []).map(t => ({ ...t, _src: 'archive' }));\\n      let pool = [...roadmapData, ...archivedPool];\\n      // Дедуп по Jira-ключу: одна задача , одна запись. Активная имеет приоритет над архивной.\\n      {\\n        const byKey = new Map();\\n        const deduped = [];\\n        pool.forEach(t => {\\n          const k = t.jira ? String(t.jira).trim().toLowerCase() : '';\\n          if (!k) { deduped.push(t); return; }\\n          const prev = byKey.get(k);\\n          if (!prev) { byKey.set(k, t); deduped.push(t); }\\n          else if (prev._src === 'archive' && t._src !== 'archive') {\\n            const i = deduped.indexOf(prev); if (i >= 0) deduped[i] = t; byKey.set(k, t);\\n          }\\n        });\\n        pool = deduped;\\n      }\\n      let tasks = pool.filter(t => !t.isMilestone && (projectVal === 'all' || extractProjectKey(t.jira) === projectVal));\\n      // S1: дополнительно сужаем по выбранным секциям и исполнителю (по умолчанию , все)\\n      tasks = _applyReportScope(tasks, scope);\\n      if (typeof _reportApplyFilters !== 'undefined' && _reportApplyFilters) tasks = tasks.filter(t => taskPassesFilters(t));\\n      const srcTag = t => t._src === 'archive' ? ' · из архива' : (t.hidden ? ' · скрыта' : '');\\n      // Каждая задача попадает только в одну группу. Приоритет: Сделали -> Эскалация -> Следующая неделя -> В работе.\\n      const uid = t => t.jira ? ('J:' + String(t.jira).trim().toLowerCase()) : ('#' + t.id);\\n      const seen = new Set();\\n      const takeNew = (arr) => arr.filter(t => { const k = uid(t); if (seen.has(k)) return false; seen.add(k); return true; });\\n      const isParentSection = (sec) => /^(Initiative:|Epic:|Story:)/.test(String(sec || ''));\\n      // Безопасные индексы дней: одна дата заполняет вторую; NaN только если дат нет вовсе.\\n      const dStart = (t) => { const v = t.start || t.end; return v ? dateToDays(v) : NaN; };\\n      const dEnd = (t) => { const v = t.end || t.start; return v ? dateToDays(v) : NaN; };\\n      const isUndated = (t) => !t.start && !t.end; // совсем без дат , нет бара, по дате не сгруппировать\\n      // Плановый конец для эскалации: только явный конец/дедлайн (старт не считаем концом), иначе нет , не эскалируем.\\n      const escEndDays = (t) => { const v = t.end || t.deadline; return v ? dateToDays(v) : NaN; };\\n      // Недатированные завершенные видны отдельно, но не приписываются периоду.\\n      const doneUndated = takeNew(tasks.filter(t => isFinalStatus(t.status) && isUndated(t)));\\n      const done = takeNew(tasks.filter(t => isFinalStatus(t.status) && !isUndated(t) && dEnd(t) >= fromDays && dEnd(t) <= toDays));\\n      const doneByParent = new Map();\\n      const doneStandalone = [];\\n      done.forEach(t => {\\n        if (isParentSection(t.section)) {\\n          if (!doneByParent.has(t.section)) doneByParent.set(t.section, []);\\n          doneByParent.get(t.section).push(t);\\n        } else doneStandalone.push(t);\\n      });\\n      // ЭСКАЛАЦИЯ , просроченные по явному плановому концу/дедлайну (не завершено). Задачи только со стартом\\n      // или совсем без дат не эскалируются , у них нет срока, по которому считать просрочку (фикс M46).\\n      const escalation = takeNew(tasks.filter(t => isAttentionActiveTask(t) && Number.isFinite(escEndDays(t)) && escEndDays(t) < todayDays));\\n      // НА СЛЕДУЮЩЕЙ НЕДЕЛЕ , старт в окне +1..+7 дней (и еще не показаны)\\n      const nextWeek = takeNew(tasks.filter(t => isAttentionActiveTask(t) && dStart(t) >= todayDays + 1 && dStart(t) <= todayDays + 7));\\n      // В РАБОТЕ , пересекаются с периодом ИЛИ совсем без дат (по статусу), не завершено и еще не показаны\\n      const inWork = takeNew(tasks.filter(t => isAttentionActiveTask(t) && (isUndated(t) || (dStart(t) <= toDays && dEnd(t) >= fromDays))));\\n      return { pool, tasks, done, doneUndated, doneByParent, doneStandalone, escalation, nextWeek, inWork, srcTag, todayDays };\\n    }\\n    function generateReport() {\\n      const fromStr = document.getElementById('reportFrom').value;\\n      const toStr = document.getElementById('reportTo').value;\\n      const title = (document.getElementById('reportTitle').value || '').trim() || 'проекту';\\n      if (!fromStr || !toStr) { showToast('Укажите период', 'warn'); return; }\\n      // Запоминаем период для следующего открытия\\n      storage.set('gantt_report_from', fromStr);\\n      storage.set('gantt_report_to', toStr);\\n      // Лимит задач в каждом разделе («Все» или топ N)\\n      const limitRaw = (document.getElementById('reportLimit') || {}).value || 'all';\\n      const _lim = parseInt(limitRaw, 10); const limitN = (limitRaw === 'all' || !Number.isFinite(_lim) || _lim <= 0) ? Infinity : _lim;\\n      // Добавляет строки раздела с учетом лимита и пометкой об остатке\\n      const pushLimited = (arr, renderLine) => {\\n        arr.slice(0, limitN).forEach(renderLine);\\n        const rest = arr.length - Math.min(arr.length, limitN);\\n        if (rest > 0) lines.push(`- …и еще ${rest} (показаны первые ${limitN})`);\\n      };\\n      const projectVal = (document.getElementById('reportProject') || {}).value || 'all';\\n      const S = _periodReportSets(fromStr, toStr, projectVal, _currentReportScope());\\n      const { done, doneUndated, doneByParent, doneStandalone, escalation, nextWeek, inWork, srcTag, todayDays } = S;\\n\\n      // Финальность собственного статуса эпика определяется правилами проекта.\\n      const sectionKey = (sec) => jiraEpicKeyOfSection(sec);\\n      const isEpicClosed = (section) => {\\n        const key = sectionKey(section);\\n        return !!key && isFinalStatus(epicStatusByKey[key]);\\n      };\\n      // Хелперы группировки по эпикам/стори и статусам\\n      const sectionKind = (sec) => String(sec || '').startsWith('Initiative:') ? 'Инициатива' : (String(sec || '').startsWith('Story:') ? 'Стори' : 'Эпик');\\n      const statusName = (id) => (projectStatuses.find(s => s.id === id) || {}).name || id || 'Без статуса';\\n      const STATUS_ORDER = RoadmapModules.statusGroups.reportOrder;\\n      const taskLine = (t) => `${t.name}${t.jira ? ` (${getTaskKey(t)})` : ''}`;\\n      // S2: разбивка задач по исполнителю/роли. Задача с несколькими исполнителями попадает к каждому.\\n      const _spOf = (t) => { const v = parseFloat(t && t.storyPoints); return (Number.isFinite(v) && v > 0) ? v : 0; };\\n      const _groupTasksBy = (arr, mode) => {\\n        const groups = new Map(); // key -> { label, tasks }\\n        const addTo = (key, label, t) => { if (!groups.has(key)) groups.set(key, { label, tasks: [] }); groups.get(key).tasks.push(t); };\\n        arr.forEach(t => {\\n          const toks = (typeof splitResourceTokens === 'function' ? splitResourceTokens(t.resource) : String(t.resource || '').split(/[;,\\\\/]+/).map(x => x.trim()).filter(Boolean));\\n          const names = toks.map(tok => (typeof parseResourceToken === 'function' ? parseResourceToken(tok).name : tok)).filter(Boolean);\\n          if (!names.length) { addTo('__none__', 'Без исполнителя', t); return; }\\n          if (mode === 'role') {\\n            const roles = [...new Set(names.map(nm => (resourceRoles[nm] || '').trim() || 'Без роли'))];\\n            roles.forEach(ro => addTo('role:' + ro, ro, t));\\n          } else {\\n            [...new Set(names)].forEach(nm => addTo('name:' + nm, nm, t));\\n          }\\n        });\\n        // Сортировка: «Без ...» в конец, прочее по алфавиту\\n        return [...groups.entries()].sort((a, b) => {\\n          const aEmpty = a[0] === '__none__' || /:(Без роли)$/.test(a[0]);\\n          const bEmpty = b[0] === '__none__' || /:(Без роли)$/.test(b[0]);\\n          return (aEmpty - bEmpty) || a[1].label.localeCompare(b[1].label, 'ru');\\n        }).map(e => ({ key: e[0], label: e[1].label, tasks: e[1].tasks }));\\n      };\\n      const _groupHeader = (label, tasks, doneMode) => {\\n        const sp = tasks.reduce((acc, t) => acc + _spOf(t), 0);\\n        const spTxt = sp > 0 ? ` (${sp % 1 === 0 ? sp : sp.toFixed(1)} SP)` : '';\\n        if (doneMode) return `- ${label} • закрыто ${tasks.length} задач${spTxt}`;\\n        return `- ${label} • ${tasks.length} задач${spTxt}`;\\n      };\\n\\n      // Сборка текста , все 4 группы показываем всегда, пустую помечаем «нет изменений»\\n      const lines = [];\\n      lines.push(`Итоги периода ${formatRuDateRange(fromStr, toStr)} по ${title}.`);\\n      lines.push('');\\n      const noChange = '- нет изменений';\\n\\n      lines.push('Сделали');\\n      if (done.length === 0) {\\n        lines.push(noChange);\\n      } else if (_reportGroupBy !== 'none') {\\n        _groupTasksBy(done, _reportGroupBy).forEach(g => {\\n          lines.push(_groupHeader(g.label, g.tasks, true));\\n          g.tasks.slice(0, limitN).forEach(t => lines.push(`  • ${taskLine(t)}${srcTag(t)}`));\\n          const rest = g.tasks.length - Math.min(g.tasks.length, limitN);\\n          if (rest > 0) lines.push(`  • …и еще ${rest}`);\\n        });\\n      } else {\\n        // Эпики и стори: заголовок с ключом и тем, что закрылось за период\\n        [...doneByParent.keys()]\\n          .sort((a, b) => cleanSectionName(a).localeCompare(cleanSectionName(b), 'ru'))\\n          .forEach(sec => {\\n            const items = doneByParent.get(sec);\\n            const k = sectionKey(sec);\\n            const closedWhole = isEpicClosed(sec);\\n            const tail = closedWhole ? `закрыт полностью (за период • ${items.length})` : `за период закрыто задач: ${items.length}`;\\n            lines.push(`- ${sectionKind(sec)} «${cleanSectionName(sec)}»${k ? ` (${k})` : ''} • ${tail}`);\\n            items.slice(0, limitN).forEach(t => lines.push(`  • ${taskLine(t)}${srcTag(t)}`));\\n            const rest = items.length - Math.min(items.length, limitN);\\n            if (rest > 0) lines.push(`  • …и еще ${rest}`);\\n          });\\n        // Отдельные задачи без эпика , по имени\\n        pushLimited(doneStandalone, t => lines.push(`- ${taskLine(t)}, закрыта${srcTag(t)}`));\\n      }\\n      lines.push('');\\n\\n      lines.push('В работе');\\n      if (inWork.length === 0) {\\n        lines.push(noChange);\\n      } else if (_reportGroupBy !== 'none') {\\n        _groupTasksBy(inWork, _reportGroupBy).forEach(g => {\\n          lines.push(_groupHeader(g.label, g.tasks, false));\\n          g.tasks.slice(0, limitN).forEach(t => {\\n            const piece = [`  • ${taskLine(t)}`, `, ${statusName(t.status || 'planned')}`];\\n            if (t.deadline) piece.push(`, дедлайн ${formatDateString(t.deadline)}`);\\n            else if (t.end) piece.push(`, срок ${formatDateString(t.end)}`);\\n            piece.push(srcTag(t));\\n            lines.push(piece.join(''));\\n          });\\n          const rest = g.tasks.length - Math.min(g.tasks.length, limitN);\\n          if (rest > 0) lines.push(`  • …и еще ${rest}`);\\n        });\\n      } else {\\n        // Объединяем по статусам , так легче читать\\n        const byStatus = new Map();\\n        inWork.forEach(t => { const s = t.status || 'planned'; if (!byStatus.has(s)) byStatus.set(s, []); byStatus.get(s).push(t); });\\n        [...byStatus.keys()]\\n          .sort((a, b) => { const ia = STATUS_ORDER.indexOf(a), ib = STATUS_ORDER.indexOf(b); return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib); })\\n          .forEach(s => {\\n            const items = byStatus.get(s);\\n            lines.push(`- ${statusName(s)} (${items.length}):`);\\n            items.slice(0, limitN).forEach(t => {\\n              const piece = [`  • ${taskLine(t)}`];\\n              if (t.resource) piece.push(`, ${t.resource}`);\\n              if (t.deadline) piece.push(`, дедлайн ${formatDateString(t.deadline)}`);\\n              else if (