 .row-actions { opacity: 1 !important; pointer-events: auto !important }\\n    }\\n    /* Фикс Tailwind v4: utility .inline-flex объявлен после .hidden, поэтому .hidden не скрывал\\n      элементы вида \\\"hidden inline-flex\\\" (кнопки Удалить/Дублировать, действия архива).\\n      Правило из двух классов имеет больший приоритет и возвращает скрытие. На адаптивные\\n      показы вида \\\"hidden md:flex\\\" не влияет , там нет литерального класса inline-flex. */\\n    .hidden.inline-flex { display: none; }\\n    /* Уважение системной настройки «уменьшить движение» */\\n    @media (prefers-reduced-motion: reduce) {\\n      *, *::before, *::after {\\n        animation: none !important;\\n        transition-property: color, background-color, border-color, opacity !important;\\n        transition-duration: 80ms !important;\\n        transition-delay: 0s !important;\\n        scroll-behavior: auto !important;\\n      }\\n    }\\n\\n    /* ====== Единая шкала слоев (z-index) ======\\n      content  10-30  полоски, линии «сегодня»/отсечки, оверлеи внутри строки\\n      dropdown 100   меню «Данные», фильтры (статусы/проекты/ресурсы)\\n      popover  150   панель перемещения задачи\\n      modal   1000  обычные модалки (задача, отчет, архив, статусы, ресурсы, цвет, инфо, поиск)\\n      modal-2  1100  модалки поверх модалок (отсечка, ввод/подтверждение)\\n      toast   2000  тосты и кнопка отмены, видны поверх модалок\\n      tooltip  3000  кастомные подсказки, поверх всего\\n      startup  990   намеренно ниже обычных модалок, чтобы «О проекте» открывалось поверх него */\\n\\n    /* === Связывание задач перетягиванием === */\\n    .link-target { box-shadow: inset 0 0 0 2px var(--color-indigo-500) !important; background: rgba(99,102,241,0.06) !important; }\\n    body.linking-active, body.linking-active * { cursor: crosshair !important; }\\n    body.linking-active .timeline-scroll { user-select: none; }\\n    #bars-container [data-task-id] { transition: opacity .15s ease; }\\n    body:not(.select-mode) .bulk-cb { display: none !important; }\\n    /* Презентационный режим: прячем кнопки строк и чекбоксы выбора, чуть укрупняем заголовки секций */\\n    body.presentation-mode .row-actions { display: none !important; }\\n    body.presentation-mode .bulk-cb { display: none !important; }\\n    body.presentation-mode #bulkBar { display: none !important; }\\n    body.presentation-mode [id^=\\\"header-left-\\\"] { font-size: 12.5px; }\\n    /* v8.1 D1: компактный обзор , скрываем обычные строки задач, заголовки секций и вехи остаются */\\n    body.compact-overview [id^=\\\"task-row-left-\\\"]:not(.ms-row),\\n    body.compact-overview [id^=\\\"task-row-right-\\\"]:not(.ms-row) { display: none !important; }\\n    /* Ч/б печать среза: вся карта без цвета */\\n    body.print-bw #roadmap-root { filter: grayscale(1); }\\n\\n    /* === Кнопки мультивыбора фильтров === */\\n    .filter-multibtn:hover { color: #334155; }\\n    .filter-multibtn[data-active=\\\"1\\\"] {\\n      background: var(--color-indigo-50);\\n      color: var(--color-indigo-700);\\n      font-weight: 600;\\n      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-indigo-500) 40%, transparent);\\n    }\\n    .filter-multibtn-blue[data-active=\\\"1\\\"] {\\n      background: #dbeafe;\\n      color: #1d4ed8;\\n      box-shadow: inset 0 0 0 1px rgba(59,130,246,.4);\\n    }\\n    /* Кнопка автосохранения: зеленая, когда привязан файл (автосохранение идет), иначе серая */\\n    button.autosave-on { background:#ecfdf5 !important; border-color:#6ee7b7 !important; color:#059669 !important; }\\n    button.autosave-on:hover { background:#d1fae5 !important; color:#047857 !important; }\\n    /* Замок защиты изменений: красный когда заблокировано, янтарный когда пароль есть, но разблокировано */\\n    button.lock-on { background:#fef2f2 !important; border-color:#fecaca !important; color:#dc2626 !important; }\\n    button.lock-on:hover { background:#fee2e2 !important; color:#b91c1c !important; }\\n    button.lock-set { background:#fffbeb !important; border-color:#fde68a !important; color:#d97706 !important; }\\n    /* Кнопка блокировки проекта */\\n    button.project-locked { background:#fef2f2 !important; border-color:#fca5a5 !important; color:#dc2626 !important; }\\n    button.project-locked:hover { background:#fee2e2 !important; color:#b91c1c !important; }\\n    /* Шапка списка: серый оверлей когда заблокировано */\\n    body.project-locked-mode .no-print.no-image-export button:not(#lockProjectBtn):not(#autoSaveBtn):not([onclick*=\\\"openGlobalSearch\\\"]):not([onclick*=\\\"openInfoModal\\\"]):not([onclick*=\\\"openStartupModal\\\"]):not([onclick*=\\\"openReportModal\\\"]){ opacity:0.45; pointer-events:none !important; cursor:not-allowed !important; }\\n    body.project-locked-mode .lock-overlay-bar { display:flex !important; }\\n    /* Режим мультивыбора активен: зеленая кнопка (отличается от синей «+») */\\n    /* Активный фильтр по релизу/метке: индиго-точка-индикатор */\\n    button.relfilter-on { background:var(--rm-selected-bg,#eef2ff) !important; border-color:var(--rm-selected-border,#a5b4fc) !important; color:var(--rm-selected-text,#4338ca) !important; }\\n\\n    /* === Режим экспорта в PNG , чистый интерфейс === */\\n    body.image-export-mode .no-print,\\n    body.image-export-mode .no-image-export,\\n    body.image-export-mode #autosaveStatus,\\n    body.image-export-mode header > div:last-child,\\n    body.image-export-mode .drag-handle,\\n    body.image-export-mode #titleEditContainer,\\n    body.image-export-mode #timeline-footer {\\n      display: none !important;\\n    }\\n    body.image-export-mode header {\\n      padding: 16px 20px !important;\\n      border-bottom: 1px solid #e2e8f0 !important;\\n    }\\n    body.image-export-mode #roadmap-root {\\n      max-width: none !important;\\n      padding: 16px !important;\\n      background: #ffffff !important;\\n    }\\n    /* main: убираем overflow-hidden , иначе html2canvas срезает правую часть */\\n    body.image-export-mode main {\\n      box-shadow: none !important;\\n      border: 1px solid #e2e8f0 !important;\\n      overflow: visible !important;\\n      display: flex !important;\\n      flex-direction: row !important;\\n    }\\n    /* Левая колонка: 540px вместо 460 , подзаголовки задач помещаются целиком.\\n      Цель , по классу .export-left-col, а не :first-child: первым ребенком main\\n      идет абсолютно спозиционированный #zoomControl, поэтому :first-child промахивался. */\\n    body.image-export-mode main > .export-left-col {\\n      width: 540px !important;\\n      min-width: 540px !important;\\n      max-width: 540px !important;\\n      flex: 0 0 540px !important;\\n    }\\n    /* Подзаголовок строки задачи не должен переноситься , даем ему scroll-overflow */\\n    body.image-export-mode [id^=\\\"task-row-left-\\\"] {\\n      min-height: 56px !important;\\n      height: auto !important;\\n      padding-top: 6px !important;\\n      padding-bottom: 6px !important;\\n    }\\n    /* timeline-scroll: hidden , обрезает контент, сдвинутый через transform за пределы видимой области */\\n    body.image-export-mode .timeline-scroll {\\n      overflow: hidden !important;\\n    }\\n    body.image-export-mode .timeline-scroll::-webkit-scrollbar {\\n      display: none !important;\\n    }\\n    /* bars-container , убираем минимальную высоту чтобы не было пустоты после задач */\\n    body.image-export-mode #bars-container {\\n      min-height: 0 !important;\\n    }\\n    /* Hover-controls , скрываем (карандаши, корзины в заголовках секций) */\\n    body.image-export-mode [class*=\\\"group-hover:opacity-100\\\"] {\\n      opacity: 0 !important;\\n    }\\n    /* Гарантируем что строки задач видны полностью */\\n    body.image-export-mode [id^=\\\"task-row-left-\\\"],\\n    body.image-export-mode [id^=\\\"task-row-right-\\\"] {\\n      overflow: visible !important;\\n    }\\n    body.image-export-mode [id^=\\\"task-row-left-\\\"] .truncate {\\n      text-overflow: ellipsis !important;\\n      overflow: hidden !important;\\n      white-space: nowrap !important;\\n    }\\n    /* Снимок/read-only PNG: на экране мета-строка задачи в одну строку с обрезкой, а в экспорте разворачиваем,\\n      чтобы строка выросла по высоте и были видны все чипы (как было до перехода на flex-nowrap) */\\n    body.image-export-mode .task-meta-line {\\n      flex-wrap: wrap !important;\\n      overflow: visible !important;\\n    }\\n    /* Дата снимка в правом верхнем углу шапки */\\n    body.image-export-mode header::after {\\n      content: 'Снимок: ' attr(data-snapshot-date);\\n      position: absolute;\\n      top: 12px;\\n      right: 16px;\\n      font-size: 10px;\\n      color: #64748b;\\n      font-family: 'Inter', sans-serif;\\n      font-weight: 500;\\n    }\\n    /* Инфо-полоса снимка , видна только в PNG-экспорте, с полезной сводкой по проекту */\\n    #snapshotInfoBar { display: none; }\\n    body.image-export-mode #snapshotInfoBar { display: block !important; }\\n    body.slide-16x9 #roadmapTitle { font-size: 22px !important; font-weight: 700 !important; }\\n    body.slide-16x9 header::after { font-size: 13px !important; }\\n\\n    @media print {\\n      *, *::before, *::after {\\n        -webkit-print-color-adjust: exact !important;\\n        print-color-adjust: exact !important;\\n      }\\n      @page { size: A4 landscape; margin: 5mm; }\\n      html, body {\\n        overflow: visible !important;\\n        background: white !important;\\n        width: auto !important;\\n        height: auto !important;\\n        margin: 0 !important;\\n        padding: 0 !important;\\n      }\\n      .no-print { display: none !important; }\\n      .timeline-scroll { overflow: visible !important; }\\n      main {\\n        overflow: visible !important;\\n        max-height: none !important;\\n        page-break-inside: auto;\\n      }\\n      #roadmap-root {\\n        max-width: none !important;\\n        padding: 0 !important;\\n        margin: 0 !important;\\n      }\\n      /* Режим печати: масштабирование всего рута до ширины листа */\\n      #roadmap-root.print-mode {\\n        transform: scale(var(--print-scale, 1));\\n        transform-origin: top left;\\n        width: var(--print-content-width, 100%);\\n      }\\n      /* Скрываем декоративные элементы при печати */\\n      #roadmap-root.print-mode header { box-shadow: none !important; }\\n      #roadmap-root.print-mode main { box-shadow: none !important; }\\n      /* Запрещаем разрыв строк задач между страницами по возможности */\\n      [id^=\\\"task-row-left-\\\"], #bars-container > div { page-break-inside: avoid; }\\n    }\\n\\n  /* v8.2: Роли и ресурсы , табличная сетка */\\n  .rgrid{display:grid;grid-template-columns:minmax(150px,1fr) minmax(84px,116px) 92px 92px 104px 96px;gap:8px;align-items:center;min-width:650px;}\\n  /* Переключатели модулей в окне «Настройки» */\\n  .feat-switch{position:relative;display:inline-block;width:36px;height:20px;flex-shrink:0;}\\n  .feat-switch input{position:absolute;inset:0;opacity:0;width:100%;height:100%;margin:0;cursor:pointer;z-index:1;}\\n  .feat-switch .fs-track{position:absolute;inset:0;background:#e2e8f0;border-radius:9999px;transition:background .15s;}\\n  .feat-switch .fs-knob{position:absolute;top:2px;left:2px;width:16px;height:16px;background:#fff;border-radius:9999px;box-shadow:0 1px 2px rgba(15,23,42,.25);transition:transform .15s;}\\n  .feat-switch input:checked + .fs-track{background:var(--rm-primary);}\\n  .feat-switch input:checked ~ .fs-knob{transform:translateX(16px);}\\n  .feat-switch input:disabled{cursor:not-allowed;}\\n  .feat-switch input:disabled + .fs-track,.feat-switch input:disabled ~ .fs-knob{opacity:.55;}\\n  /* Темная тема на экране. PNG/PDF выбирают отдельную палитру в экспортном клоне/документе. */\\n  @media screen {\\n   body:not(.theme-dark){background:linear-gradient(160deg,#eef2ff 0%,#eaf2fe 40%,#f6f8fc 100%) fixed} .theme-dark { background-color:#0f151