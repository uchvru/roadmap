ker>\\n        <marker id=\\\"dep-arrow-warn\\\" viewBox=\\\"0 0 10 10\\\" refX=\\\"8\\\" refY=\\\"5\\\" markerWidth=\\\"9\\\" markerHeight=\\\"9\\\" orient=\\\"auto\\\" markerUnits=\\\"userSpaceOnUse\\\">\\n          <path d=\\\"M1,1 L9,5 L1,9 Z\\\" fill=\\\"#f43f5e\\\"/>\\n        </marker>`;\\n      svg.appendChild(defs);\\n\\n      pairs.forEach(({ pred, succ, predRight, succRight }) => {\\n        const di = _depInfo(succ, pred.id);\\n        const predStartDays = dateToDays(pred.start);\\n        const predEndDays = dateToDays(pred.end);\\n        const succStartDays = dateToDays(succ.start);\\n        const succEndDays = dateToDays(succ.end);\\n        // Точки привязки зависят от типа связи (FS/SS/FF/SF). Для вех , угол ромба у центра.\\n        const _pStartPx = pred.isMilestone ? (predStartDays + 0.5) * DAY_WIDTH - 6 : predStartDays * DAY_WIDTH;\\n        const _pEndPx = pred.isMilestone ? (predEndDays + 0.5) * DAY_WIDTH + 6 : (predEndDays + 1) * DAY_WIDTH;\\n        const _sStartPx = succ.isMilestone ? (succStartDays + 0.5) * DAY_WIDTH - 6 : succStartDays * DAY_WIDTH;\\n        const _sEndPx = succ.isMilestone ? (succEndDays + 0.5) * DAY_WIDTH + 6 : (succEndDays + 1) * DAY_WIDTH;\\n        const _fromStart = (di.type === 'SS' || di.type === 'SF');\\n        const _toEnd = (di.type === 'FF' || di.type === 'SF');\\n        const predRightPx = _fromStart ? _pStartPx : _pEndPx;\\n        const succLeftPx = _toEnd ? _sEndPx : _sStartPx;\\n\\n        // Y-координаты центров баров берем ПРЯМО из rowRight по их offsetTop\\n        const predY = predRight.offsetTop + predRight.offsetHeight / 2;\\n        const succY = succRight.offsetTop + succRight.offsetHeight / 2;\\n\\n        // Нарушение порядка с учетом типа связи и лага , рисуем красным.\\n        let isViolation;\\n        if (di.type === 'SS') isViolation = succStartDays < predStartDays + di.lag;\\n        else if (di.type === 'FF') isViolation = succEndDays < predEndDays + di.lag;\\n        else if (di.type === 'SF') isViolation = succEndDays < predStartDays + di.lag;\\n        else isViolation = succStartDays < predEndDays + 1 + di.lag;\\n        const strokeColor = isViolation ? '#f43f5e' : 'var(--color-indigo-500)';\\n        // Плавная кривая Безье. Смещение контрольных точек = доля реального промежутка,\\n        // поэтому при стыке (одинаковый X, но разные строки) получается чистая почти вертикальная\\n        // линия без петли; на большом промежутке , мягкая S; при перекрытии назад , пологая дуга.\\n        const x1 = predRightPx, y1 = predY;\\n        const x2 = succLeftPx, y2 = succY;\\n        // Ортогональный маршрут с обходом бара цели; стиль «Кривые» дает те же\\n        // маршруты со скругленными углами , вход в задачу всегда с нужной стороны.\\n        const _pts = _depOrthoPts(x1, y1, x2, y2, _fromStart, _toEnd, succRight.offsetTop, succRight.offsetTop + succRight.offsetHeight);\\n        const d = _depPathD(_pts, depLineStyle !== 'straight');\\n        const path = document.createElementNS(svgNS, 'path');\\n        path.setAttribute('d', d);\\n        path.setAttribute('fill', 'none');\\n        path.setAttribute('stroke', strokeColor);\\n        path.setAttribute('stroke-width', '2');\\n        path.setAttribute('stroke-linecap', 'round');\\n        path.setAttribute('stroke-linejoin', 'round');\\n        path.setAttribute('opacity', isViolation ? '0.85' : '0.85');\\n        path.setAttribute('marker-end', isViolation ? 'url(#dep-arrow-warn)' : 'url(#dep-arrow)');\\n        path.dataset.pred = pred.id; path.dataset.succ = succ.id; path.dataset.viol = isViolation ? '1' : '0';\\n        path.style.pointerEvents = 'none';\\n        svg.appendChild(path);\\n\\n        // Прозрачная широкая хитбокс-линия , наведение и клик (только в режиме редактирования)\\n        if (typeof READ_ONLY_MODE === 'undefined' || !READ_ONLY_MODE) {\\n          const hit = document.createElementNS(svgNS, 'path');\\n          hit.setAttribute('d', d);\\n          hit.setAttribute('fill', 'none');\\n          hit.setAttribute('stroke', 'transparent');\\n          hit.setAttribute('stroke-width', '14');\\n          hit.style.cursor = 'pointer';\\n          hit.style.pointerEvents = 'stroke';\\n          hit.dataset.hit = '1'; hit.dataset.pred = pred.id; hit.dataset.succ = succ.id;\\n          try { hit.setAttribute('data-tip', _depTipText(pred, succ)); } catch (e) {}\\n          svg.appendChild(hit);\\n        }\\n\\n        // Точка-узел в начале (на правом краю предшественника)\\n        const dot = document.createElementNS(svgNS, 'circle');\\n        dot.setAttribute('cx', predRightPx);\\n        dot.setAttribute('cy', predY);\\n        dot.setAttribute('r', '2');\\n        dot.setAttribute('fill', strokeColor);\\n        dot.setAttribute('opacity', '0.75');\\n        dot.style.pointerEvents = 'none';\\n        svg.appendChild(dot);\\n      });\\n\\n      svg.addEventListener('click', (e) => {\\n        const t = e.target; if (!t || !t.dataset || t.dataset.hit !== '1') return;\\n        e.stopPropagation(); openDepMenu(parseInt(t.dataset.pred, 10), parseInt(t.dataset.succ, 10), e.clientX, e.clientY);\\n      });\\n      svg.addEventListener('mouseover', (e) => {\\n        const t = e.target; if (!t || !t.dataset || t.dataset.hit !== '1') return;\\n        const vp = svg.querySelector('path[data-pred=\\\"' + t.dataset.pred + '\\\"][data-succ=\\\"' + t.dataset.succ + '\\\"]:not([data-hit])');\\n        if (vp) { vp.setAttribute('stroke-width', '3.5'); vp.setAttribute('opacity', '1'); }\\n      });\\n      svg.addEventListener('mouseout', (e) => {\\n        const t = e.target; if (!t || !t.dataset || t.dataset.hit !== '1') return;\\n        const vp = svg.querySelector('path[data-pred=\\\"' + t.dataset.pred + '\\\"][data-succ=\\\"' + t.dataset.succ + '\\\"]:not([data-hit])');\\n        if (vp) { vp.setAttribute('stroke-width', '2'); vp.setAttribute('opacity', '0.85'); }\\n      });\\n\\n      barsContainer.appendChild(svg);\\n    }\\n\\n    \\n    // ===== Интерактивные линии связей: наведение (подсветка), клик (меню изменить тип / удалить) =====\\n    function _depTipText(pred, succ) {\\n      try {\\n        const di = _depInfo(succ, pred.id);\\n        const TL = { FS: 'начать после окончания', SS: 'начать вместе', FF: 'закончить вместе', SF: 'закончить после начала' };\\n        const lag = di.lag ? (', задержка ' + di.lag + ' дн') : '';\\n        return 'Связь: ' + (pred.name || '') + ' → ' + (succ.name || '') + ' (' + (TL[di.type] || di.type) + lag + '). Нажмите для меню.';\\n      } catch (e) { return 'Связь — нажмите для меню'; }\\n    }\\n    function _depMenuEl() {\\n      let m = document.getElementById('depMenu');\\n      if (!m) {\\n        m = document.createElement('div');\\n        m.id = 'depMenu';\\n        m.className = 'hidden no-print no-image-export';\\n        m.style.cssText = 'position:fixed;z-index:2500;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 10px 30px rgba(15,23,42,.18);min-width:210px;max-width:280px;overflow:hidden';\\n        (document.body || document.documentElement).appendChild(m);\\n      }\\n      return m;\\n    }\\n    function closeDepMenu() { const m = document.getElementById('depMenu'); if (m) m.classList.add('hidden'); }\\n    function openDepMenu(predId, succId, x, y) {\\n      const pred = roadmapData.find(t => t.id === predId);\\n      const succ = roadmapData.find(t => t.id === succId);\\n      if (!pred || !succ) return;\\n      const di = _depInfo(succ, predId);\\n      const TL = { FS: 'Начать после окончания', SS: 'Начать вместе', FF: 'Закончить вместе', SF: 'Закончить после начала' };\\n      const lag = di.lag ? (', задержка ' + di.lag + ' дн') : '';\\n      const ro = (typeof READ_ONLY_MODE !== 'undefined' && READ_ONLY_MODE);\\n      const m = _depMenuEl();\\n      let html = '<div class=\\\"px-3 py-2 border-b border-slate-100\\\">'\\n        + '<div class=\\\"text-[10px] uppercase tracking-wider text-slate-400 font-semibold\\\">Связь</div>'\\n        + '<div class=\\\"text-xs font-medium text-slate-700 leading-snug mt-0.5\\\">' + escHtml(pred.name || '') + ' <span class=\\\"text-slate-400\\\">→</span> ' + escHtml(succ.name || '') + '</div>'\\n        + '<div class=\\\"text-[10px] text-slate-500 mt-1\\\">' + (TL[di.type] || di.type) + lag + '</div></div>';\\n      if (!ro) {\\n        html += '<button type=\\\"button\\\" onclick=\\\"closeDepMenu(); openModal(roadmapData.find(t=>t.id===' + succId + '))\\\" class=\\\"w-full text-left px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 flex items-center gap-2 cursor-pointer\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-3.5 h-3.5 text-slate-400 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-0985683e4c91\\\"></use></svg>Изменить тип и задержку</button>'\\n          + '<button type=\\\"button\\\" onclick=\\\"_removeDependency(' + succId + ',' + predId + ')\\\" class=\\\"w-full text-left px-3 py-2 text-xs font-medium text-rose-600 hover:bg-rose-50 flex items-center gap-2 cursor-pointer\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-3.5 h-3.5 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-995cbdc86b32\\\"></use></svg>Удалить связь</button>';\\n      }\\n      m.innerHTML = html;\\n      m.classList.remove('hidden');\\n      if (typeof syncBodyScrollLock === 'function') { /* поповер, не блокируем скролл */ }\\n      const mw = m.offsetWidth || 220, mh = m.offsetHeight || 120;\\n      let left = x + 6, top = y + 6;\\n      if (left + mw > window.innerWidth - 6) left = x - mw - 6;\\n      if (top + mh > window.innerHeight - 6) top = y - mh - 6;\\n      m.style.left = Math.max(6, left) + 'px'; m.style.top = Math.max(6, top) + 'px';\\n    }\\n    function _removeDependency(succId, predId) {\\n      if (typeof READ_ONLY_MODE !== 'undefined' && READ_ONLY_MODE) { closeDepMenu(); return; }\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) { closeDepMenu(); return; }\\n      const succ = roadmapData.find(t => t.id === succId); if (!succ) { closeDepMenu(); return; }\\n      const snap = (typeof captureUndoState === 'function') ? captureUndoState() : null;\\n      const ids = getPredecessorIds(succ).filter(id => id !== predId);\\n      succ.pred = ids.join(',');\\n      if (succ.depMeta) { delete succ.depMeta[predId]; if (!succ.pred || !Object.keys(succ.depMeta).length) delete succ.depMeta; }\\n      closeDepMenu();\\n      if (snap && typeof offerUndo === 'function') offerUndo('Связь удалена', snap);\\n      if (typeof renderRoadmap === 'function') renderRoadmap();\\n      if (typeof showToast === 'function') showToast('Связь удалена', 'ok', 2500);\\n    }\\n    document.addEventListener('click', (e) => { const m = document.getElementById('depMenu'); if (m && !m.classList.contains('hidden') && !m.contains(e.target)) closeDepMenu(); }, true);\\n    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const m = document.getElementById('depMenu'); if (m && !m.classList.contains('hidden')) closeDepMenu(); } });\\n\\n    const AVAILABLE_COLORS = [\\n      \\\"bg-slate-400\\\", \\\"bg-slate-500\\\", \\\"bg-slate-600\\\",\\n      \\\"bg-red-400\\\", \\\"bg-red-500\\\", \\\"bg-rose-500\\\",\\n      \\\"bg-orange-400\\\", \\\"bg-orange-500\\\", \\\"bg-amber-500\\\",\\n      \\\"bg-yellow-400\\\", \\\"bg-yellow-500\\\", \\\"bg-lime-500\\\",\\n      \\\"bg-green-400\\\", \\\"bg-green-500\\\", \\\"bg-emerald-500\\\",\\n      \\\"bg-teal-400\\\", \\\"bg-teal-500\\\", \\\"bg-cyan-500\\\",\\n      \\\"bg-sky-400\\\", \\\"bg-sky-500\\\", \\\"bg-blue-500\\\",\\n      \\\"bg-indigo-400\\\", \\\"bg-indigo-500\\\", \\\"bg-indigo-600\\\",\\n      \\\"bg-violet-400\\\", \\\"bg-violet-500\\\", \\\"bg-purple-500\\\",\\n      \\\"bg-fuchsia-400\\\", \\\"bg-fuchsia-500\\\", \\\"bg-pink-500\\\",\\n      // Приглушенные (пастельные) тона , для спокойной карты; текст автоматически темный\\n      \\\"bg-slate-300\\\", \\\"bg-rose-300\\\", \\\"bg-amber-300\\\", \\\"bg-emerald-300\\\", \\\"bg-teal-300\\\",\\n      \\\"bg-sky-300\\\", \\\"bg-blue-300\\\", \\\"bg-indigo-300\\\", \\\"bg-violet-300\\\", \\\"bg-pink-300\\\"\\n    ];\\n\\n    function openSectionColorModal(sectionName) {\\n      document.getElementById('editingSectionColorName').value = sectionName;\\n      { const _cn = document.getElementById('colorModalName'); if (_cn) _cn.innerText = `Цвет: ${sectionName}`; }\\n\\n      const grid = document.getElementById('colorGrid');\\n      const currentColor = (sectionColors[sectionName] || \\\"bg-indigo-500 text-white\\\").split(' ')[0];\\n      const _COLOR_RU = { slate:'Серый', gray:'Серый', red:'Красный', rose:'Розовый', orange:'Оранжевый', amber:'Янтарный', yellow:'Желтый', lime:'Лаймовый', green:'Зеленый', emerald:'Изумрудный', teal:'Бирюзовый', cyan:'Голубой', sky:'Небесный', blue:'Синий', indigo:'Индиго', violet:'Фиолетовый', purple:'Пурпурный', fuchsia:'Фуксия', pink:'Розовый' };\\n      const _colorRu = (cls) => { const mm = String(cls).match(/bg-([a-z]+)-(\\\\d+)/); return mm ? ((_COLOR_RU[mm[1]] || mm[1]) + ' ' + mm[2]) : 'Цвет'; };\\n\\n      grid.innerHTML = AVAILABLE_COLORS.map(c => `\\n        <button onclick=\\\"setSectionColor('${c}')\\\" aria-label=\\\"${_colorRu(c)}\\\" aria-pressed=\\\"${currentColor === c}\\\" title=\\\"${_colorRu(c)}\\\" class=\\\"w-10 h-10 rounded-full ${c} border-2 ${currentColor === c ? 'border-slate-800 scale-110 shadow-md' : 'border-transparent hover:scale-110'} transition-all cursor-pointer\\\"></button>\\n      `).join('');\\n\\n      document.getElementById('sectionColorModal').classList.remove('hidden');\\n    }\\n\\n    function closeSectionColorModal() {\\n      document.getElementById('sectionColorModal').classList.add('hidden');\\n    }\\n\\n    function setSectionColor(colorClass) {\\n      if (READ_ONLY_MODE) return;\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      const sectionName = document.getElementById('editingSectionColorName').value;\\n      // Светлые (пастельные) оттенки , темный текст для контраста; насыщенные , белый\\n      const shade = parseInt((colorClass.match(/-(\\\\d{2,3})$/) || [])[1] || '500', 10);\\n      const textClass = shade <= 300 ? 'text-slate-800' : 'text-white';\\n      sectionColors[sectionName] = `${colorClass} ${textClass}`;\\n      storage.set('gantt_section_colors', JSON.stringify(sectionColors));\\n      if (typeof scheduleAutoSaveFile === 'function') scheduleAutoSaveFile();\\n      closeSectionColorModal();\\n      renderRoadmap(true);\\n    }\\n\\n    function getTaskKey(task) {\\n      if (task.jira) {\\n        const m = String(task.jira).match(/([A-Z]+-\\\\d+)/);\\n        return m ? m[1] : '#' + String(task.id).slice(-4);\\n      }\\n      return '#' + String(task.id).slice(-4);\\n    }\\n    // Цвет иконки Jira по типу элемента: эпик , фиолетовый, стори , зеленый, сабтаск , голубой, остальное (таска/баг) , синий.\\n    function _issueTypeTone(issueType) {\\n      const t = String(issueType || '').trim().toLowerCase();\\n      if (/initiative|инициатив/.test(t)) return 'initiative';\\n      if (/epic|эпик/.test(t)) return 'epic';\\n      if (/story|истор|стори/.test(t)) return 'story';\\n      if (/sub.?task|подзад|сабтаск/.test(t)) return 'subtask';\\n      if (/bug|defect|баг|дефект|ошибк/.test(t)) return 'bug';\\n      if (/incident|инцидент/.test(t)) return 'incident';\\n      if (/hotfix|хотфикс/.test(t)) return 'hotfix';\\n      if (/research|исследован/.test(t)) return 'research';\\n      if (/веха|milestone/.test(t)) return 'initiative';\\n      if (/внешн|external/.test(t)) return 'external';\\n      if (/моя задача|своя/.test(t)) return 'local';\\n      if (/task|задач/.test(t)) return 'task';\\n      return 'other';\\n    }\\n    function jiraTypeColor(issueType) {\\n      const colors = {initiative:'#b45309',epic:'#7c3aed',story:'#16a3