return { start: daysToDate(minDays), end: daysToDate(maxDays), left: minDays * DAY_WIDTH, width: (maxDays - minDays + 1) * DAY_WIDTH };\\n    }\\n\\n    // Парсит поле task.pred в массив id-предшественников: \\\"123,456\\\" → [123, 456]\\n    function getPredecessorIds(task) {\\n      if (!task || !task.pred) return [];\\n      return String(task.pred).split(',').map(s => parseInt(s.trim(), 10)).filter(n => Number.isFinite(n));\\n    }\\n    // Сколько связей не получится нарисовать на таймлайне из-за отсутствия дат у задачи или ее предшественника\\n    // (без дат у задачи нет полоски, поэтому стрелке не к чему привязаться). Используется для подсказки после импорта.\\n    function countDeplessDepLinks() {\\n      try {\\n        const byId = new Map((roadmapData || []).map(t => [t && t.id, t]));\\n        const dated = t => t && (t.isMilestone ? !!t.start : !!(t.start && t.end));\\n        let n = 0;\\n        (roadmapData || []).forEach(task => {\\n          getPredecessorIds(task).forEach(pid => {\\n            const p = byId.get(pid);\\n            if (!p) return;\\n            if (!dated(task) || !dated(p)) n++;\\n          });\\n        });\\n        return n;\\n      } catch (e) { return 0; }\\n    }\\n    // Тип связи и лаг для пары (задача, предшественник). По умолчанию FS (конец-начало), лаг 0.\\n    let _editDepMeta = {};\\n    function _depInfo(task, predId) {\\n      const dm = (task && task.depMeta) || null;\\n      const v = dm ? dm[predId] : null;\\n      let type = 'FS', lag = 0;\\n      if (v) { if (['FS', 'SS', 'FF', 'SF'].indexOf(v.type) >= 0) type = v.type; const l = parseInt(v.lag, 10); if (Number.isFinite(l)) lag = l; }\\n      return { type: type, lag: lag };\\n    }\\n    function _cleanDepMeta(predStr) {\\n      const ids = String(predStr || '').split(',').map(s => parseInt(s.trim(), 10)).filter(n => Number.isFinite(n));\\n      const out = {};\\n      ids.forEach(id => { const v = _editDepMeta[id]; if (!v) return; const lag = parseInt(v.la