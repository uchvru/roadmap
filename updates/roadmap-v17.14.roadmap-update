cument.addEventListener('click', (e) => { const m = document.getElementById('depLinesMenu'); if (m && !m.classList.contains('hidden') && !e.target.closest('#depLinesMenu') && !e.target.closest('#depLinesToggle')) { m.classList.add('hidden'); const b = document.getElementById('depLinesToggle'); if (b) b.setAttribute('aria-expanded', 'false'); } });\\n    function updateDepLinesToggle() {\\n      const btn = document.getElementById('depLinesToggle');\\n      if (!btn) return;\\n      btn.classList.toggle('text-indigo-600', showDependencyLines);\\n      btn.classList.toggle('bg-indigo-50', showDependencyLines);\\n      btn.classList.toggle('text-slate-500', !showDependencyLines);\\n      btn.setAttribute('aria-pressed', showDependencyLines ? 'true' : 'false');\\n      btn.title = 'Связи задач: показ и стиль линий';\\n    }\\n    function toggleHiddenZone() {\\n      const collapsed = storage.get('gantt_hidden_zone_collapsed') !== '0';\\n      storage.set('gantt_hidden_zone_collapsed', collapsed ? '0' : '1');\\n      renderRoadmap(true);\\n    }\\n    // Переносит все скрытые задачи в «Архив задач»\\n    // Архивирует отдельные скрытые задачи (группа «Скрытые задачи»)\\n    function archiveHiddenTasks() {\\n      archiveTasksList(roadmapData.filter(t => t.hidden), 'скрытые задачи');\\n    }\\n    // Архивирует ВСЕ из раздела «Скрытые»: скрытые задачи + задачи скрытых секций, и убирает сами секции\\n    function archiveAllHidden() {\\n      const hiddenSet = new Set(hiddenSections);\\n      const list = roadmapData.filter(t => t.hidden || hiddenSet.has(t.section));\\n      archiveTasksList(list, 'все из «Скрытых»', [...hiddenSections]);\\n    }\\n    // Переносит секцию в «Архив»: задачи , в архив, саму секцию (как сущность) , убираем, даже если пустая\\n    function archiveSectionTasks(sectionName) {\\n      const direct = roadmapData.filter(t => t.section === sectionName);\\n      const children = (typeof _secDescendants === 'function') ? _secDescendants(sectionName) : [];\\n      if (!direct.length && !children.length) { deleteSection(sectionName); return; }\\n      if (!direct.length && children.length) {\\n        if (typeof showToast === 'function') showToast('Секция содержит вложенные секции. Архивируйте их задачи отдельно или удалите всё поддерево явно.', 'warn', 5000);\\n        return;\\n      }\\n      archiveTasksList(direct, `секцию «${cleanSectionName(sectionName)}»`, [sectionName]);\\n    }\\n    // Общая логика переноса в архив. forceRemoveSections , секции, которые надо убрать целиком (даже пустые).\\n    function _captureArchivedSectionPath(sectionName) {\\n      if (!sectionName) return [];\\n      const chain = [], seen = new Set();\\n      let current = sectionName;\\n      const clone = value => {\\n        if (value == null) return value;\\n        try { return JSON.parse(JSON.stringify(value)); } catch (_) { return value; }\\n      };\\n      while (current && !seen.has(current)) {\\n        seen.add(current);\\n        chain.unshift({\\n          name: current,\\n          parent: sectionParents[current] || '',\\n          color: sectionColors[current] || '',\\n          labels: clone(sectionLabels[current]),\\n          meta: clone(sectionMeta[current]),\\n          deps: clone(sectionDeps[current])\\n        });\\n        current = sectionParents[current] || '';\\n      }\\n      return chain;\\n    }\\n    function archiveTasksList(list, label, forceRemoveSections) {\\n      if (READ_ONLY_MODE) return;\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      list = Array.isArray(list) ? list : [];\\n      const force = Array.isArray(forceRemoveSections) ? forceRemoveSections : [];\\n      if (!list.length && !force.length) { if (typeof showToast === 'function') showToast('Нет задач для переноса', 'info'); return; }\\n      openConfirm({ title: 'Перенести в архив', desc: `Перенести в Архив: задач — ${list.length}${force.length ? `, секций — ${force.length}` : ''} (${label})?`, danger: false, okText: 'В архив', onOk: () => {\\n      const _undoSnap = captureUndoState();\\n      const ids = new Set(list.map(t => t.id));\\n      const affectedSections = new Set([...list.map(t => t.section).filter(Boolean), ...force]);\\n      const archivedAt = (typeof toYmdLocal === 'function') ? toYmdLocal((typeof CURRENT_DATE !== 'undefined' && CURRENT_DATE) ? CURRENT_DATE : new Date()) : '';\\n      roadmapData = roadmapData.filter(t => !ids.has(t.id));\\n      list.forEach(t => {\\n        delete t.hidden;\\n        if (t.section) t._archivedSectionPath = _captureArchivedSectionPath(t.section);\\n        if (archivedAt) t._archivedAt = archivedAt;\\n        archivedTasks.push(t);\\n      });\\n      // Убираем секции: принудительные , всегда; остальные , если опустели\\n      let removedSections = 0;\\n      const removedSectionNames = new Set();\\n      affectedSections.forEach(sec => {\\n        const forced = force.includes(sec);\\n        if (forced || !roadmapData.some(t => t.section === sec)) {\\n          planSections = planSections.filter(s => s !== sec);\\n          hiddenSections = hiddenSections.filter(s => s !== sec);\\n          collapsedSections = collapsedSections.filter(s => s !== sec);\\n          delete sectionColors[sec];\\n          removedSectionNames.add(sec);\\n          removedSections++;\\n        }\\n      });\\n      // Не оставляем детей со ссылкой на удаленного родителя: они становятся корневыми секциями.\\n      _rememberRemovedJiraKeys([...removedSectionNames].map(jiraSectionKey));\\n      removedSectionNames.forEach(sec => { delete sectionParents[sec]; });\\n      Object.keys(sectionParents || {}).forEach(child => { if (removedSectionNames.has(sectionParents[child])) delete sectionParents[child]; });\\n      persistPlan({ undo: true, before: _undoSnap });\\n      storage.set('gantt_archived_tasks', JSON.stringify(archivedTasks));\\n      storage.set('gantt_sections_list', JSON.stringify(planSections));\\n      storage.set('gantt_hidden_sections', JSON.stringify(hiddenSections));\\n      storage.set('gantt_collapsed_sections', JSON.stringify(collapsedSections));\\n      storage.set('gantt_section_colors', JSON.stringify(sectionColors));\\n      storage.set('gantt_section_parents', JSON.stringify(sectionParents));\\n      recordProjectAudit('archive', 'Перенесено в архив: задач ' + list.length + (removedSections ? ', секций ' + removedSections : ''), { taskIds: Array.from(ids).slice(0, 50) });\\n      updateArchiveBadge();\\n      updateSectionSelects();\\n      renderRoadmap();\\n      offerUndo(`В архив: задач ${list.length}${removedSections ? `, секций ${removedSections}` : ''}`, _undoSnap);\\n      }});\\n    }\\n\\n    // Тоггл статуса в мультивыборе. 'all' = сбросить все статусы.\\n    function setStatusFilter(val) {\\n      if (val === 'all') {\\n        statusFilterSel.clear();\\n      } else {\\n        if (statusFilterSel.has(val)) statusFilterSel.delete(val);\\n        else statusFilterSel.add(val);\\n      }\\n      afterFilterChange();\\n    }\\n\\n    // Круговой индикатор % готовности с числом в центре\\n    // Индикатор готовности: компактное кольцо + текст «25% (1/14)». Не растягивает строку.\\n    // opts.frac === false , показать только процент (например, в чипе «Все», где счетчик уже рядом).\\n    function donutHtml(pct, doneN, total, size, opts) {\\n      opts = opts || {};\\n      const sz = Math.min(size || 22, 22);   // кольцо небольшое, фиксированной высоты\\n      pct = Math.max(0, Math.round(pct || 0)); if (pct >= 100 && Number(doneN) < Number(total)) pct = 99;\\n      const done = pct >= 100;\\n      const shown = Math.min(100, pct);\\n      const cx = sz / 2;\\n      const sw = Math.max(2.5, sz * 0.17);\\n      const r = (sz / 2) - sw / 2 - 0.5;\\n      const c = 2 * Math.PI * r;\\n      const off = c * (1 - shown / 100);\\n      const arc = done ? '#10b981' : (pct > 0 ? '#4f46e5' : '#cbd5e1');\\n      const pctCol = done ? 'var(--donut-pct-done,#047857)' : 'var(--donut-pct,#334155)';\\n      const title = `Готово ${doneN} из ${total} (${pct}%)`;\\n      const ring = `<svg aria-hidden=\\\"true\\\" width=\\\"${sz}\\\" height=\\\"${sz}\\\" viewBox=\\\"0 0 ${sz} ${sz}\\\" style=\\\"transform:rotate(-90deg);display:var(--rm-progress-ring-display,block);flex:none\\\">`\\n        + `<circle cx=\\\"${cx}\\\" cy=\\\"${cx}\\\" r=\\\"${r}\\\" fill=\\\"none\\\" style=\\\"stroke:var(--donut-track,#e2e8f0)\\\" stroke-width=\\\"${sw}\\\"/>`\\n        + `<circle cx=\\\"${cx}\\\" cy=\\\"${cx}\\\" r=\\\"${r}\\\" fill=\\\"none\\\" stroke=\\\"${arc}\\\" stroke-width=\\\"${sw}\\\" stroke-linecap=\\\"round\\\" stroke-dasharray=\\\"${c.toFixed(1)}\\\" stroke-dashoffset=\\\"${off.toFixed(1)}\\\"/></svg>`;\\n      const frac = (opts.frac === false) ? '' : ` <span class=\\\"tabular-nums\\\" style=\\\"font-size:var(--rm-font-xs,12px);line-height:1.3;color:var(--donut-frac,#64748b);font-weight:500\\\">(${doneN}/${total})</span>`;\\n      return `<span role=\\\"img\\\" aria-label=\\\"${title}\\\" class=\\\"shrink-0 inline-flex items-center gap-1.5 align-middle whitespace-nowrap\\\" title=\\\"${title}\\\">${ring}<span class=\\\"leading-none\\\"><span class=\\\"tabular-nums\\\" style=\\\"font-size:12px;font-weight:700;color:${pctCol}\\\">${pct}%</span>${frac}</span></span>`;\\n    }\\n    // R1: компактный дашборд состояния проекта. Числа ГЛОБАЛЬНЫЕ (по всем задачам, не по фильтру) ,\\n    // это стабильное «состояние проекта». Пересчет на каждый renderRoadmap, O(задач), под try/catch.\\n    function renderStateDashboard() {\\n      { const _vc = document.getElementById('appVerChip'); if (_vc && typeof APP_VERSION !== 'undefined') _vc.textContent = 'v' + APP_VERSION; } if (typeof _renderSaveBadge === 'function') _renderSaveBadge();\\n      const box = document.getElementById('stateDashboard');\\n      if (!box) return;\\n      try {\\n        const tasks = (roadmapData || []).filter(t => t && !t.hidden && !t.isMilestone);\\n        const total = tasks.length;\\n        const inProg = tasks.filter(t => !isFinalStatus(t.status) && getStatusGroup(t.status) === 'in_progress').length;\\n        const overdue = tasks.filter(t => {\\n          if (!isAttentionActiveTask(t) || !t.end) return false;\\n          try { return parseLocalDate(t.end) < CURRENT_DATE; } catch (e) { return false; }\\n        }).length;\\n        const done = tasks.filter(t => isFinalStatus(t.status)).length;\\n        const pct = total ? Math.round(done / total * 100) : 0;\\n        const headline = document.getElementById('headerStateHeadline');\\n        const headlineText = !total\\n          ? 'В плане пока нет задач'\\n          : overdue\\n            ? 'Нужно внимание: ' + overdue + ' просрочено'\\n            : 'План без просроченных задач';\\n        if (headline) headline.textContent = headlineText;\\n        const metric = (label, value, context, tone) => `<div data-plan-state-metric${tone ? ` data-plan-state-tone=\\\"${tone}\\\"` : ''}><span class=\\\"plan-state-value\\\">${value}</span><span class=\\\"plan-state-label\\\">${label}${context ? ` <span class=\\\"plan-state-context\\\">${context}</span>` : ''}</span></div>`;\\n        box.innerHTML = [\\n          metric('Готово', pct + '%', done + ' из ' + total, ''),\\n          metric('В работе', inProg, '', ''),\\n          metric('Просрочено', overdue, overdue ? 'требуют внимания' : 'нет', overdue ? 'danger' : '')\\n        ].join('');\\n        box.setAttribute('aria-label', headlineText + '. Готово ' + done + ' из ' + total + ', в работе ' + inProg + ', просрочено ' + overdue + '.');\\n      } catch (e) {\\n        try {\\n          box.innerHTML = '';\\n          const headline = document.getElementById('headerStateHeadline');\\n          if (headline) headline.textContent = '';\\n        } catch (x) {}\\n      }\\n    }\\n    function activeFilterToolCount() {\\n      let n = 0;\\n      if (_boardTaskFilter) n++;\\n      n += typeFilterSel.size;\\n      try { n += projectFilterSel.size + resourceFilterSel.size + releaseFilterSel.size + labelFilterSel.size + componentFilterSel.size; } catch (e) {}\\n      try { n += _cfActiveFieldCount(); } catch (e) {}\\n      try { if (_goritMode) n++; } catch (e) {}\\n      try { if (_critPathMode) n++; } catch (e) {}\\n      try { if (_mineMode) n++; } catch (e) {}\\n      try { if (_kindFilter) n++; } catch (e) {}\\n      try { if (_noGoalFilter) n++; } catch (e) {}\\n      try { if (_forecastReasonFilter) n++; } catch (e) {}\\n      return n;\\n    }\\n    function activeFilterSummaries() {\\n      const items = [];\\n      if (_boardTaskFilter) items.push('Холст: ' + (_boardTaskFilter === 'on' ? 'На доске' : 'Не на доске'));\\n      const addSelection = (label, set, labelId) => {\\n        if (!set || !set.size) return;\\n        const labelEl = labelId ? document.getElementById(labelId) : null;\\n        const visible = labelEl && labelEl.textContent ? labelEl.textContent.trim() : '';\\n        const values = Array.from(set).map(String).filter(Boolean);\\n        items.push(label + ': ' + (visible && !/^Все\\\\s/i.test(visible) ? visible : (values.length === 1 ? values[0] : values.length)));\\n      };\\n      try { addSelection('Проект', projectFilterSel, 'projectFilterLabel'); } catch (e) {}\\n      addSelection('Тип', typeFilterSel, 'typeFilterLabel');\\n      try { addSelection('Исполнитель', resourceFilterSel, 'resourceFilterLabel'); } catch (e) {}\\n      try { addSelection('Релиз', releaseFilterSel); } catch (e) {}\\n      try { addSelection('Метка', labelFilterSel); } catch (e) {}\\n      try { addSelection('Компонент', componentFilterSel); } catch (e) {}\\n      try { const n = _cfActiveFieldCount(); if (n) items.push('Свои поля: ' + n); } catch (e) {}\\n      try { if (_goritMode) items.push('Горящее'); } catch (e) {}\\n      try { if (_critPathMode) items.push('Критический путь'); } catch (e) {}\\n      try { if (_mineMode) items.push('Мои задачи'); } catch (e) {}\\n      try { 