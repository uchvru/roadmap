.classList.add('text-slate-600'); }\\n    }\\n    // R4: встроенный стартовый шаблон сводки «Маркетинг» (генерируется, не хранится в файле, ключ с «#»).\\n    // Прячет финансовые блоки (деньги, slip по версии плана) , для внешних/маркетинговых получателей.\\n    const REPORT_BUILTIN_PROFILES = {\\n      '#Маркетинг': { label: 'Маркетинг', blocks: { title: true, summary: true, statuses: true, releases: true, attention: true, milestones: true, rag: true, slip: false, money: false, custom: false } }\\n    };\\n    function renderReportProfiles(selected) {\\n      const sel = document.getElementById('rbProfileSel'); if (!sel) return;\\n      const names = Object.keys(reportProfiles || {}).sort((a, b) => a.localeCompare(b, 'ru'));\\n      let html = '<option value=\\\"\\\">(без профиля)</option>';\\n      html += '<optgroup label=\\\"Встроенные\\\">' + Object.keys(REPORT_BUILTIN_PROFILES).map(k => `<option value=\\\"${escAttr(k)}\\\">${escHtml(REPORT_BUILTIN_PROFILES[k].label)}</option>`).join('') + '</optgroup>';\\n      if (names.length) html += '<optgroup label=\\\"Мои профили\\\">' + names.map(n => `<option value=\\\"${escAttr(n)}\\\">${escHtml(n)}</option>`).join('') + '</optgroup>';\\n      sel.innerHTML = html;\\n      if (selected && (names.includes(selected) || REPORT_BUILTIN_PROFILES[selected])) sel.value = selected;\\n    }\\n    function applyReportProfile() {\\n      const sel = document.getElementById('rbProfileSel'); if (!sel || !sel.value) return;\\n      const p = REPORT_BUILTIN_PROFILES[sel.value] || (reportProfiles || {})[sel.value];\\n      if (p && p.blocks) _rbSetChecks(p.blocks);\\n    }\\n    function saveReportProfile() {\\n      if (typeof requireUnlocked === 'function' && !requireUnlocked()) return;\\n      const cfg = _rbCollectCfg();\\n      openInputModal({ title: 'Сохранить как профиль', desc: 'Текущий набор блоков сводки сохранится под этим именем — удобно держать разные наборы для разных получателей.', placeholder: 'Например: Для CEO', o