ch(e => { lines.push('  ' + e.at + (e.time ? ' ' + e.time : '') + (e.by ? ' [' + e.by + ']' : '') + '  ' + e.txt); count++; });\\n        lines.push('');\\n      });\\n      lines.push('Всего записей: ' + count);\\n      return lines.join('\\\\n');\\n    }\\n    function copyAuditLog() {\\n      const txt = buildAuditLogText();\\n      const done = () => { if (typeof showToast === 'function') showToast('Журнал изменений скопирован', 'ok'); };\\n      if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(txt).then(done).catch(() => { if (typeof fallbackCopy === 'function') fallbackCopy(txt, done); else done(); }); }\\n      else if (typeof fallbackCopy === 'function') fallbackCopy(txt, done); else done();\\n    }\\n    // Уникальные авторы записей истории и статусов , для фильтра выгрузки CSV\\n    function _auditAuthors() {\\n      const set = new Set();\\n      (roadmapData || []).forEach(t => {\\n        if (!t) return;\\n        (Array.isArray(t.history) ? t.history : []).concat(Array.isArray(t.statusLog) ? t.statusLog : []).forEach(e => { const b = String((e && e.by) || '').trim(); if (b) set.add(b); });\\n      });\\n      return Array.from(set).sort((x, y) => x.localeCompare(y, 'ru'));\\n    }\\n    // CSV истории правок всех задач. Фильтры: автор (точное совпадение) и период по дате записи, границы включительно.\\n    // Возвращает строку CSV (первая строка , заголовок), каждая ячейка через jiraCsvCell.\\n    function _buildAuditCsv(author, from, to) {\\n      const rows = [];\\n      (roadmapData || []).forEach(t => {\\n        if (!t) return;\\n        const taskName = ((typeof getTaskKey === 'function' && getTaskKey(t)) ? getTaskKey(t) + ' ' : '') + (t.name || '');\\n        (Array.isArray(t.statusLog) ? t.statusLog : []).forEach(e => { if (!e) return; rows.push({ at: e.at || '', time: e.time || '', by: e.by || '', task: taskName, field: 'Статус', old: e.from ? statusNameById(e.from) : 'нет', nw: e.to ? statusNameById(e.