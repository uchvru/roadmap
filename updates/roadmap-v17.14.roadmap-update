n    // Слайд для руководства в один клик: временно скрываем технические модули, включаем презентацию и обзор,\\n    // режем кадр под 16:9 и отдаем PNG. featureFlags и пользовательские настройки не меняем; togglePresentationMode\\n    // временно пишет gantt_collapsed_sections, но в finally восстанавливает исходное значение. Только вид, через try/finally.\\n    async function buildLeadershipSlide(consent, exportTheme) {\\n      if (!_ensureExportTheme(exportTheme, choice => buildLeadershipSlide(consent, choice))) return;\\n      if (!_confirmWorkingExport('slide', consent, signature => buildLeadershipSlide(signature, exportTheme))) return;\\n      const wasPres = isPresentationMode();\\n      const wasCompact = isCompactOverview();\\n      const _added = [];\\n      try {\\n        FEATURE_KEYS.forEach(k => { if (!document.body.classList.contains('feat-off-' + k)) { document.body.classList.add('feat-off-' + k); _added.push(k); } });\\n        if (!wasPres) togglePresentationMode();\\n        if (!wasCompact) setCompactOverview(true, { skipPref: true });\\n        document.body.classList.add('slide-16x9');\\n        _slide16x9 = true;\\n        await exportToPng(exportTheme);\\n      } catch (e) {\\n        if (typeof showToast === 'function') showToast('Не удалось собрать слайд', 'error', 4000);\\n      } finally {\\n        _slide16x9 = false;\\n        document.body.classList.remove('slide-16x9');\\n        _added.forEach(k => document.body.classList.remove('feat-off-' + k));\\n        if (!wasCompact) setCompactOverview(false, { skipPref: true });\\n        if (!wasPres) togglePresentationMode();\\n      }\\n    }\\n    function isCompactOverview() { return document.body.classList.contains('compact-overview'); }\\n    function setCompactOverview(on, opts) {\\n      on = !!on;\\n      document.body.classList.toggle('compact-overview', on);\\n      const b = document.getElementById('overviewToggleBtn');\\n      if (b) {\\n        b.setAttribute('aria-pressed', on 