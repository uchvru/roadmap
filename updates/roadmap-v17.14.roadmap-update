e) {\\n      const idx = planSections.indexOf(sectionName);\\n      const hIdx = (hiddenSections || []).indexOf(sectionName);\\n      if (idx === -1 && hIdx === -1) return false;\\n      if (idx > -1) planSections[idx] = value;\\n      if (hIdx > -1) hiddenSections[hIdx] = value;\\n      roadmapData.forEach(t => { if (t.section === sectionName) t.section = value; });\\n      (archivedTasks || []).forEach(t => { if (t && t.section === sectionName) t.section = value; });\\n      const collIdx = collapsedSections.indexOf(sectionName);\\n      if (collIdx > -1) { collapsedSections[collIdx] = value; }\\n      [sectionColors, sectionMeta, sectionLabels].forEach(map => { if (map && map[sectionName] !== undefined) { map[value] = map[sectionName]; delete map[sectionName]; } });\\n      if (sectionParents[sectionName] !== undefined) { sectionParents[value] = sectionParents[sectionName]; delete sectionParents[sectionName]; }\\n      Object.keys(sectionParents).forEach(k => { if (sectionParents[k] === sectionName) sectionParents[k] = value; });\\n      // Название в метаданных следует за новым именем секции.\\n      if (sectionMeta[value] && typeof sectionMeta[value] === 'object' && sectionMeta[value].title) sectionMeta[value].title = (typeof cleanSectionName === 'function') ? cleanSectionName(value) : value;\\n      persistProjectState();\\n      return true;\\n    }\\n\\n    function deleteSection(sectionName) {\\n      if (!requireUnlocked()) return; // замок: не удаляем секцию при блокировке\\n      const tasksInSection = roadmapData.filter(t => t.section === sectionName);\\n      const msg = tasksInSection.length > 0\\n        ? `Удалить секцию «${sectionName}» и ВСЕ задачи внутри нее (${tasksInSection.length} шт.)?\\\\n\\\\nСразу после можно отменить кнопкой «Отменить».`\\n        : `Удалить пустую секцию «${sectionName}»?`;\\n\\n      openConfirm({ title: 'Удалить секцию', desc: msg, okText: 'Удалить', onOk: () => {\\n        const _undoSnap = captureUndoState();\\n        const deletedIds = new Set(tasksInSection.map(t => t.id));\\n        _rememberRemovedJiraKeys(tasksInSection.map(t => t.jira).concat(jiraSectionKey(sectionName)));\\n        roadmapData = roadmapData.filter(t => t.section !== sectionName);\\n        planSections = planSections.filter(s => s !== sectionName);\\n        collapsedSections = collapsedSections.filter(s => s !== sectionName);\\n        // Вложенность: убираем саму секцию и ссылки детей на нее, чтобы висячие записи не попадали в снимки и выгрузки\\n        delete sectionParents[sectionName];\\n        Object.keys(sectionParents).forEach(k => { if (sectionParents[k] === sectionName) delete sectionParents[k]; });\\n        storage.set('gantt_section_parents', JSON.stringify(sectionParents));\\n        // Чистим связанные «дедлайн»-отсечки удаленных задач\\n        customCutoffs = customCutoffs.filter(c => !c.linkedTaskId || !deletedIds.has(c.linkedTaskId));\\n        // Чистим ссылки на удаленные задачи из pred других задач\\n        roadmapData.forEach(t => {\\n          if (!t.pred) return;\\n          const ids = String(t.pred).split(',').map(s => parseInt(s.trim(), 10)).filter(n => Number.isFinite(n) && !deletedIds.has(n));\\n          t.pred = ids.join(',');\\n          if (t.depMeta) { deletedIds.forEach(dId => { delete t.depMeta[dId]; }); if (!t.pred || !Object.keys(t.depMeta).length) delete t.depMeta; }\\n        });\\n        storage.set('gantt_custom_cutoffs', JSON.stringify(customCutoffs));\\n        persistPlan({ undo: true, before: _undoSnap });\\n        storage.set('gantt_sections_list', JSON.stringify(planSections));\\n        storage.set('gantt_collapsed_sections', JSON.stringify(collapsedSections));\\n        updateSectionSelects();\\n        renderRoadmap();\\n        offerUndo(`Секция «${sectionName}» удалена`, _undoSnap);\\n      }});\\n    }\\n\\n    function moveSection(sectionName, dir) {\\n      if (READ_ONLY_MODE) return;\\n      if (typeof requireUnlocked === 'function' && !requ