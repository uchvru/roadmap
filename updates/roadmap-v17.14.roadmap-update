'Versions', 'fixVersions'];\\n    // Сопоставление колонки релиза без учета регистра и пробелов , Jira отдает разные варианты\\n    // (\\\"Fix Version/s\\\", \\\"Fix versions\\\", в т.ч. с .1/.2 для нескольких значений). Это и чинит подтягивание (п.12).\\n    // Разворачиваем обертки Jira: \\\"Custom field (Fix versions)\\\" / \\\"Пользовательское поле (Fix versions)\\\" -> \\\"fix versions\\\"\\n    function _unwrapJiraCol(col) {\\n      let c = String(col || '').toLowerCase().trim();\\n      const m = c.match(/^(?:custom field|пользовательское поле)\\\\s*\\\\((.+)\\\\)$/);\\n      if (m) c = m[1].trim();\\n      return c;\\n    }\\n    // Только числовой суффикс \\\".N\\\" (мультизначные колонки Jira), а не любой текст после точки,\\n    // иначе ключ \\\"Версия\\\" ловит колонку даты \\\"Версия. Дата выпуска\\\".\\n    function _relNumSuffix(c, base) { return c.startsWith(base + '.') && /^\\\\d+$/.test(c.slice(base.length + 1)); }\\n    function isReleaseCol(col) {\\n      const c = _unwrapJiraCol(col);\\n      return RELEASE_COL_KEYS.some(k => { const kl = k.toLowerCase(); return c === kl || c === kl + '/s' || _relNumSuffix(c, kl) || _relNumSuffix(c, kl + '/s'); });\\n    }\\n    let RELEASE_DATE_KEYS = ['Дата релиза', 'Release Date', 'Версия , дата', 'Версия. Дата выпуска'];\\n    // Колонка даты релиза , в т.ч. в обертке «Пользовательское поле (Дата релиза)»\\n    function isReleaseDateCol(col) {\\n      const c = _unwrapJiraCol(col);\\n      return RELEASE_DATE_KEYS.some(k => { const kl = k.toLowerCase(); return c === kl || _relNumSuffix(c, kl); });\\n    }\\n    let LABEL_COL_KEYS = ['Метки', 'Метка', 'Labels', 'Label'];\\n    // Метки (Labels) задачи/эпика из Jira , Jira отдает их несколькими колонками «Метки» / «Метки.1» / «Labels»\\n    function getJiraLabels(issue) {\\n      const out = [];\\n      Object.keys(issue || {}).forEach(col => {\\n        if (LABEL_COL_KEYS.some(k => col === k || col.startsWith(k + '.'))) {\\n          String(issue[col] || '').split(/[;,]+/).map(s => s.trim()).filter(Boolean)\\n            .forEach(v => { if (!out.includes(v)) out.push(v); });\\n        }\\n      });\\n      return out;\\n    }\\n    let COMPONENT_COL_KEYS = ['Компоненты', 'Компонент', 'Components', 'Component'];\\n    // Колонки дат начала/окончания (п.1: даты из выгрузок Jira). Реальные плановые даты , выше, 'Создано'/'Обновлено' , последний фолбэк.\\n    let START_COL_KEYS = ['Пользовательское поле (Planned Start)', 'Пользовательское поле (Start date)', 'Пользовательское поле (Target start)', 'Запланированная дата начала', 'Плановая дата начала', 'Дата начала', 'Дата начала работ', 'Целевая дата начала', 'Planned Start', 'Target start', 'Start date', 'Custom field (Start date)', 'Custom field (Target start)'];\\n    let END_COL_KEYS = ['Пользовательское поле (Planned End)', 'Пользовательское поле (End date)', 'Пользовательское поле (Target end)', 'Запланированная дата завершения', 'Плановая дата завершения', 'Дата окончания', 'Дата завершения', 'Целевая дата завершения', 'Целевая дата', 'Срок исполнения', 'Planned End', 'Target end', 'Due date', 'Custom field (Due date)', 'Custom field (Target end)'];\\n    let RESOLVED_COL_KEYS = ['Дата разрешения', 'Дата решения', 'Resolved', 'Resolution date', 'Resolution Date', 'Дата закрытия', 'Resolved date', 'Resolved Date'];\\n    let UPDATED_COL_KEYS = ['Обновлено', 'Updated', 'Дата обновления', 'Updated date', 'Updated Date'];\\n    // Конфигурируемый маппинг колонок Jira (п.8): свои названия дополняют встроенные, не заменяя.\\n    const _DEF_RELEASE_COL_KEYS = RELEASE_COL_KEYS.slice(), _DEF_RELEASE_DATE_KEYS = RELEASE_DATE_KEYS.slice(), _DEF_LABEL_COL_KEYS = LABEL_COL_KEYS.slice(), _DEF_COMPONENT_COL_KEYS = COMPONENT_COL_KEYS.slice(), _DEF_START_COL_KEYS = START_COL_KEYS.slice(), _DEF_END_COL_KEYS = END_COL_KEYS.slice();\\n    function _getJiraColMap() { try { const m = JSON.parse(storage.get('gantt_jira_colmap') || '{}'); return (m && typeof m === 'object' && !Array.isArray(m)) ? m : {}; } catch (e) { return {}; } }\\n    function applyJiraColMap() {\\n      const m = _getJiraColMap();\\n      const merge = (def, extra) => (Array.isArray(extra) ? extra.filter(Boolean) : []).concat(def);\\n      RELEASE_COL_KEYS = merge(_DEF_RELEASE_COL_KEYS, m.release);\\n      RELEASE_DATE_KEYS = merge(_DEF_RELEASE_DATE_KEYS, m.releaseDate);\\n      LABEL_COL_KEYS = merge(_DEF_LABEL_COL_KEYS, m.label);\\n      COMPONENT_COL_KEYS = merge(_DEF_COMPONENT_COL_KEYS, m.component);\\n      START_COL_KEYS = merge(_DEF_START_COL_KEYS, m.startDate);\\n      END_COL_KEYS = merge(_DEF_END_COL_KEYS, m.endDate);\\n    }\\n    applyJiraColMap();\\n    function loadJiraColMapInputs() {\\n      const m = _getJiraColMap();\\n      const set = (id, arr) => { const el = document.getElementById(id); if (el) el.value = Array.isArray(arr) ? arr.join(', ') : ''; };\\n      set('colmapRelease', m.release); set('colmapReleaseDate', m.releaseDate); set('colmapLabel', m.label); set('colmapComponent', m.component); set('colmapStart', m.startDate); set('colmapEnd', m.endDate);\\n    }\\n    // === Профили маппинга колонок Jira (B3): несколько наборов под разные выгрузки, едут вместе с файлом проекта ===\\n    const JIRA_MAP_PROFILES_MAX = 10;\\n    function renderJiraMapProfileSel(selected) {\\n      const sel = document.getElementById('jiraMapProfileSel'); if (!sel) return;\\n      const names = Object.keys(jiraMapProfiles || {}).sort((a, b) => a.localeCompare(b, 'ru'));\\n      sel.innerHTML = '<option value=\\\"\\\">Без профиля</option>' + names.map(n => `<option value=\\\"${escAttr(n)}\\\">${escHtml(n)}</option>`).join('');\\n      sel.value = (selected && jiraMapProfiles[selected]) ? selected : '';\\n      const del = document.getElementById('jiraMapProfileDelBtn'); if (del) del.classList.toggle('hidden', !sel.value);\\n    }\\n\\n    // Компоненты задачи из Jira (п.3): несколько колонок «Компоненты» / «Компоненты.1» / «Components». Не режем по пробелу , имена бывают из не