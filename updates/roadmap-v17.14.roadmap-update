rm-icon-701da9708dea\\\"></use></svg><h5 class=\\\"min-w-0 font-semibold text-slate-800 text-sm\\\">Понятный выбор перед отправкой</h5><span class=\\\"info-release-badge\\\">ВСТРЕЧА</span></div>\\n      <p class=\\\"text-xs text-slate-600\\\">В «Данные → Поделиться» выберите просмотр, материалы встречи или полную копию. Состав и защита объяснены до сохранения.</p>\\n     </article>\\n     <article data-release-card=\\\"week-start\\\" class=\\\"info-release-card bg-white rn-card border-slate-200 shadow-sm\\\">\\n      <div class=\\\"info-release-card-heading flex flex-wrap items-center gap-2 mb-2\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-5 h-5 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-44300be95ba1\\\"></use></svg><h5 class=\\\"min-w-0 font-semibold text-slate-800 text-sm\\\">Три масштаба вместо длинного меню</h5><span class=\\\"info-release-badge\\\">ГАНТ</span></div>\\n      <p class=\\\"text-xs text-slate-600\\\">Рабочий план открывает текущую неделю. В меню оставлены «По дням», «Неделя» и «Месяц».</p>\\n     </article>\\n     <article data-release-card=\\\"jira-import-memory\\\" class=\\\"info-release-card bg-white rn-card border-slate-200 shadow-sm\\\">\\n      <div class=\\\"info-release-card-heading flex flex-wrap items-center gap-2 mb-2\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-5 h-5 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-42d3667a6b05\\\"></use></svg><h5 class=\\\"min-w-0 font-semibold text-slate-800 text-sm\\\">Статусы и фильтры рядом</h5><span class=\\\"info-release-badge\\\">ИМПОРТ</span></div>\\n      <p class=\\\"text-xs text-slate-600\\\">Выбирайте статусы в одном меню. Активные фильтры видны под панелью и снимаются по одному.</p>\\n     </article>\\n     <article data-release-card=\\\"compact-working-file\\\" class=\\\"info-release-card bg-white rn-card border-slate-200 shadow-sm\\\">\\n      <div class=\\\"info-release-card-heading flex flex-wrap items-center gap-2 mb-2\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-5 h-5 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-aa77f2f6a793\\\"></use></svg><h5 class=\\\"min-w-0 font-semibold text-slate-800 text-sm\\\">Больше места для задач</h5><span class=\\\"info-release-badge\\\">HTML</span></div>\\n      <p class=\\\"text-xs text-slate-600\\\">Уменьшены пустые отступы над планом, высота секций и правый край строк. Действия с задачами сохранены.</p>\\n     </article>\\n    </div>\\n   </div>\\n   <div class=\\\"info-release-previous\\\">\\n    <h4 class=\\\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 px-1\\\">Что было в v17.1</h4>\\n    <div class=\\\"info-release-grid grid gap-3 mb-6\\\">\\n     <article data-release-card=\\\"product-areas\\\" class=\\\"info-release-card bg-white rn-card border-slate-200 shadow-sm\\\">\\n      <div class=\\\"info-release-card-heading flex flex-wrap items-center gap-2 mb-2\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-5 h-5 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-856204d3b075\\\"></use></svg><h5 class=\\\"min-w-0 font-semibold text-slate-800 text-sm\\\">Три раздела вместо длинного меню</h5><span class=\\\"info-release-badge\\\">НАВИГАЦИЯ</span></div>\\n      <p class=\\\"text-xs text-slate-600\\\">Откройте «План», «Сроки и риски» или «Для встречи». Дополнительные функции включаются отдельно.</p>\\n     </article>\\n     <article data-release-card=\\\"working-file-save\\\" class=\\\"info-release-card bg-white rn-card border-slate-200 shadow-sm\\\">\\n      <div class=\\\"info-release-card-heading flex flex-wrap items-center gap-2 mb-2\\\"><svg aria-hidden=\\\"true\\\" class=\\\"w-5 h-5 shrink-0\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><use href=\\\"#rm-icon-3da299aab65d\\\"></use></svg><h5 class=\\\"min-w-0 font-se