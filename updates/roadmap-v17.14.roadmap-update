  function statusNameById(sid) { const s = (projectStatuses || []).find(x => x.id === sid); return s ? s.name : (sid || '-'); }\\n    function renderTaskStatusHistory(task) {\\n      const el = document.getElementById('taskStatusHistory');\\n      if (!el) return;\\n      const log = (task && task.statusLog) || [];\\n      if (!log.length) { el.innerHTML = '<div class=\\\"text-[10px] text-slate-500 italic\\\">Изменений статуса пока нет</div>'; return; }\\n      el.innerHTML = log.slice().reverse().slice(0, 12).map(e => `<div class=\\\"flex items-center gap-1.5 text-[10px]\\\"><span class=\\\"text-slate-500 tabular-nums shrink-0\\\">${escHtml(e.at)}</span><span class=\\\"text-slate-500\\\">${escHtml(statusNameById(e.from))} →</span><span class=\\\"font-medium text-slate-700\\\">${escHtml(statusNameById(e.to))}</span></div>`).join('') + (log.length > 12 ? '<div class=\\\"text-[10px] text-slate-400 italic mt-1\\\">Показаны последние 12 из ' + log.length + '. Полная история — в выгрузке CSV.</div>' : '');\\n    }\\n    function _authorName() { try { return (storage.get('gantt_author') || '').trim(); } catch (e) { return ''; } }\\n    let _lastSavedAt = '', _lastSavedBy = '';\\n    function _relTimeRu(iso) { return RoadmapModules.dateRelativeTime(iso, Date.now()); }\\n    function _setSaveMeta(by, at) { _lastSavedBy = (by == null ? '' : String(by)); _lastSavedAt = (at == null ? '' : String(at)); if (typeof _renderSaveBadge === 'function') _renderSaveBadge(); }\\n    function _renderSaveBadge() {\\n      const el = document.getElementById('autosaveStatus');\\n      if (!el || (typeof autoSaveFileHandle !== 'undefined' && autoSaveFileHandle)) return;\\n      if (!_lastSavedAt && !_lastSavedBy) { el.textContent = ''; return; }\\n      const rel = _relTimeRu(_lastSavedAt);\\n      const shortText = 'Сохранил: ' + (_lastSavedBy || 'не указан') + (rel ? ' · ' + rel : '');\\n      el.className = ''; el.dataset.tone = 'muted'; el.textContent = shortText;\\n      el.title = 'Кто 