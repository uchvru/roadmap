el) return;\\n      const cur = sel.value;\\n      const byGoal = {}; (typeof projectGoals !== 'undefined' ? projectGoals : []).forEach(g => { if (g && g.id) byGoal[g.id] = g; });\\n      let opts = '<option value=\\\"\\\">Без инициативы</option>';\\n      const _inits = (typeof projectInitiatives !== 'undefined' ? projectInitiatives : []).filter(it => it && it.id);\\n      if (!_inits.length) { opts += '<option value=\\\"\\\" disabled>Инициатив пока нет — создайте в «Цели и инициативы»</option>'; }\\n      _inits.forEach(it => { const g = byGoal[it.goalId]; const gl = g ? (' — ' + g.name) : ''; opts += `<option value=\\\"${escAttr(it.id)}\\\">${escHtml(it.name)}${escHtml(gl)}</option>`; });\\n      sel.innerHTML = opts; sel.value = cur; if (sel.value !== cur) sel.value = '';\\n    }\\n\\n    // Нормализуем имя секции для сравнения: lowercase, trim, схлопываем пробелы, убираем точки/запятые на краях\\n    function normalizeSectionName(s) {\\n      return RoadmapModules.sectionComparisonName(s);\\n    }\\n    // Если в planSections уже есть «похожая» секция (с точностью до регистра/пробелов/трейлинг точек) , возвращаем ее каноническое имя\\n    function findCanonicalSection(candidate) {\\n      if (!candidate) return null;\\n      const norm = normalizeSectionName(candidate);\\n      // По ключу Jira , приоритет\\n      const candKey = (candidate.match(/[A-Z]+-\\\\d+/) || [])[0];\\n      if (candKey) {\\n        const byKey = planSections.find(s => {\\n          const k = (s.match(/[A-Z]+-\\\\d+/) || [])[0];\\n          return k && k === candKey;\\n        });\\n        if (byKey) return byKey;\\n      }\\n      // По нормализованному имени\\n      const byNorm = planSections.find(s => normalizeSectionName(s) === norm);\\n      return byNorm || null;\\n    }\\n\\n    // Гарантируем что в projectStatuses есть статус «На холде» (id 'on_hold') , иначе задачи на холде потеряются в фильтре.\\n    function ensureHoldStatusExists() {\\n      if (!projectStatuses.find(s => s